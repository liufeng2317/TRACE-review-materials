478 | def clean_catalog(parsed_all: pd.DataFrame) -> Tuple[pd.DataFrame, Dict[str, int]]:
479 |     initial_rows = int(len(parsed_all))
480 |     work = basic_numeric_time_clean(parsed_all)
481 |     valid = work.dropna(subset=ASPECT_COLUMNS).copy()
482 |     after_dropna = int(len(valid))
483 |     time_start = pd.Timestamp(datetime.combine(START_DATE, datetime.min.time()))
484 |     time_end = pd.Timestamp(datetime.combine(END_DATE_EXCLUSIVE, datetime.min.time()))
485 |     valid = valid[(valid["datetime"] >= time_start) & (valid["datetime"] < time_end)].copy()
486 |     after_time = int(len(valid))
487 |     valid = valid[
488 |         (valid["lat"] >= LAT_MIN) & (valid["lat"] <= LAT_MAX)
489 |         & (valid["lon"] >= LON_MIN) & (valid["lon"] <= LON_MAX)
490 |     ].copy()
491 |     after_space = int(len(valid))
492 |     valid = valid[(valid["dep"] >= 0.0) & (valid["dep"] <= 800.0) & (valid["mag"] >= -5.0) & (valid["mag"] <= 10.0)].copy()
493 |     after_physical = int(len(valid))
494 |     valid = valid.sort_values("datetime").drop_duplicates(subset=ASPECT_COLUMNS).reset_index(drop=True)
495 |     final_rows = int(len(valid))
496 |     output = valid[ASPECT_COLUMNS].copy()
497 |     output["datetime"] = output["datetime"].dt.strftime("%Y-%m-%d %H:%M:%S.%f").str.rstrip("0").str.rstrip(".")
498 |     stats = {
499 |         "initial_parsed_rows": initial_rows,
500 |         "rows_after_datetime_numeric_dropna": after_dropna,
501 |         "rows_removed_invalid_datetime_or_numeric": initial_rows - after_dropna,
502 |         "rows_after_time_filter": after_time,
503 |         "rows_removed_outside_requested_time": after_dropna - after_time,
504 |         "rows_after_sanriku_spatial_filter": after_space,
505 |         "rows_removed_outside_sanriku_bounds": after_time - after_space,
506 |         "rows_after_physical_sanity_filter": after_physical,
507 |         "rows_removed_failed_physical_sanity": after_space - after_physical,
508 |         "duplicates_removed": after_physical - final_rows,
509 |         "final_rows": final_rows,
510 |     }
511 |     return output, stats
