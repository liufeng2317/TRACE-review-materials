356 | def page_is_recognizable_catalog(text: str) -> bool:
357 |     lowered = text.lower()
358 |     plain = html_to_text(text).lower()
359 |     return (
360 |         "jma unified hypocenter" in lowered
361 |         or "origin time" in plain
362 |         or "hypocenter lists from" in plain
363 |         or "no data" in plain
364 |         or "not found" in plain
365 |     )
