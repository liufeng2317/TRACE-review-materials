206 | def infer_login_form_action(html_text: str) -> str:
207 |     form_match = re.search(r'<form[^>]*name=["\']auth["\'][^>]*action=["\']([^"\']+)["\']', html_text, flags=re.I)
208 |     if form_match:
209 |         return form_match.group(1)
210 |     generic_form_match = re.search(r'<form[^>]*action=["\']([^"\']+)["\']', html_text, flags=re.I)
211 |     if generic_form_match:
212 |         return generic_form_match.group(1)
213 |     return './?LANG=en'
