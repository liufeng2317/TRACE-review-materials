310 | def extract_pre_blocks(html_text: str) -> List[str]:
311 |     blocks = re.findall(r'(?is)<pre[^>]*>(.*?)</pre>', html_text)
312 |     return [unescape(block).replace('\r', '\n') for block in blocks if block.strip()]
