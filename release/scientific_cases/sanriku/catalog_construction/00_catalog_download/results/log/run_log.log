270 | def build_catalog_payload(chunk_start: date, chunk_end_exclusive: date) -> Dict[str, str]:
271 |     span_days = (chunk_end_exclusive - chunk_start).days
272 |     if span_days <= 0 or span_days > MAX_CHUNK_DAYS:
273 |         raise ValueError(f"Invalid JMA chunk span {span_days} days for {chunk_start} to {chunk_end_exclusive}")
274 |     return {
275 |         "LANG": "en",
276 |         "list_span": str(span_days),
277 |         "list_year": f"{chunk_start.year:04d}",
278 |         "list_month": f"{chunk_start.month:02d}",
279 |         "list_day": f"{chunk_start.day:02d}",
280 |     }
