369 | def clean_catalog(df: pd.DataFrame, start_date: date, end_date: date) -> Tuple[pd.DataFrame, Dict[str, int]]:
370 |     work = df.copy()
371 |     required_columns = ['datetime', 'lat', 'lon', 'dep', 'mag']
372 |     missing_columns = [col for col in required_columns if col not in work.columns]
373 |     if missing_columns:
374 |         raise RuntimeError(f'Missing required parsed columns: {missing_columns}')
