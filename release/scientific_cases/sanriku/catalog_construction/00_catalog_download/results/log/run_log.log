174 | def request_with_backoff(session: requests.Session, method: str, url: str, *, data: Optional[Dict[str, str]] = None) -> Tuple[requests.Response, int]:
175 |     last_exc: Optional[BaseException] = None
176 |     for attempt in range(1, MAX_ATTEMPTS + 1):
177 |         try:
178 |             response = session.request(method, url, data=data, timeout=TIMEOUT_SECONDS, allow_redirects=True)
179 |             if response.status_code < 500 and response.status_code not in (429,):
180 |                 return response, attempt
181 |             last_exc = RuntimeError(f"HTTP {response.status_code}")
182 |         except Exception as exc:  # requests exceptions plus unexpected transport failures
183 |             last_exc = exc
184 |         if attempt < MAX_ATTEMPTS:
185 |             sleep_seconds = min(60.0, BACKOFF_BASE_SECONDS * (2 ** (attempt - 1)))
186 |             log(f"{method} {url} attempt {attempt} failed ({last_exc}); retrying in {sleep_seconds:.1f}s")
187 |             time.sleep(sleep_seconds)
188 |     raise RuntimeError(f"{method} {url} failed after {MAX_ATTEMPTS} attempts: {last_exc}")
189 | 
