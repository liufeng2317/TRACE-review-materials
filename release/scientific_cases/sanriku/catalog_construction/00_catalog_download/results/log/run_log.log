283 | def html_to_text(html_text: str) -> str:
284 |     text = re.sub(r"(?is)<script.*?>.*?</script>", " ", html_text)
285 |     text = re.sub(r"(?is)<style.*?>.*?</style>", " ", text)
286 |     text = re.sub(r"(?is)<br\s*/?>", "\n", text)
287 |     text = re.sub(r"(?is)</tr>", "\n", text)
288 |     text = re.sub(r"(?is)</p>", "\n", text)
289 |     text = re.sub(r"(?is)<[^>]+>", " ", text)
290 |     text = unescape(text).replace("\r", "\n")
291 |     return re.sub(r"\n{2,}", "\n", text)
292 | 
