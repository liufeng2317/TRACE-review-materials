368 | def parse_catalog_response(text: str, debug_failure_path: Path) -> Tuple[pd.DataFrame, str, str]:
369 |     candidate_blocks = extract_pre_blocks(text)
370 |     candidate_blocks.append(html_to_text(text))
371 |     records: List[Dict[str, str]] = []
372 |     saw_header = False
373 |     for block in candidate_blocks:
374 |         if "Origin Time" in block or "Origin Time" in html_to_text(block):
375 |             saw_header = True
376 |         for line in block.splitlines():
377 |             rec = parse_fixed_width_event_line(line)
378 |             if rec is not None:
379 |                 records.append(rec)
380 |     if records:
381 |         df = pd.DataFrame.from_records(records, columns=ASPECT_COLUMNS).drop_duplicates().reset_index(drop=True)
382 |         return df, "parsed", "ok"
383 |     if saw_header or page_is_recognizable_catalog(text):
384 |         empty = pd.DataFrame(columns=ASPECT_COLUMNS)
385 |         return empty, "valid_zero_rows", "recognized catalog response with no event rows"
386 |     saved = save_text(debug_failure_path, text)
387 |     raise RuntimeError(f"Unable to parse HTML/text catalog response; saved original response to {saved}")
