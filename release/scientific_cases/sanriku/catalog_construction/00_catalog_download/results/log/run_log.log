296 | def html_to_text(html_text: str) -> str:
297 |     text = re.sub(r'(?is)<script.*?>.*?</script>', ' ', html_text)
298 |     text = re.sub(r'(?is)<style.*?>.*?</style>', ' ', text)
299 |     text = re.sub(r'(?is)<br\s*/?>', '\n', text)
300 |     text = re.sub(r'(?is)</p>', '\n', text)
301 |     text = re.sub(r'(?is)</tr>', '\n', text)
302 |     text = re.sub(r'(?is)<[^>]+>', ' ', text)
303 |     text = unescape(text)
304 |     text = text.replace('\r', '\n')
305 |     text = re.sub(r'\n+', '\n', text)
306 |     return text
307 | 
