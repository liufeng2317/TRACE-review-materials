556 | def validate_cleaned_csv(csv_path: Path) -> Tuple[pd.DataFrame, Dict[str, object]]:
557 |     if not csv_path.exists():
558 |         raise RuntimeError(f"Cleaned catalog CSV was not written: {csv_path}")
559 |     df = pd.read_csv(csv_path)
560 |     if list(df.columns) != ASPECT_COLUMNS:
561 |         raise RuntimeError(f"CSV schema mismatch: expected {ASPECT_COLUMNS}, got {list(df.columns)}")
562 |     parsed_dt = pd.to_datetime(df["datetime"], errors="coerce")
563 |     numeric = df[["lat", "lon", "dep", "mag"]].apply(pd.to_numeric, errors="coerce")
564 |     if parsed_dt.isna().any() or numeric.isna().any().any():
565 |         raise RuntimeError("Cleaned CSV still contains non-parsable datetime or numeric values")
566 |     check = pd.concat([parsed_dt.rename("datetime"), numeric], axis=1)
567 |     if check.isna().any().any():
568 |         raise RuntimeError("Cleaned CSV contains missing values")
569 |     time_start = pd.Timestamp(datetime.combine(START_DATE, datetime.min.time()))
570 |     time_end = pd.Timestamp(datetime.combine(END_DATE_EXCLUSIVE, datetime.min.time()))
571 |     if not ((check["datetime"] >= time_start) & (check["datetime"] < time_end)).all():
572 |         raise RuntimeError("Cleaned CSV contains rows outside the requested half-open time interval")
573 |     if not (check["lat"].between(LAT_MIN, LAT_MAX, inclusive="both") & check["lon"].between(LON_MIN, LON_MAX, inclusive="both")).all():
574 |         raise RuntimeError("Cleaned CSV contains rows outside Sanriku inclusive spatial bounds")
575 |     if not check["datetime"].is_monotonic_increasing:
576 |         raise RuntimeError("Cleaned CSV is not sorted by datetime")
577 |     if df.duplicated(subset=ASPECT_COLUMNS).any():
578 |         raise RuntimeError("Cleaned CSV contains duplicate ASPECT rows")
579 |     stats: Dict[str, object] = {
580 |         "csv_rows": int(len(df)),
581 |         "datetime_min": "" if df.empty else str(check["datetime"].min()),
582 |         "datetime_max": "" if df.empty else str(check["datetime"].max()),
583 |         "lat_min": None if df.empty else float(check["lat"].min()),
584 |         "lat_max": None if df.empty else float(check["lat"].max()),
585 |         "lon_min": None if df.empty else float(check["lon"].min()),
586 |         "lon_max": None if df.empty else float(check["lon"].max()),
587 |         "dep_min": None if df.empty else float(check["dep"].min()),
588 |         "dep_max": None if df.empty else float(check["dep"].max()),
589 |         "mag_min": None if df.empty else float(check["mag"].min()),
590 |         "mag_max": None if df.empty else float(check["mag"].max()),
591 |     }
592 |     return df, stats
