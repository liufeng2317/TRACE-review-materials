294 | def extract_pre_blocks(html_text: str) -> List[str]:
295 |     blocks = re.findall(r"(?is)<pre[^>]*>(.*?)</pre>", html_text)
296 |     return [unescape(block).replace("\r", "\n") for block in blocks if block.strip()]
