162 | def build_session() -> requests.Session:
163 |     session = requests.Session()
164 |     # Keep retry control in request_with_backoff().  Layering urllib3 retries
165 |     # under the explicit retry loop multiplied each apparent attempt into several
166 |     # connection attempts, causing long stalls when the catalog endpoint was slow.
167 |     adapter = HTTPAdapter(max_retries=0, pool_connections=4, pool_maxsize=4)
168 |     session.mount("https://", adapter)
169 |     session.mount("http://", adapter)
170 |     session.headers.update({"User-Agent": USER_AGENT})
171 |     return session
