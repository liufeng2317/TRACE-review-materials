316 | def parse_catalog_with_pandas_fixed_width(text_block: str) -> pd.DataFrame:
317 |     lines = [line.rstrip('\n') for line in text_block.splitlines()]
318 |     data_lines = [line for line in lines if re.match(r'^\s*20\d{2}[/-]\d{2}[/-]\d{2}\s+', line)]
319 |     if not data_lines:
320 |         return pd.DataFrame(columns=['datetime', 'lat', 'lon', 'dep', 'mag'])
321 |     records: List[Dict[str, str]] = []
322 |     for line in data_lines:
323 |         cleaned = line.rstrip()
324 |         dt_match = re.match(r'^\s*(20\d{2}[/-]\d{2}[/-]\d{2}\s+\d{2}:\d{2}:\d{2}(?:\.\d+)?)', cleaned)
325 |         if not dt_match:
326 |             continue
327 |         dt_text = dt_match.group(1).strip()
328 |         numeric_tail = cleaned[len(dt_match.group(0)):]
329 |         number_tokens = re.findall(r'[-+]?\d+(?:\.\d+)?', numeric_tail)
330 |         if len(number_tokens) < 7:
331 |             continue
332 |         try:
333 |             lat = number_tokens[1]
334 |             lon = number_tokens[3]
335 |             dep = number_tokens[5]
336 |             mag = number_tokens[6]
337 |         except IndexError:
338 |             continue
339 |         records.append({
340 |             'datetime': dt_text,
341 |             'lat': lat,
342 |             'lon': lon,
343 |             'dep': dep,
344 |             'mag': mag,
345 |         })
346 |     return pd.DataFrame.from_records(records, columns=['datetime', 'lat', 'lon', 'dep', 'mag'])
347 | 
348 | 
349 | def normalize_line(line: str) -> str:
350 |     return re.sub(r'\s+', ' ', line).strip()
351 | 
352 | 
353 | def parse_catalog_block(text: str, debug_path: Path) -> pd.DataFrame:
354 |     candidate_blocks = extract_pre_blocks(text)
355 |     candidate_blocks.append(html_to_text(text))
356 |     parsed_frames: List[pd.DataFrame] = []
357 |     for block in candidate_blocks:
358 |         fwf = parse_catalog_with_pandas_fixed_width(block)
359 |         if not fwf.empty:
360 |             parsed_frames.append(fwf)
361 |     if not parsed_frames:
362 |         saved = save_text(debug_path, text)
363 |         raise RuntimeError(f'Unable to parse catalog block; saved raw response to {saved}')
364 |     df = pd.concat(parsed_frames, ignore_index=True)
365 |     df = df.drop_duplicates().reset_index(drop=True)
366 |     return df
