268 | def request_block(session: requests.Session, start: date, end: date, raw_save_dir: Optional[Path], debug_raw_dir: Path, block_index: int) -> Tuple[str, int, Optional[Path]]:
269 |     payload = build_catalog_payload(start, end)
270 |     last_error = None
271 |     for attempt in range(1, MAX_RETRIES + 1):
272 |         try:
273 |             log(f'Requesting block {block_index:03d}: {start} to {end}, attempt {attempt}, payload={payload}')
274 |             resp = session.post(CATALOG_URL, data=payload, timeout=TIMEOUT)
275 |             text = resp.text
276 |             raw_name = f'block_{block_index:03d}_{start.strftime("%Y%m%d")}_{end.strftime("%Y%m%d")}.html'
277 |             raw_path = None
278 |             if raw_save_dir is not None:
279 |                 raw_path = save_text(raw_save_dir / raw_name, text)
280 |             if resp.status_code >= 400:
281 |                 raise RuntimeError(f'HTTP {resp.status_code}')
282 |             if not text.strip():
283 |                 raise RuntimeError('Empty response body')
284 |             if response_looks_like_login(text):
285 |                 fail_path = save_text(debug_raw_dir / f'auth_block_{block_index:03d}.html', text)
286 |                 raise RuntimeError(f'Session lost or redirected to login. Saved response to {fail_path}')
287 |             return text, attempt, raw_path
288 |         except Exception as exc:
289 |             last_error = exc
290 |             wait_seconds = BACKOFF ** attempt
291 |             log(f'Block {block_index:03d} attempt {attempt} failed: {exc}; sleeping {wait_seconds:.1f}s')
292 |             time.sleep(wait_seconds)
293 |     raise RuntimeError(f'Failed to download block {block_index:03d} {start} to {end}: {last_error}')
