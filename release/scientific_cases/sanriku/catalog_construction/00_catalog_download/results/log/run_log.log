150 | def build_chunks(start: date, end_exclusive: date, max_days: int) -> List[Tuple[date, date]]:
151 |     if end_exclusive <= start:
152 |         raise ValueError(f"Invalid half-open interval: {start} to {end_exclusive}")
153 |     chunks: List[Tuple[date, date]] = []
154 |     current = start
155 |     while current < end_exclusive:
156 |         nxt = min(current + timedelta(days=max_days), end_exclusive)
157 |         chunks.append((current, nxt))
158 |         current = nxt
159 |     return chunks
