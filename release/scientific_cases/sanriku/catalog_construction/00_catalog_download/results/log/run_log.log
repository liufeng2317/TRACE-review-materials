514 | def update_manifest_retained_ranges(manifest: List[ChunkRecord], parsed_all: pd.DataFrame) -> None:
515 |     if parsed_all.empty or "chunk_index" not in parsed_all.columns:
516 |         return
517 |     work = basic_numeric_time_clean(parsed_all)
518 |     work["chunk_index"] = parsed_all["chunk_index"].values
519 |     time_start = pd.Timestamp(datetime.combine(START_DATE, datetime.min.time()))
520 |     time_end = pd.Timestamp(datetime.combine(END_DATE_EXCLUSIVE, datetime.min.time()))
521 |     retained = work.dropna(subset=ASPECT_COLUMNS).copy()
522 |     retained = retained[
523 |         (retained["datetime"] >= time_start) & (retained["datetime"] < time_end)
524 |         & (retained["lat"] >= LAT_MIN) & (retained["lat"] <= LAT_MAX)
525 |         & (retained["lon"] >= LON_MIN) & (retained["lon"] <= LON_MAX)
526 |     ].copy()
527 |     for rec in manifest:
528 |         sub = retained[retained["chunk_index"] == rec.chunk_index]
529 |         rec.retained_sanriku_rows = int(len(sub))
530 |         if not sub.empty:
531 |             rec.retained_sanriku_datetime_min = str(sub["datetime"].min())
532 |             rec.retained_sanriku_datetime_max = str(sub["datetime"].max())
