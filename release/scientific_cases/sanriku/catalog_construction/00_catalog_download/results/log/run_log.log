466 | def basic_numeric_time_clean(df: pd.DataFrame) -> pd.DataFrame:
467 |     work = df.copy()
468 |     for col in ASPECT_COLUMNS:
469 |         if col not in work.columns:
470 |             raise RuntimeError(f"Parsed table is missing required column: {col}")
471 |     work = work[ASPECT_COLUMNS].copy()
472 |     work["datetime"] = pd.to_datetime(work["datetime"], errors="coerce")
473 |     for col in ("lat", "lon", "dep", "mag"):
474 |         work[col] = pd.to_numeric(work[col], errors="coerce")
475 |     return work
476 | 
