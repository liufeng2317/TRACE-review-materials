539 | def validate_chunks(chunks: Sequence[Tuple[date, date]], manifest_df: pd.DataFrame) -> None:
540 |     if len(chunks) != 48:
541 |         raise RuntimeError(f"Expected exactly 48 chunks for the fixed interval; got {len(chunks)}")
542 |     if chunks[0][0] != START_DATE or chunks[-1][1] != END_DATE_EXCLUSIVE:
543 |         raise RuntimeError(f"Chunk coverage mismatch: first={chunks[0]}, last={chunks[-1]}")
544 |     for i, (start, end) in enumerate(chunks):
545 |         if (end - start).days > MAX_CHUNK_DAYS:
546 |             raise RuntimeError(f"Chunk {i+1} exceeds {MAX_CHUNK_DAYS} days: {start} to {end}")
547 |         if i > 0 and chunks[i - 1][1] != start:
548 |             raise RuntimeError(f"Chunks are not continuous at index {i+1}: previous end {chunks[i-1][1]}, current start {start}")
549 |     if len(manifest_df) != len(chunks):
550 |         raise RuntimeError(f"Manifest row count {len(manifest_df)} does not match chunk count {len(chunks)}")
551 |     if not (manifest_df["status"] == "success").all():
552 |         failed = manifest_df.loc[manifest_df["status"] != "success", ["chunk_index", "message"]].to_dict("records")
553 |         raise RuntimeError(f"One or more chunks failed: {failed}")
