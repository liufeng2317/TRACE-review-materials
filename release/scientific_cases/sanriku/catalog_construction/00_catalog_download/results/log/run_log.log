304 | def parse_fixed_width_event_line(line: str) -> Optional[Dict[str, str]]:
305 |     """Parse one JMA table event row using fixed column locations.
306 | 
307 |     Table header in the Hi-net response is:
308 |     -----Origin Time--------OTerr---Lat---LatErr---Long--LonErr---Dep--DepErr-Mag...
309 |     Required fields occupy stable positions in the monospaced table.  A regex
310 |     fallback is retained only for rows with small spacing variations; no comma
311 |     splitting is used.
312 |     """
313 |     if not re.match(r"^\s*20\d{2}-\d{2}-\d{2}\s+\d{2}:\d{2}:\d{2}", line):
314 |         return None
315 |     padded = line.rstrip("\n") + " " * 100
316 |     fixed = {
317 |         "datetime": padded[0:22].strip(),
318 |         "lat": padded[30:38].strip(),
319 |         "lon": padded[45:53].strip(),
320 |         "dep": padded[61:68].strip(),
321 |         "mag": parse_mag_field(padded[74:86]),
322 |     }
323 |     try:
324 |         pd.to_datetime(fixed["datetime"], errors="raise")
325 |         float(fixed["lat"])
326 |         float(fixed["lon"])
327 |         float(fixed["dep"])
328 |         if fixed["mag"] is None:
329 |             raise ValueError("missing magnitude")
330 |         float(fixed["mag"])
331 |         return fixed  # type: ignore[return-value]
332 |     except Exception:
333 |         pattern = re.compile(
334 |             r"^\s*(20\d{2}-\d{2}-\d{2}\s+\d{2}:\d{2}:\d{2}(?:\.\d+)?)"
335 |             r"\s+[-+]?\d+(?:\.\d+)?"
336 |             r"\s+([-+]?\d+(?:\.\d+)?)"
337 |             r"\s+[-+]?\d+(?:\.\d+)?"
338 |             r"\s+([-+]?\d+(?:\.\d+)?)"
339 |             r"\s+[-+]?\d+(?:\.\d+)?"
340 |             r"\s+([-+]?\d+(?:\.\d+)?)"
341 |             r"\s+[-+]?\d+(?:\.\d+)?"
342 |             r"\s+([-+]?\d+(?:\.\d+)?)[A-Za-z]?\b"
343 |         )
344 |         match = pattern.match(line)
345 |         if not match:
346 |             return None
347 |         return {
348 |             "datetime": match.group(1),
349 |             "lat": match.group(2),
350 |             "lon": match.group(3),
351 |             "dep": match.group(4),
352 |             "mag": match.group(5),
353 |         }
