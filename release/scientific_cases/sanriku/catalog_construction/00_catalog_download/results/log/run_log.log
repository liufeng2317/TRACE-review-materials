191 | def extract_form_inputs(html_text: str) -> Dict[str, str]:
192 |     inputs: Dict[str, str] = {}
193 |     for match in re.finditer(r'<input\b[^>]*>', html_text, flags=re.I):
194 |         tag = match.group(0)
195 |         name_match = re.search(r'name=["\']([^"\']+)["\']', tag, flags=re.I)
196 |         if not name_match:
197 |             continue
198 |         value_match = re.search(r'value=["\']([^"\']*)["\']', tag, flags=re.I)
199 |         name = name_match.group(1)
200 |         value = unescape(value_match.group(1)) if value_match else ''
201 |         inputs[name] = value
202 |     return inputs
