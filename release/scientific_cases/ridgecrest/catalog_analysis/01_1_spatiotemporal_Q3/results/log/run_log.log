259 | def process_geometry_interval(interval: Interval, df: pd.DataFrame, main71_xy: np.ndarray, alpha_value: float):
260 |     mask = (df['event_time'] >= interval.start) & ((df['event_time'] < interval.end) | ((df['event_time'] == interval.end) & (interval.end == df['event_time'].max())))
261 |     sub = df.loc[mask].copy()
262 |     result = {
263 |         'interval_id': interval.interval_id,
264 |         'start': interval.start,
265 |         'end': interval.end,
266 |         'elapsed_start_hr': interval.elapsed_start_hr,
267 |         'elapsed_end_hr': interval.elapsed_end_hr,
268 |         'event_count': int(len(sub)),
269 |         'convex_valid': False,
270 |         'alpha_valid': False,
271 |         'convex_area_km2': np.nan,
272 |         'convex_perimeter_km': np.nan,
273 |         'convex_centroid_x_km': np.nan,
274 |         'convex_centroid_y_km': np.nan,
275 |         'convex_centroid_distance_to_main71_km': np.nan,
276 |         'alpha_area_km2': np.nan,
277 |         'alpha_perimeter_km': np.nan,
278 |         'alpha_centroid_x_km': np.nan,
279 |         'alpha_centroid_y_km': np.nan,
280 |         'alpha_centroid_distance_to_main71_km': np.nan,
281 |         'alpha_component_count': 0,
282 |         'status': 'ok',
283 |     }
284 |     boundaries = {'interval_id': interval.interval_id, 'convex': [], 'alpha': []}
285 |     if len(sub) < MIN_POINTS_GEOM:
286 |         result['status'] = 'insufficient_points'
287 |         return result, boundaries
288 |     points = sub[['x_km', 'y_km']].to_numpy()
289 |     unique_points = np.unique(points, axis=0)
290 |     if len(unique_points) < MIN_POINTS_GEOM:
291 |         result['status'] = 'insufficient_unique_points'
292 |         return result, boundaries
293 |     try:
294 |         hull = ConvexHull(unique_points)
295 |         hull_coords = unique_points[hull.vertices]
296 |         hull_polygon = Polygon(hull_coords)
297 |         if hull_polygon.is_valid and not hull_polygon.is_empty and hull_polygon.area > 0:
298 |             centroid = hull_polygon.centroid
299 |             result['convex_valid'] = True
300 |             result['convex_area_km2'] = float(hull_polygon.area)
301 |             result['convex_perimeter_km'] = float(hull_polygon.length)
302 |             result['convex_centroid_x_km'] = float(centroid.x)
303 |             result['convex_centroid_y_km'] = float(centroid.y)
304 |             result['convex_centroid_distance_to_main71_km'] = float(np.hypot(centroid.x - main71_xy[0], centroid.y - main71_xy[1]))
305 |             boundaries['convex_geom'] = hull_polygon
306 |     except (QhullError, ValueError):
307 |         pass
308 |     try:
309 |         ashape = alpha_shape(unique_points, alpha_value)
310 |         if ashape is not None and not ashape.is_empty and ashape.area > 0:
311 |             centroid = ashape.centroid
312 |             result['alpha_valid'] = True
313 |             result['alpha_area_km2'] = float(ashape.area)
314 |             result['alpha_perimeter_km'] = float(ashape.length)
315 |             result['alpha_centroid_x_km'] = float(centroid.x)
316 |             result['alpha_centroid_y_km'] = float(centroid.y)
317 |             result['alpha_centroid_distance_to_main71_km'] = float(np.hypot(centroid.x - main71_xy[0], centroid.y - main71_xy[1]))
318 |             result['alpha_component_count'] = component_count(ashape)
319 |             boundaries['alpha_geom'] = ashape
320 |     except Exception:
321 |         pass
322 |     if not result['convex_valid'] and not result['alpha_valid']:
323 |         result['status'] = 'invalid_geometry'
324 |     return result, boundaries
