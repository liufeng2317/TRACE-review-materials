205 | def component_count(geom) -> int:
206 |     if geom is None or geom.is_empty:
207 |         return 0
208 |     if isinstance(geom, Polygon):
209 |         return 1
210 |     if isinstance(geom, MultiPolygon):
211 |         return len(geom.geoms)
212 |     return 1
