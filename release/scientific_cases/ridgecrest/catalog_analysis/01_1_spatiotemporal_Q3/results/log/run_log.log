        merged['interpretation_label'] = merged.apply(lambda r: classify_interval(r, median_area), axis=1)
        stage_comparison = []
        for stage_name in ['Stage1', 'Stage2']:
            sub = kde_summary[kde_summary['stage'] == stage_name].copy()
            if sub.empty:
