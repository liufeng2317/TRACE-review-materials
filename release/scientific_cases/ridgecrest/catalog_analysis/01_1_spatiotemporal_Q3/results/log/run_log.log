146 | def silverman_bandwidth_km(xy: np.ndarray) -> float:
147 |     if xy.shape[0] < 2:
148 |         return 1.0
149 |     std_xy = np.std(xy, axis=0, ddof=1)
150 |     sigma = float(np.mean(std_xy[std_xy > 0])) if np.any(std_xy > 0) else 1.0
151 |     n = xy.shape[0]
152 |     bw = 1.06 * sigma * n ** (-1.0 / 6.0)
153 |     return max(bw, 0.5)
154 | 
155 | 
156 | def alpha_shape(points: np.ndarray, alpha: float):
157 |     if len(points) < 4:
158 |         return MultiPoint(points).convex_hull
159 |     tri = Delaunay(points)
160 |     edges = set()
161 |     edge_points = []
162 |     for ia, ib, ic in tri.simplices:
163 |         pa, pb, pc = points[ia], points[ib], points[ic]
164 |         a = np.linalg.norm(pb - pc)
165 |         b = np.linalg.norm(pa - pc)
166 |         c = np.linalg.norm(pa - pb)
167 |         s = (a + b + c) / 2.0
168 |         area_sq = s * (s - a) * (s - b) * (s - c)
169 |         if area_sq <= 0:
170 |             continue
171 |         area = math.sqrt(area_sq)
172 |         circum_r = a * b * c / (4.0 * area)
173 |         if circum_r < 1.0 / max(alpha, 1e-12):
174 |             for i, j in [(ia, ib), (ib, ic), (ic, ia)]:
175 |                 if (i, j) in edges or (j, i) in edges:
176 |                     edges.discard((j, i)) if (j, i) in edges else edges.discard((i, j))
177 |                 else:
178 |                     edges.add((i, j))
179 |     for i, j in edges:
180 |         edge_points.append(LineString([points[i], points[j]]))
181 |     if not edge_points:
182 |         return MultiPoint(points).convex_hull
183 |     polygons = list(polygonize(MultiLineString(edge_points)))
184 |     if not polygons:
185 |         return MultiPoint(points).convex_hull
186 |     return unary_union(polygons)
187 | 
