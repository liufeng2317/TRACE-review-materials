242 |     try:
243 |         kde = gaussian_kde(xy, bw_method=GLOBAL_KDE_BW_FACTOR)
244 |         positions = np.vstack([x_grid.ravel(), y_grid.ravel()])
245 |         z = kde(positions).reshape(x_grid.shape)
246 |     except Exception:
247 |         result['status'] = 'kde_failed'
248 |         return result, None
249 |     idx = np.unravel_index(np.nanargmax(z), z.shape)
250 |     hx = float(x_grid[idx])
251 |     hy = float(y_grid[idx])
252 |     result['hotspot_x_km'] = hx
253 |     result['hotspot_y_km'] = hy
254 |     result['peak_density'] = float(z[idx])
255 |     result['distance_to_main71_km'] = float(np.hypot(hx - main71_xy[0], hy - main71_xy[1]))
256 |     return result, z
