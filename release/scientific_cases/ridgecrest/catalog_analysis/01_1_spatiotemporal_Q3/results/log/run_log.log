156 | def alpha_shape(points: np.ndarray, alpha: float):
157 |     if len(points) < 4:
158 |         return MultiPoint(points).convex_hull
159 |     tri = Delaunay(points)
160 |     edge_counter = {}
161 |     for ia, ib, ic in tri.simplices:
162 |         pa, pb, pc = points[ia], points[ib], points[ic]
163 |         a = np.linalg.norm(pb - pc)
164 |         b = np.linalg.norm(pa - pc)
165 |         c = np.linalg.norm(pa - pb)
166 |         s = (a + b + c) / 2.0
167 |         area_sq = s * (s - a) * (s - b) * (s - c)
168 |         if area_sq <= 0:
169 |             continue
170 |         area = math.sqrt(area_sq)
171 |         circum_r = a * b * c / (4.0 * area)
172 |         if circum_r < 1.0 / max(alpha, 1e-12):
173 |             for i, j in [(ia, ib), (ib, ic), (ic, ia)]:
174 |                 edge = tuple(sorted((i, j)))
175 |                 edge_counter[edge] = edge_counter.get(edge, 0) + 1
176 |     edge_points = [LineString([points[i], points[j]]) for (i, j), count in edge_counter.items() if count == 1]
177 |     if not edge_points:
178 |         return MultiPoint(points).convex_hull
179 |     polygons = list(polygonize(MultiLineString(edge_points)))
180 |     if not polygons:
181 |         return MultiPoint(points).convex_hull
182 |     return unary_union(polygons)
