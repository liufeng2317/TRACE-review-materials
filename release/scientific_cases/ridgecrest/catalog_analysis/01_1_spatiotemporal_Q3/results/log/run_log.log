137 | def assign_local_projection(mean_lon: float, mean_lat: float) -> tuple[CRS, Transformer, Transformer]:
138 |     proj4 = f'+proj=aeqd +lat_0={mean_lat} +lon_0={mean_lon} +datum=WGS84 +units=km +no_defs'
139 |     crs_geo = CRS.from_epsg(4326)
140 |     crs_local = CRS.from_proj4(proj4)
141 |     to_local = Transformer.from_crs(crs_geo, crs_local, always_xy=True)
142 |     to_geo = Transformer.from_crs(crs_local, crs_geo, always_xy=True)
143 |     return crs_local, to_local, to_geo
