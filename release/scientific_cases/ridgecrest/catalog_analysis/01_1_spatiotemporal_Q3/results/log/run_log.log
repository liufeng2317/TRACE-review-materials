189 | def geometry_to_boundaries(geom, to_geo: Transformer):
190 |     lines = []
191 |     if geom is None or geom.is_empty:
192 |         return lines
193 |     if isinstance(geom, Polygon):
194 |         coords = np.asarray(geom.exterior.coords)
195 |         lon, lat = to_geo.transform(coords[:, 0], coords[:, 1])
196 |         lines.append(np.column_stack([lon, lat]))
197 |     elif isinstance(geom, MultiPolygon):
198 |         for poly in geom.geoms:
199 |             coords = np.asarray(poly.exterior.coords)
200 |             lon, lat = to_geo.transform(coords[:, 0], coords[:, 1])
201 |             lines.append(np.column_stack([lon, lat]))
202 |     return lines
203 | 
