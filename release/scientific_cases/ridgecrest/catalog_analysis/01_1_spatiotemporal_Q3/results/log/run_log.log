146 | def silverman_bandwidth_km(xy: np.ndarray) -> float:
147 |     if xy.shape[0] < 2:
148 |         return 1.0
149 |     std_xy = np.std(xy, axis=0, ddof=1)
150 |     sigma = float(np.mean(std_xy[std_xy > 0])) if np.any(std_xy > 0) else 1.0
151 |     n = xy.shape[0]
152 |     bw = 1.06 * sigma * n ** (-1.0 / 6.0)
153 |     return max(bw, 0.5)
