        ).sort_values('start').reset_index(drop=True)
        if 'interval_id_kde' in merged.columns:
            merged['interval_id'] = merged['interval_id_kde'].fillna(merged.get('interval_id_geom'))
        elif 'interval_id' not in merged.columns:
