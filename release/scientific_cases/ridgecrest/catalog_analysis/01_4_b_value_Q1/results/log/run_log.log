326 | def match_contrasts(df: pd.DataFrame, label: str) -> pd.DataFrame:
327 |     if df.empty:
328 |         return pd.DataFrame()
329 |     left = df[df["core_label"] == "mw64"].sort_values("center_time").reset_index(drop=True)
330 |     right = df[df["core_label"] == "mw71"].sort_values("center_time").reset_index(drop=True)
331 |     if left.empty or right.empty:
