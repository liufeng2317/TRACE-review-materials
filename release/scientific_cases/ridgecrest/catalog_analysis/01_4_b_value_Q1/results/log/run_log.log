235 | def bootstrap_distribution(magnitudes: np.ndarray, mc_mode: str, delta_m: float, fixed_mc: float, n_boot: int, seed: int) -> tuple[np.ndarray, np.ndarray, np.ndarray]:
236 |     rng = np.random.default_rng(seed)
237 |     n = len(magnitudes)
238 |     bvals = np.full(n_boot, np.nan, dtype=float)
239 |     mcs = np.full(n_boot, np.nan, dtype=float)
240 |     nge = np.full(n_boot, np.nan, dtype=float)
241 |     for i in range(n_boot):
242 |         sample = rng.choice(magnitudes, size=n, replace=True)
243 |         b_val, mc, n_ge_mc, _status = compute_b_for_sample(sample, mc_mode=mc_mode, delta_m=delta_m, fixed_mc=fixed_mc)
244 |         if b_val is not None:
245 |             bvals[i] = b_val
246 |         if mc is not None:
247 |             mcs[i] = mc
248 |         if n_ge_mc is not None:
249 |             nge[i] = n_ge_mc
250 |     return bvals, mcs, nge
