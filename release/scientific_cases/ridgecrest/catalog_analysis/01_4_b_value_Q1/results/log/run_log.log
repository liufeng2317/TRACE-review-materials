204 | def compute_b_for_sample(magnitudes: np.ndarray, mc_mode: str, delta_m: float, fixed_mc: float) -> tuple[float | None, float | None, int | None, str | None]:
205 |     try:
206 |         mags = np.asarray(magnitudes, dtype=float)
207 |         mags = mags[np.isfinite(mags)]
208 |         if len(mags) == 0:
209 |             return None, None, None, "no_magnitudes"
210 |         if mc_mode == "fixed":
211 |             mc = float(fixed_mc)
212 |         elif mc_mode == "dynamic":
213 |             mc, _meta = estimate_mc_maxc(mags, fmd_bin=delta_m)
214 |             mc = float(mc)
215 |         else:
216 |             raise ValueError(f"Unsupported mc_mode: {mc_mode}")
217 |         n_ge_mc = int(np.sum(mags >= mc))
218 |         if n_ge_mc < 2:
219 |             return None, mc, n_ge_mc, "n_ge_mc_lt_2"
220 |         b_val = float(estimate_b(mags, mc=mc, delta_m=delta_m))
221 |         if not np.isfinite(b_val):
222 |             return None, mc, n_ge_mc, "b_not_finite"
223 |         return b_val, mc, n_ge_mc, None
224 |     except Exception as exc:
225 |         return None, None, None, f"{type(exc).__name__}: {exc}"
