197 | def compute_ci(values: np.ndarray) -> tuple[float | None, float | None]:
198 |     valid = values[np.isfinite(values)]
199 |     if len(valid) == 0:
200 |         return None, None
201 |     return float(np.percentile(valid, CONF_LEVELS[0])), float(np.percentile(valid, CONF_LEVELS[1]))
