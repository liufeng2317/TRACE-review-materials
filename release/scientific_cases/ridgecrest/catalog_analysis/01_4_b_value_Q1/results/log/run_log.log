175 | def make_windows(df: pd.DataFrame, spec: WindowSpec) -> list[dict[str, Any]]:
176 |     windows = []
177 |     n_total = len(df)
178 |     if n_total < spec.n_events:
179 |         return windows
180 |     mags = df["magnitude"].to_numpy(dtype=float)
181 |     times = df["event_time"].to_numpy()
182 |     for start in range(0, n_total - spec.n_events + 1, spec.step):
183 |         end = start + spec.n_events
184 |         sub = df.iloc[start:end]
185 |         windows.append(
186 |             {
187 |                 "window_index": len(windows),
188 |                 "start_idx": start,
189 |                 "end_idx_exclusive": end,
190 |                 "magnitudes": mags[start:end].copy(),
191 |                 "times": times[start:end].copy(),
192 |                 "start_time": sub["event_time"].iloc[0],
193 |                 "end_time": sub["event_time"].iloc[-1],
194 |                 "center_time": sub["event_time"].iloc[len(sub) // 2],
195 |                 "median_time": sub["event_time"].sort_values().iloc[len(sub) // 2],
196 |                 "event_count": int(len(sub)),
197 |                 "magnitude_min": float(sub["magnitude"].min()),
198 |                 "magnitude_max": float(sub["magnitude"].max()),
199 |             }
200 |         )
201 |     return windows
