246 | def analyze_window_task(task: dict[str, Any]) -> dict[str, Any]:
247 |     mags = task["magnitudes"]
248 |     base_b, mc, n_ge_mc, status = compute_b_for_sample(mags, task["mc_mode"], task["delta_m"], task["fixed_mc"])
249 |     boot_b, boot_mc, boot_nge = bootstrap_distribution(
250 |         magnitudes=mags,
251 |         mc_mode=task["mc_mode"],
252 |         delta_m=task["delta_m"],
253 |         fixed_mc=task["fixed_mc"],
254 |         n_boot=task["bootstrap_samples"],
255 |         seed=task["seed"],
256 |     )
257 |     ci_low, ci_high = compute_ci(boot_b)
258 |     valid_boot = boot_b[np.isfinite(boot_b)]
259 |     valid_boot_mc = boot_mc[np.isfinite(boot_mc)]
260 |     valid_boot_nge = boot_nge[np.isfinite(boot_nge)]
261 |     return {
262 |         **{k: v for k, v in task.items() if k != "magnitudes"},
263 |         "b_value": base_b,
264 |         "mc": mc,
265 |         "n_ge_mc": n_ge_mc,
266 |         "status": "ok" if status is None else status,
267 |         "bootstrap_valid_count": int(len(valid_boot)),
268 |         "bootstrap_mean": None if len(valid_boot) == 0 else float(np.mean(valid_boot)),
269 |         "bootstrap_median": None if len(valid_boot) == 0 else float(np.median(valid_boot)),
270 |         "bootstrap_std": None if len(valid_boot) == 0 else float(np.std(valid_boot, ddof=1)) if len(valid_boot) > 1 else 0.0,
271 |         "bootstrap_ci_low": ci_low,
272 |         "bootstrap_ci_high": ci_high,
273 |         "bootstrap_ci_width": None if ci_low is None or ci_high is None else float(ci_high - ci_low),
274 |         "bootstrap_mc_median": None if len(valid_boot_mc) == 0 else float(np.median(valid_boot_mc)),
275 |         "bootstrap_n_ge_mc_median": None if len(valid_boot_nge) == 0 else float(np.median(valid_boot_nge)),
276 |     }
