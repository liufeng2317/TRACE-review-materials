 72 | def infer_delta_m(magnitudes: pd.Series) -> tuple[float, dict[str, Any]]:
 73 |     unique_vals = np.sort(np.unique(np.round(magnitudes.dropna().to_numpy(dtype=float), 6)))
 74 |     diffs = np.diff(unique_vals)
 75 |     diffs = diffs[diffs > 1e-6]
 76 |     if len(diffs) == 0:
 77 |         delta = 0.1
 78 |     else:
 79 |         q10 = float(np.quantile(diffs, 0.1))
 80 |         candidates = np.array([0.001, 0.005, 0.01, 0.02, 0.05, 0.1])
 81 |         delta = float(candidates[np.argmin(np.abs(candidates - q10))])
 82 |     meta = {
 83 |         "n_unique_magnitudes": int(len(unique_vals)),
 84 |         "n_nonzero_diffs": int(len(diffs)),
 85 |         "min_diff": None if len(diffs) == 0 else float(np.min(diffs)),
 86 |         "q01_diff": None if len(diffs) == 0 else float(np.quantile(diffs, 0.01)),
 87 |         "q05_diff": None if len(diffs) == 0 else float(np.quantile(diffs, 0.05)),
 88 |         "q10_diff": None if len(diffs) == 0 else float(np.quantile(diffs, 0.10)),
 89 |         "median_diff": None if len(diffs) == 0 else float(np.quantile(diffs, 0.50)),
 90 |         "selected_delta_m": delta,
 91 |     }
 92 |     return delta, meta
