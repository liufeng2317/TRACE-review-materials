 65 | def infer_delta_m(magnitudes: pd.Series) -> tuple[float, dict[str, Any]]:
 66 |     unique_vals = np.sort(np.unique(np.round(magnitudes.dropna().to_numpy(dtype=float), 6)))
 67 |     diffs = np.diff(unique_vals)
 68 |     diffs = diffs[diffs > 1e-6]
 69 |     if len(diffs) == 0:
 70 |         delta = 0.1
 71 |     else:
 72 |         q10 = float(np.quantile(diffs, 0.1))
 73 |         candidates = np.array([0.001, 0.005, 0.01, 0.02, 0.05, 0.1])
 74 |         delta = float(candidates[np.argmin(np.abs(candidates - q10))])
 75 |     meta = {
 76 |         "n_unique_magnitudes": int(len(unique_vals)),
 77 |         "n_nonzero_diffs": int(len(diffs)),
 78 |         "min_diff": None if len(diffs) == 0 else float(np.min(diffs)),
 79 |         "q01_diff": None if len(diffs) == 0 else float(np.quantile(diffs, 0.01)),
 80 |         "q05_diff": None if len(diffs) == 0 else float(np.quantile(diffs, 0.05)),
 81 |         "q10_diff": None if len(diffs) == 0 else float(np.quantile(diffs, 0.10)),
 82 |         "median_diff": None if len(diffs) == 0 else float(np.quantile(diffs, 0.50)),
 83 |         "selected_delta_m": delta,
 84 |     }
 85 |     return delta, meta
