333 |     left_times = pd.to_datetime(left["center_time"]).view("int64").to_numpy()
334 |     right_times = pd.to_datetime(right["center_time"]).view("int64").to_numpy()
335 |     spacing_hours = np.diff(np.sort(np.unique(np.concatenate([left["hours_since_mw64"].to_numpy(), right["hours_since_mw64"].to_numpy()]))))
336 |     median_spacing = float(np.median(spacing_hours)) if len(spacing_hours) else np.nan
337 |     max_mismatch = np.inf if not np.isfinite(median_spacing) else TIME_MISMATCH_FRAC * median_spacing
338 |     rows = []
