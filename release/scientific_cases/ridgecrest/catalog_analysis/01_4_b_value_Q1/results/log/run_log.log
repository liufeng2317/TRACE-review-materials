211 | def compute_b_for_sample(magnitudes: np.ndarray, mc_mode: str, delta_m: float, fixed_mc: float) -> tuple[float | None, float | None, int | None, str | None]:
212 |     try:
213 |         mags = np.asarray(magnitudes, dtype=float)
214 |         mags = mags[np.isfinite(mags)]
215 |         if len(mags) == 0:
216 |             return None, None, None, "no_magnitudes"
217 |         if mc_mode == "fixed":
218 |             mc = float(fixed_mc)
219 |         elif mc_mode == "dynamic":
220 |             mc, _meta = estimate_mc_maxc(mags, fmd_bin=delta_m)
221 |             mc = float(mc)
222 |         else:
223 |             raise ValueError(f"Unsupported mc_mode: {mc_mode}")
224 |         n_ge_mc = int(np.sum(mags >= mc))
225 |         if n_ge_mc < 2:
226 |             return None, mc, n_ge_mc, "n_ge_mc_lt_2"
227 |         b_val = float(estimate_b(mags, mc=mc, delta_m=delta_m))
228 |         if not np.isfinite(b_val):
229 |             return None, mc, n_ge_mc, "b_not_finite"
230 |         return b_val, mc, n_ge_mc, None
231 |     except Exception as exc:
232 |         return None, None, None, f"{type(exc).__name__}: {exc}"
