137 |     overlap_records = []
138 |     nearest = np.where(
139 |         clean_df["dist_mw64_km"].to_numpy() <= clean_df["dist_mw71_km"].to_numpy(),
140 |         "mw64",
141 |         "mw71",
142 |     )
143 |     for radius in radii_km:
144 |         in64 = clean_df["dist_mw64_km"] <= radius
145 |         in71 = clean_df["dist_mw71_km"] <= radius
146 |         overlap = in64 & in71
147 |         assigned = np.full(len(clean_df), "outside", dtype=object)
148 |         assigned[in64 & ~in71] = "mw64"
149 |         assigned[in71 & ~in64] = "mw71"
150 |         overlap_idx = np.where(overlap)[0]
151 |         if len(overlap_idx) > 0:
152 |             assigned[overlap_idx] = nearest[overlap_idx]
153 |         tmp = clean_df[["event_time", "latitude", "longitude", "depth_km", "magnitude", "dist_mw64_km", "dist_mw71_km"]].copy()
154 |         tmp["radius_km"] = radius
155 |         tmp["raw_in_mw64"] = in64.to_numpy()
156 |         tmp["raw_in_mw71"] = in71.to_numpy()
157 |         tmp["raw_overlap"] = overlap.to_numpy()
158 |         tmp["nearest_hypocenter"] = nearest
159 |         tmp["assigned_core"] = assigned
160 |         records.append(tmp)
161 |         overlap_records.append(
162 |             {
163 |                 "radius_km": radius,
164 |                 "raw_count_mw64": int(in64.sum()),
165 |                 "raw_count_mw71": int(in71.sum()),
166 |                 "raw_overlap_count": int(overlap.sum()),
167 |                 "assigned_count_mw64": int((assigned == "mw64").sum()),
168 |                 "assigned_count_mw71": int((assigned == "mw71").sum()),
169 |                 "outside_count": int((assigned == "outside").sum()),
170 |             }
171 |         )
172 |     return pd.concat(records, ignore_index=True), pd.DataFrame(overlap_records)
