175 | def compute_mc_maxc(mags: np.ndarray, delta_m: float) -> float | None:
176 |     if len(mags) == 0:
177 |         return None
178 |     try:
179 |         mc, _ = estimate_mc_maxc(np.asarray(mags, dtype=float), fmd_bin=delta_m)
180 |         return float(mc)
181 |     except Exception:
182 |         return None
183 | 
184 | 
185 | def aki_utsu_b(mags_above: np.ndarray, mc: float, delta_m: float) -> float | None:
186 |     mags_above = np.asarray(mags_above, dtype=float)
187 |     if len(mags_above) < 2:
188 |         return None
189 |     denom = mags_above.mean() - mc + delta_m / 2.0
190 |     if denom <= 0:
191 |         return None
192 |     return float(np.log10(np.e) / denom)
193 | 
194 | 
195 | def estimate_a_value(n_above: int, mc: float, b_value: float) -> float | None:
196 |     if n_above < 1 or not np.isfinite(b_value):
197 |         return None
198 |     return float(np.log10(n_above) + b_value * mc)
