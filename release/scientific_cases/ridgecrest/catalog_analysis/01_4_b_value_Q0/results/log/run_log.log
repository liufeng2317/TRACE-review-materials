159 | def choose_local_crs(latitudes: list[float], longitudes: list[float]) -> CRS:
160 |     lon0 = float(np.mean(longitudes))
161 |     lat0 = float(np.mean(latitudes))
162 |     proj4 = f'+proj=aeqd +lat_0={lat0} +lon_0={lon0} +datum=WGS84 +units=m +no_defs'
163 |     return CRS.from_proj4(proj4)
