255 | def make_fmd(magnitudes: np.ndarray, delta_m: float) -> pd.DataFrame:
256 |     if len(magnitudes) == 0:
257 |         return pd.DataFrame(columns=['mag_bin', 'count_non_cum', 'count_cum'])
258 |     start = math.floor(magnitudes.min() / delta_m) * delta_m
259 |     end = math.ceil(magnitudes.max() / delta_m) * delta_m + delta_m * 0.5
260 |     bins = np.arange(start, end + delta_m, delta_m)
261 |     counts, edges = np.histogram(magnitudes, bins=bins)
262 |     centers = edges[:-1]
263 |     cum = counts[::-1].cumsum()[::-1]
264 |     return pd.DataFrame({'mag_bin': centers, 'count_non_cum': counts, 'count_cum': cum})
265 | 
