267 | def compute_subset_row(events: pd.DataFrame, subset_info: dict, mc_used: float, auto_mc: float | None, conservative_mc: float | None, delta_m: float) -> tuple[dict, np.ndarray]:
268 |     mags = events['magnitude'].to_numpy(dtype=float)
269 |     mags_above = mags[mags >= mc_used - 1e-12]
270 |     total_events = int(len(events))
271 |     n_above = int(len(mags_above))
272 |     b_value = aki_utsu_b(mags_above, mc_used, delta_m)
273 |     a_value = estimate_a_value(n_above, mc_used, b_value) if b_value is not None else None
274 |     row = {
275 |         **subset_info,
276 |         'total_events': total_events,
277 |         'mc_used': mc_used,
278 |         'mc_auto_maxc': auto_mc,
279 |         'mc_conservative': conservative_mc,
280 |         'n_ge_mc': n_above,
281 |         'b_value': b_value,
282 |         'a_value': a_value,
283 |         'magnitude_min_all': float(np.min(mags)) if total_events else np.nan,
284 |         'magnitude_max_all': float(np.max(mags)) if total_events else np.nan,
285 |         'magnitude_min_ge_mc': float(np.min(mags_above)) if n_above else np.nan,
286 |         'magnitude_max_ge_mc': float(np.max(mags_above)) if n_above else np.nan,
287 |         'magnitude_mean_ge_mc': float(np.mean(mags_above)) if n_above else np.nan,
288 |         'reliability': reliability_label(n_above),
289 |         'estimable': bool(n_above >= 2 and b_value is not None),
290 |         'delta_m': delta_m,
291 |     }
292 |     return row, mags_above
