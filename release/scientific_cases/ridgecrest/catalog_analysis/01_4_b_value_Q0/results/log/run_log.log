613 |     def get_fixed_row(window, domain, radius_km=None, catalog_name='interevent'):
614 |         df = fixed_df[(fixed_df['catalog_name'] == catalog_name) & (fixed_df['window'] == window) & (fixed_df['domain'] == domain)]
