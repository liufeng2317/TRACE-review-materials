245 | def reliability_label(n_above_mc: int) -> str:
246 |     if n_above_mc >= 100:
247 |         return 'robust'
248 |     if n_above_mc >= 50:
249 |         return 'usable_moderately_uncertain'
250 |     if n_above_mc >= 30:
251 |         return 'exploratory'
252 |     return 'highly_unreliable'
