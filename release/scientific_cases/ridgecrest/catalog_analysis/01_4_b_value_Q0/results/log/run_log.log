201 | def bootstrap_subset(task: SubsetTask) -> tuple[dict, dict]:
202 |     start = time.time()
203 |     mags_above = np.fromstring(task.magnitudes_above_mc_csv, sep=',') if task.magnitudes_above_mc_csv else np.array([], dtype=float)
204 |     result = {
205 |         'subset_id': task.subset_id,
206 |         'bootstrap_replicates': BOOTSTRAP_SAMPLES,
207 |         'bootstrap_seed': task.seed,
208 |         'bootstrap_b_median': np.nan,
209 |         'bootstrap_b_p16': np.nan,
210 |         'bootstrap_b_p84': np.nan,
211 |         'bootstrap_b_std': np.nan,
212 |     }
213 |     meta = {
214 |         'subset_id': task.subset_id,
215 |         'replicates_requested': BOOTSTRAP_SAMPLES,
216 |         'replicates_completed': 0,
217 |         'seed': task.seed,
218 |         'worker_pid': os.getpid(),
219 |         'runtime_sec': np.nan,
220 |         'warning': '',
221 |     }
222 |     if len(mags_above) < 2:
223 |         meta['warning'] = 'insufficient_events_above_mc_for_bootstrap'
224 |         meta['runtime_sec'] = time.time() - start
225 |         return result, meta
226 |     rng = np.random.default_rng(task.seed)
227 |     samples = np.empty(BOOTSTRAP_SAMPLES, dtype=float)
228 |     for i in range(BOOTSTRAP_SAMPLES):
229 |         resampled = rng.choice(mags_above, size=len(mags_above), replace=True)
230 |         b = aki_utsu_b(resampled, task.mc_used, task.delta_m)
231 |         samples[i] = np.nan if b is None else b
232 |     valid = samples[np.isfinite(samples)]
233 |     if len(valid) == 0:
234 |         meta['warning'] = 'all_bootstrap_samples_invalid'
235 |     else:
236 |         result['bootstrap_b_median'] = float(np.nanmedian(valid))
237 |         result['bootstrap_b_p16'] = float(np.nanpercentile(valid, 16))
238 |         result['bootstrap_b_p84'] = float(np.nanpercentile(valid, 84))
239 |         result['bootstrap_b_std'] = float(np.nanstd(valid, ddof=1)) if len(valid) > 1 else 0.0
240 |         meta['replicates_completed'] = int(len(valid))
241 |     meta['runtime_sec'] = time.time() - start
242 |     return result, meta
