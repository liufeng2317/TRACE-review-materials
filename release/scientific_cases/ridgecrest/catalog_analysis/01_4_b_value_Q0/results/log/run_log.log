623 |     def bootstrap_diff_summary(row_a, row_b):
624 |         if row_a is None or row_b is None:
625 |             return (np.nan, np.nan, np.nan, np.nan, 'missing_component')
626 |         task_a = task_map[row_a['subset_id']]
627 |         task_b = task_map[row_b['subset_id']]
628 |         mags_a = np.fromstring(task_a.magnitudes_above_mc_csv, sep=',') if task_a.magnitudes_above_mc_csv else np.array([], dtype=float)
629 |         mags_b = np.fromstring(task_b.magnitudes_above_mc_csv, sep=',') if task_b.magnitudes_above_mc_csv else np.array([], dtype=float)
630 |         if len(mags_a) < 2 or len(mags_b) < 2:
631 |             return (np.nan, np.nan, np.nan, np.nan, 'insufficient_component_events')
632 |         rng_a = np.random.default_rng(int(row_a['bootstrap_seed']))
633 |         rng_b = np.random.default_rng(int(row_b['bootstrap_seed']) + 100000)
634 |         diffs = np.empty(BOOTSTRAP_SAMPLES, dtype=float)
635 |         for i in range(BOOTSTRAP_SAMPLES):
636 |             ba = aki_utsu_b(rng_a.choice(mags_a, size=len(mags_a), replace=True), row_a['mc_used'], row_a['delta_m'])
637 |             bb = aki_utsu_b(rng_b.choice(mags_b, size=len(mags_b), replace=True), row_b['mc_used'], row_b['delta_m'])
638 |             diffs[i] = np.nan if (ba is None or bb is None) else (ba - bb)
639 |         diffs = diffs[np.isfinite(diffs)]
640 |         if len(diffs) == 0:
641 |             return (np.nan, np.nan, np.nan, np.nan, 'no_valid_bootstrap_differences')
642 |         return (float(np.nanmedian(diffs)), float(np.nanpercentile(diffs, 16)), float(np.nanpercentile(diffs, 84)), float(np.nanstd(diffs, ddof=1)) if len(diffs) > 1 else 0.0, 'ok')
