295 | def draw_gr_line(ax, mc, b, a, mags, label, color):
296 |     if b is None or a is None or len(mags) == 0:
297 |         return
298 |     x = np.linspace(mc, max(float(np.max(mags)), mc + 0.5), 100)
299 |     y = 10 ** (a - b * x)
300 |     ax.plot(x, y, color=color, linestyle='--', linewidth=1.5, label=label)
