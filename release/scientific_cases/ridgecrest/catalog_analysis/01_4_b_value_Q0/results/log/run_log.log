134 | def infer_delta_m(series: pd.Series) -> tuple[float, dict]:
135 |     vals = np.sort(np.unique(np.round(series.dropna().to_numpy(dtype=float), 6)))
136 |     diffs = np.diff(vals)
137 |     diffs = diffs[diffs > 1e-5]
138 |     if len(diffs) == 0:
139 |         delta = 0.1
140 |         return delta, {'strategy': 'fallback_single_value', 'delta_m': delta}
141 |     rounded = np.round(diffs, 4)
142 |     counts = pd.Series(rounded).value_counts().sort_values(ascending=False)
143 |     stable = counts[counts >= max(3, int(0.01 * len(rounded)))]
144 |     if not stable.empty:
145 |         delta = float(stable.index.min())
146 |         strategy = 'smallest_stable_repeated_increment'
147 |     else:
148 |         delta = float(np.quantile(diffs, 0.1))
149 |         strategy = 'low_quantile_increment'
150 |     delta = round(delta, 3 if delta >= 0.1 else 2)
151 |     if delta <= 0:
152 |         delta = 0.01
153 |     return delta, {
154 |         'strategy': strategy,
155 |         'delta_m': delta,
156 |         'min_diff_raw': float(diffs.min()),
157 |         'median_diff_raw': float(np.median(diffs)),
158 |         'top_rounded_diffs': {str(k): int(v) for k, v in counts.head(10).items()},
159 |     }
