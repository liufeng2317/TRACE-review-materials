166 | def project_points(df: pd.DataFrame, crs: CRS) -> pd.DataFrame:
167 |     transformer = Transformer.from_crs('EPSG:4326', crs, always_xy=True)
168 |     x, y = transformer.transform(df['longitude'].to_numpy(), df['latitude'].to_numpy())
169 |     out = df.copy()
170 |     out['x_m'] = x
171 |     out['y_m'] = y
172 |     return out
