131 | def infer_delta_m(series: pd.Series) -> tuple[float, dict]:
132 |     vals = np.sort(np.unique(np.round(series.dropna().to_numpy(dtype=float), 6)))
133 |     diffs = np.diff(vals)
134 |     diffs = diffs[diffs > 1e-5]
135 |     if len(diffs) == 0:
136 |         delta = 0.1
137 |         return delta, {'strategy': 'fallback_single_value', 'delta_m': delta}
138 |     rounded = np.round(diffs, 4)
139 |     counts = pd.Series(rounded).value_counts().sort_values(ascending=False)
140 |     stable = counts[counts >= max(3, int(0.01 * len(rounded)))]
141 |     if not stable.empty:
142 |         delta = float(stable.index.min())
143 |         strategy = 'smallest_stable_repeated_increment'
144 |     else:
145 |         delta = float(np.quantile(diffs, 0.1))
146 |         strategy = 'low_quantile_increment'
147 |     delta = round(delta, 3 if delta >= 0.1 else 2)
148 |     if delta <= 0:
149 |         delta = 0.01
150 |     return delta, {
151 |         'strategy': strategy,
152 |         'delta_m': delta,
153 |         'min_diff_raw': float(diffs.min()),
154 |         'median_diff_raw': float(np.median(diffs)),
155 |         'top_rounded_diffs': {str(k): int(v) for k, v in counts.head(10).items()},
156 |     }
