 98 | def canonicalize_catalog(df: pd.DataFrame, catalog_name: str, mapping: dict[str, str] | None = None) -> tuple[pd.DataFrame, dict]:
 99 |     original_count = len(df)
100 |     out = df.copy()
101 |     if mapping:
102 |         out = out.rename(columns=mapping)
103 |     required = ['event_time', 'latitude', 'longitude', 'depth_km', 'magnitude']
104 |     missing = [c for c in required if c not in out.columns]
105 |     if missing:
106 |         raise ValueError(f'{catalog_name}: missing required columns {missing}')
107 |     out = out.reset_index(drop=False).rename(columns={'index': 'source_row_index'})
108 |     out['event_time'] = pd.to_datetime(out['event_time'], utc=True, errors='coerce')
109 |     for col in ['latitude', 'longitude', 'depth_km', 'magnitude']:
110 |         out[col] = pd.to_numeric(out[col], errors='coerce')
111 |     before_dropna = len(out)
112 |     out = out.dropna(subset=required).copy()
113 |     removed_missing = before_dropna - len(out)
114 |     out['event_id'] = [f'{catalog_name}_{i:07d}' for i in out['source_row_index'].to_numpy()]
115 |     before_dupes = len(out)
116 |     out = out.drop_duplicates(subset=['event_time', 'latitude', 'longitude', 'depth_km', 'magnitude'], keep='first').copy()
117 |     removed_dupes = before_dupes - len(out)
118 |     out = out.sort_values(['event_time', 'event_id']).reset_index(drop=True)
119 |     meta = {
120 |         'catalog_name': catalog_name,
121 |         'rows_original': original_count,
122 |         'rows_cleaned': len(out),
123 |         'removed_missing_or_nonfinite': removed_missing,
124 |         'removed_exact_duplicates': removed_dupes,
125 |         'time_min': out['event_time'].min(),
126 |         'time_max': out['event_time'].max(),
127 |     }
128 |     return out, meta
