234 |     progress_step = max(1, BOOTSTRAP_SAMPLES // 4)
235 |     for i in range(BOOTSTRAP_SAMPLES):
236 |         resampled = rng.choice(mags_above, size=len(mags_above), replace=True)
237 |         b = aki_utsu_b(resampled, task.mc_used, task.delta_m)
238 |         samples[i] = np.nan if b is None else b
239 |         if (i + 1) % progress_step == 0 or i + 1 == BOOTSTRAP_SAMPLES:
240 |             print(f'bootstrap_worker subset={task.subset_id} progress={i + 1}/{BOOTSTRAP_SAMPLES}', flush=True)
241 |     valid = samples[np.isfinite(samples)]
242 |     if len(valid) == 0:
243 |         meta['warning'] = 'all_bootstrap_samples_invalid'
244 |     else:
245 |         result['bootstrap_b_median'] = float(np.nanmedian(valid))
246 |         result['bootstrap_b_p16'] = float(np.nanpercentile(valid, 16))
247 |         result['bootstrap_b_p84'] = float(np.nanpercentile(valid, 84))
248 |         result['bootstrap_b_std'] = float(np.nanstd(valid, ddof=1)) if len(valid) > 1 else 0.0
249 |         meta['replicates_completed'] = int(len(valid))
250 |     meta['runtime_sec'] = time.time() - start
251 |     return result, meta
252 | 
