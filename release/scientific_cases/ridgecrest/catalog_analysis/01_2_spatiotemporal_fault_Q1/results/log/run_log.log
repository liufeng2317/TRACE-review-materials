406 | def summarize_one_bin(bin_row: pd.Series, events_pre71: pd.DataFrame, event_metrics: pd.DataFrame, along_origin: float) -> Dict[str, object]:
407 |     start = pd.Timestamp(bin_row["start_time"])
408 |     end = pd.Timestamp(bin_row["end_time"])
409 |     end_inclusive = bool(bin_row["end_inclusive"])
410 |     if end_inclusive:
411 |         in_bin = event_metrics[(event_metrics["event_time"] >= start) & (event_metrics["event_time"] <= end)].copy()
412 |     else:
413 |         in_bin = event_metrics[(event_metrics["event_time"] >= start) & (event_metrics["event_time"] < end)].copy()
414 |     out: Dict[str, object] = {
415 |         "bin_id": int(bin_row["bin_id"]),
416 |         "stage": bin_row["stage"],
417 |         "start_time": start,
418 |         "end_time": end,
419 |         "end_inclusive": end_inclusive,
420 |         "page": int(bin_row["page"]),
421 |         "subplot_index": int(bin_row["subplot_index"]),
422 |         "event_count": int(len(in_bin)),
423 |     }
424 |     if len(in_bin) == 0:
425 |         out.update(
426 |             {
427 |                 "centroid_x_km": np.nan,
428 |                 "centroid_y_km": np.nan,
429 |                 "principal_strike_deg": np.nan,
430 |                 "major_spread_km": np.nan,
431 |                 "minor_spread_km": np.nan,
432 |                 "elongation_ratio": np.nan,
433 |                 "median_nearest_fault_distance_km": np.nan,
434 |                 "q25_nearest_fault_distance_km": np.nan,
435 |                 "q75_nearest_fault_distance_km": np.nan,
436 |                 "dominant_local_fault_strike_deg": np.nan,
437 |                 "angular_misfit_deg": np.nan,
438 |                 "fraction_within_0.25km": np.nan,
439 |                 "fraction_within_0.5km": np.nan,
440 |                 "fraction_within_1.0km": np.nan,
441 |                 "fraction_within_2.0km": np.nan,
442 |                 "fraction_within_5.0km": np.nan,
443 |                 "along_strike_min_km": np.nan,
444 |                 "along_strike_max_km": np.nan,
445 |                 "along_strike_range_km": np.nan,
446 |                 "newly_activated_range_km": np.nan,
447 |                 "is_sparse_for_orientation": True,
448 |             }
449 |         )
450 |         return out
451 |     pmetrics = principal_axis_metrics(in_bin["x_km"].to_numpy(), in_bin["y_km"].to_numpy())
