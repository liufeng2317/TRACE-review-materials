162 | def build_page_payloads(time_bins: pd.DataFrame, catalog: pd.DataFrame) -> List[Tuple[int, List[Dict[str, object]]]]:
163 |     payloads: List[Tuple[int, List[Dict[str, object]]]] = []
164 |     for page, page_df in time_bins.sort_values(["page", "subplot_index"]).groupby("page", sort=True):
165 |         page_bins: List[Dict[str, object]] = []
166 |         for _, row in page_df.iterrows():
167 |             start = row["start_time"]
168 |             end = row["end_time"]
169 |             end_inclusive = bool(row["end_inclusive"])
170 |             if end_inclusive:
171 |                 current_mask = (catalog["event_time"] >= start) & (catalog["event_time"] <= end)
172 |             else:
173 |                 current_mask = (catalog["event_time"] >= start) & (catalog["event_time"] < end)
174 |             prior_mask = (catalog["event_time"] >= time_bins["start_time"].min()) & (catalog["event_time"] < start)
175 |             current = catalog.loc[current_mask, ["longitude", "latitude"]].to_numpy(dtype=float)
176 |             prior = catalog.loc[prior_mask, ["longitude", "latitude"]].to_numpy(dtype=float)
177 |             page_bins.append(
178 |                 {
179 |                     "bin_id": int(row["bin_id"]),
180 |                     "subplot_index": int(row["subplot_index"]),
181 |                     "stage": row["stage"],
182 |                     "start": start,
183 |                     "end": end,
184 |                     "end_inclusive": end_inclusive,
185 |                     "current": current,
186 |                     "prior": prior,
187 |                     "bin_event_count": int(len(current)),
188 |                     "prior_event_count": int(len(prior)),
189 |                     "elapsed_hours": float(row["elapsed_hours_since_mainshock64"]),
190 |                 }
191 |             )
192 |         payloads.append((int(page), page_bins))
193 |     return payloads
