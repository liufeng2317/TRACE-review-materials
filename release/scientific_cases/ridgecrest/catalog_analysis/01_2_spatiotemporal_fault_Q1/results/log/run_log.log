579 | def build_lonlat_limits(map_extent: pd.DataFrame) -> Tuple[Tuple[float, float], Tuple[float, float]]:
580 |     row = map_extent.iloc[0]
581 |     transformer = Transformer.from_crs(LOCAL_AEQD_CRS, WGS84_CRS, always_xy=True)
582 |     xs = [row["xmin_km"], row["xmax_km"], row["xmax_km"], row["xmin_km"]]
583 |     ys = [row["ymin_km"], row["ymin_km"], row["ymax_km"], row["ymax_km"]]
584 |     lon, lat = transformer.transform(xs, ys)
585 |     lon_limits = (float(np.min(lon)), float(np.max(lon)))
586 |     lat_limits = (float(np.min(lat)), float(np.max(lat)))
587 |     return lon_limits, lat_limits
