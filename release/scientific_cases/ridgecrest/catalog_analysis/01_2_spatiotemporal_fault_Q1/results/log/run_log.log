356 | def compute_event_fault_metrics(events: pd.DataFrame, seg_df: pd.DataFrame, label: str) -> pd.DataFrame:
357 |     if events.empty:
358 |         raise ValueError(f"No events available for metric computation in window '{label}'")
359 |     log(f"Computing nearest-fault metrics for {label}: {len(events):,} events")
360 |     seg_arrays = {col: seg_df[col].to_numpy() for col in ["segment_id", "fault_id", "x1_km", "y1_km", "x2_km", "y2_km", "length_km", "strike_deg"]}
361 |     kdtree_data = {"mid_x_km": seg_df["mid_x_km"].to_numpy(), "mid_y_km": seg_df["mid_y_km"].to_numpy()}
362 |     chunks = [events.iloc[i : i + EVENT_CHUNK_SIZE].copy() for i in range(0, len(events), EVENT_CHUNK_SIZE)]
363 |     results = []
364 |     candidate_k = 24
365 |     with ProcessPoolExecutor(max_workers=MAX_WORKERS) as ex:
366 |         futures = [
367 |             ex.submit(_process_event_chunk, chunk, seg_arrays, kdtree_data, candidate_k)
368 |             for chunk in chunks
369 |         ]
370 |         for fut in tqdm(as_completed(futures), total=len(futures), desc=f"Nearest-fault {label}"):
371 |             results.append(fut.result())
372 |     metrics = pd.concat(results, ignore_index=True)
373 |     merged = events.merge(metrics, on="event_id", how="left", validate="one_to_one")
374 |     missing = merged["nearest_fault_distance_km"].isna().sum()
375 |     if missing:
376 |         raise ValueError(f"Nearest-fault metric computation left {missing} events without distance values")
377 |     log(f"Completed nearest-fault metrics for {label}")
378 |     return merged
