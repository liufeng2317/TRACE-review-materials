482 | def compute_bin_metrics(bin_df: pd.DataFrame, event_metrics_pre71: pd.DataFrame, mainshock64_y: float) -> Tuple[pd.DataFrame, pd.DataFrame]:
483 |     log("Computing bin-level directional and along-strike metrics")
484 |     rows = []
485 |     for _, bin_row in tqdm(bin_df.iterrows(), total=len(bin_df), desc="Bin summaries"):
486 |         rows.append(summarize_one_bin(bin_row, event_metrics_pre71, event_metrics_pre71, mainshock64_y))
487 |     summary = pd.DataFrame(rows).sort_values("bin_id").reset_index(drop=True)
488 | 
489 |     analysis_start = pd.Timestamp(summary["start_time"].min())
490 |     all_nearest = event_metrics_pre71[["event_id", "event_time", "nearest_point_y_km"]].copy()
491 |     all_nearest["along_strike_km"] = all_nearest["nearest_point_y_km"] - mainshock64_y
492 |     min_along = float(np.floor(all_nearest["along_strike_km"].min() / ALONG_STRIKE_BIN_KM) * ALONG_STRIKE_BIN_KM)
493 |     max_along = float(np.ceil(all_nearest["along_strike_km"].max() / ALONG_STRIKE_BIN_KM) * ALONG_STRIKE_BIN_KM)
494 |     edges = np.arange(min_along, max_along + ALONG_STRIKE_BIN_KM, ALONG_STRIKE_BIN_KM)
495 |     if len(edges) < 2:
496 |         edges = np.array([min_along, min_along + ALONG_STRIKE_BIN_KM])
497 |     all_nearest["along_strike_bin_index"] = np.clip(np.digitize(all_nearest["along_strike_km"], edges) - 1, 0, len(edges) - 2)
498 | 
499 |     first_activation = (
500 |         all_nearest.groupby("along_strike_bin_index", as_index=False)["event_time"].min().rename(columns={"event_time": "first_activation_time"})
501 |     )
502 |     first_activation["along_strike_bin_start_km"] = edges[first_activation["along_strike_bin_index"]]
503 |     first_activation["along_strike_bin_end_km"] = edges[first_activation["along_strike_bin_index"] + 1]
504 |     first_activation["hours_since_mainshock64"] = (
505 |         first_activation["first_activation_time"] - analysis_start
506 |     ).dt.total_seconds() / 3600.0
507 | 
508 |     cumulative_seen: set[int] = set()
509 |     newly_ranges = []
510 |     cumulative_ranges = []
511 |     cumulative_counts = []
512 |     for _, row in summary.iterrows():
513 |         start = pd.Timestamp(row["start_time"])
514 |         end = pd.Timestamp(row["end_time"])
515 |         if bool(row["end_inclusive"]):
516 |             in_bin = all_nearest[(all_nearest["event_time"] >= start) & (all_nearest["event_time"] <= end)]
517 |             cumulative = all_nearest[(all_nearest["event_time"] >= analysis_start) & (all_nearest["event_time"] <= end)]
518 |         else:
519 |             in_bin = all_nearest[(all_nearest["event_time"] >= start) & (all_nearest["event_time"] < end)]
520 |             cumulative = all_nearest[(all_nearest["event_time"] >= analysis_start) & (all_nearest["event_time"] < end)]
521 |         current_bins = set(in_bin["along_strike_bin_index"].astype(int).tolist())
522 |         new_bins = current_bins - cumulative_seen
523 |         cumulative_seen |= current_bins
524 |         cumulative_bins = sorted(set(cumulative["along_strike_bin_index"].astype(int).tolist()))
525 |         cumulative_counts.append(len(cumulative_bins))
526 |         if cumulative_bins:
527 |             cumulative_ranges.append(float(edges[max(cumulative_bins) + 1] - edges[min(cumulative_bins)]))
528 |         else:
529 |             cumulative_ranges.append(np.nan)
530 |         if new_bins:
531 |             new_bins_sorted = sorted(new_bins)
532 |             newly_ranges.append(float(edges[max(new_bins_sorted) + 1] - edges[min(new_bins_sorted)]))
533 |         else:
534 |             newly_ranges.append(0.0)
535 |     summary["newly_activated_range_km"] = newly_ranges
536 |     summary["cumulative_occupied_range_km"] = cumulative_ranges
537 |     summary["cumulative_occupied_bin_count"] = cumulative_counts
538 |     return summary, first_activation.sort_values("along_strike_bin_start_km").reset_index(drop=True)
