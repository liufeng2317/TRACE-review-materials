289 | def compute_extent(catalog: pd.DataFrame, mainshocks: pd.DataFrame, fault_polys: pd.DataFrame, mainshock71_time: pd.Timestamp) -> pd.DataFrame:
290 |     relevant_events = select_time_window(catalog, mainshocks["event_time"].min(), mainshock71_time + pd.Timedelta(days=2), True)
291 |     xmin = min(relevant_events["x_km"].min(), mainshocks["x_km"].min(), fault_polys["min_x_km"].min()) - MAP_MARGIN_KM
292 |     xmax = max(relevant_events["x_km"].max(), mainshocks["x_km"].max(), fault_polys["max_x_km"].max()) + MAP_MARGIN_KM
293 |     ymin = min(relevant_events["y_km"].min(), mainshocks["y_km"].min(), fault_polys["min_y_km"].min()) - MAP_MARGIN_KM
294 |     ymax = max(relevant_events["y_km"].max(), mainshocks["y_km"].max(), fault_polys["max_y_km"].max()) + MAP_MARGIN_KM
295 |     extent = pd.DataFrame(
296 |         [{
297 |             "xmin_km": float(xmin),
298 |             "xmax_km": float(xmax),
299 |             "ymin_km": float(ymin),
300 |             "ymax_km": float(ymax),
301 |         }]
302 |     )
303 |     return extent
304 | 
305 | 
306 | def _process_event_chunk(
307 |     event_chunk: pd.DataFrame,
308 |     seg_arrays: Dict[str, np.ndarray],
309 |     kdtree_data: Dict[str, np.ndarray],
310 |     candidate_k: int,
311 | ) -> pd.DataFrame:
312 |     tree = cKDTree(np.column_stack([kdtree_data["mid_x_km"], kdtree_data["mid_y_km"]]))
313 |     x = event_chunk["x_km"].to_numpy()
314 |     y = event_chunk["y_km"].to_numpy()
315 |     k = min(candidate_k, len(kdtree_data["mid_x_km"]))
316 |     dists, idxs = tree.query(np.column_stack([x, y]), k=k)
317 |     if k == 1:
318 |         idxs = idxs[:, None]
319 |     rows = []
320 |     for i in range(len(event_chunk)):
321 |         px = x[i]
322 |         py = y[i]
323 |         best = None
324 |         candidate_indices = np.unique(np.atleast_1d(idxs[i]).astype(int))
325 |         for cand in candidate_indices:
326 |             x1 = seg_arrays["x1_km"][cand]
327 |             y1 = seg_arrays["y1_km"][cand]
328 |             x2 = seg_arrays["x2_km"][cand]
329 |             y2 = seg_arrays["y2_km"][cand]
330 |             dx = x2 - x1
331 |             dy = y2 - y1
332 |             seg_len2 = dx * dx + dy * dy
333 |             t = 0.0 if seg_len2 == 0 else ((px - x1) * dx + (py - y1) * dy) / seg_len2
334 |             t_clip = min(1.0, max(0.0, t))
335 |             qx = x1 + t_clip * dx
336 |             qy = y1 + t_clip * dy
337 |             dist = math.hypot(px - qx, py - qy)
338 |             if best is None or dist < best["nearest_fault_distance_km"]:
339 |                 best = {
340 |                     "event_id": int(event_chunk.iloc[i]["event_id"]),
341 |                     "nearest_segment_id": int(seg_arrays["segment_id"][cand]),
342 |                     "nearest_fault_id": int(seg_arrays["fault_id"][cand]),
343 |                     "nearest_fault_distance_km": float(dist),
344 |                     "nearest_point_x_km": float(qx),
345 |                     "nearest_point_y_km": float(qy),
346 |                     "segment_fraction": float(t_clip),
347 |                     "segment_length_km": float(seg_arrays["length_km"][cand]),
348 |                     "distance_along_segment_km": float(t_clip * seg_arrays["length_km"][cand]),
349 |                     "nearest_segment_strike_deg": float(seg_arrays["strike_deg"][cand]),
350 |                     "segment_midpoint_distance_km": float(np.atleast_1d(dists[i])[0]) if np.ndim(dists) > 1 else float(dists[i]),
351 |                 }
352 |         rows.append(best)
353 |     return pd.DataFrame(rows)
354 | 
