387 | def compute_distance_bin_statistics(pre71: pd.DataFrame, time_bins: pd.DataFrame) -> pd.DataFrame:
388 |     log("Computing nearest-fault distance statistics by time bin")
389 |     rows: List[Dict[str, object]] = []
390 |     for _, row in tqdm(time_bins.sort_values("bin_id").iterrows(), total=len(time_bins), desc="Distance stats"):
391 |         start = row["start_time"]
392 |         end = row["end_time"]
393 |         end_inclusive = bool(row["end_inclusive"])
394 |         subset = select_window(pre71, start, end, end_inclusive)
395 |         d = subset["nearest_fault_distance_km"].to_numpy(dtype=float)
396 |         out = {
397 |             "bin_id": int(row["bin_id"]),
398 |             "stage": row["stage"],
399 |             "start_time": start,
400 |             "end_time": end,
401 |             "end_inclusive": end_inclusive,
402 |             "event_count": int(len(subset)),
403 |             "median_km": float(np.nanmedian(d)) if len(d) else np.nan,
404 |             "q25_km": float(np.nanquantile(d, 0.25)) if len(d) else np.nan,
405 |             "q75_km": float(np.nanquantile(d, 0.75)) if len(d) else np.nan,
406 |             "q90_km": float(np.nanquantile(d, 0.90)) if len(d) else np.nan,
407 |         }
408 |         for thr in NEAR_FAULT_THRESHOLDS_KM:
409 |             out[f"fraction_within_{thr:.2f}km"] = float(np.mean(d <= thr)) if len(d) else np.nan
410 |         rows.append(out)
411 |     return pd.DataFrame(rows)
