150 | def select_window(df: pd.DataFrame, start: pd.Timestamp, end: pd.Timestamp, end_inclusive: bool = False) -> pd.DataFrame:
151 |     if end_inclusive:
152 |         mask = (df["event_time"] >= start) & (df["event_time"] <= end)
153 |     else:
154 |         mask = (df["event_time"] >= start) & (df["event_time"] < end)
155 |     return df.loc[mask].copy()
156 | 
