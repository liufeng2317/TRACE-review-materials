 90 | def angular_misfit_deg(a_deg: float, b_deg: float) -> float:
 91 |     if np.isnan(a_deg) or np.isnan(b_deg):
 92 |         return np.nan
 93 |     diff = abs((a_deg - b_deg + 90.0) % 180.0 - 90.0)
 94 |     return float(diff)
 95 | 
 96 | 
 97 | def strike_from_dxdy(dx: float, dy: float) -> float:
 98 |     angle = math.degrees(math.atan2(dx, dy)) % 180.0
 99 |     return float(angle)
100 | 
101 | 
102 | def weighted_orientation_deg(strikes_deg: np.ndarray, weights: np.ndarray) -> float:
103 |     if len(strikes_deg) == 0:
104 |         return np.nan
105 |     theta = np.deg2rad(np.asarray(strikes_deg) * 2.0)
106 |     weights = np.asarray(weights)
107 |     c = np.sum(weights * np.cos(theta))
108 |     s = np.sum(weights * np.sin(theta))
109 |     if c == 0 and s == 0:
110 |         return np.nan
111 |     return float((np.rad2deg(np.arctan2(s, c)) / 2.0) % 180.0)
112 | 
113 | 
114 | def principal_axis_metrics(x_km: np.ndarray, y_km: np.ndarray) -> Dict[str, float]:
115 |     n = len(x_km)
116 |     if n < 2:
117 |         return {
118 |             "centroid_x_km": float(np.mean(x_km)) if n else np.nan,
119 |             "centroid_y_km": float(np.mean(y_km)) if n else np.nan,
120 |             "principal_strike_deg": np.nan,
121 |             "major_spread_km": np.nan,
122 |             "minor_spread_km": np.nan,
123 |             "elongation_ratio": np.nan,
124 |         }
125 |     x0 = x_km - np.mean(x_km)
126 |     y0 = y_km - np.mean(y_km)
127 |     cov = np.cov(np.vstack([x0, y0]))
128 |     vals, vecs = np.linalg.eigh(cov)
129 |     order = np.argsort(vals)[::-1]
130 |     vals = vals[order]
131 |     vecs = vecs[:, order]
132 |     principal_vec = vecs[:, 0]
133 |     strike_deg = strike_from_dxdy(principal_vec[0], principal_vec[1])
134 |     major = float(np.sqrt(max(vals[0], 0.0)))
135 |     minor = float(np.sqrt(max(vals[1], 0.0)))
136 |     elong = float(major / minor) if minor > 0 else np.inf
137 |     return {
138 |         "centroid_x_km": float(np.mean(x_km)),
139 |         "centroid_y_km": float(np.mean(y_km)),
140 |         "principal_strike_deg": strike_deg,
141 |         "major_spread_km": major,
142 |         "minor_spread_km": minor,
143 |         "elongation_ratio": elong,
144 |     }
