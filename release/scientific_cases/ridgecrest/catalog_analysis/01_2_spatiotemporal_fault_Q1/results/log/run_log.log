346 |         best = None
347 |         candidate_indices = np.unique(np.atleast_1d(idxs[i]).astype(int))
348 |         for cand in candidate_indices:
349 |             x1 = seg_arrays["x1_km"][cand]
350 |             y1 = seg_arrays["y1_km"][cand]
351 |             x2 = seg_arrays["x2_km"][cand]
352 |             y2 = seg_arrays["y2_km"][cand]
353 |             dx = x2 - x1
354 |             dy = y2 - y1
355 |             seg_len2 = dx * dx + dy * dy
356 |             t = 0.0 if seg_len2 == 0 else ((px - x1) * dx + (py - y1) * dy) / seg_len2
357 |             t_clip = min(1.0, max(0.0, t))
358 |             qx = x1 + t_clip * dx
359 |             qy = y1 + t_clip * dy
360 |             dist = math.hypot(px - qx, py - qy)
361 |             if best is None or dist < best["nearest_fault_distance_km"]:
362 |                 best = {
363 |                     "event_id": int(event_chunk.iloc[i]["event_id"]),
364 |                     "nearest_segment_id": int(seg_arrays["segment_id"][cand]),
365 |                     "nearest_fault_id": int(seg_arrays["fault_id"][cand]),
366 |                     "nearest_fault_distance_km": float(dist),
367 |                     "nearest_point_x_km": float(qx),
368 |                     "nearest_point_y_km": float(qy),
369 |                     "segment_fraction": float(t_clip),
