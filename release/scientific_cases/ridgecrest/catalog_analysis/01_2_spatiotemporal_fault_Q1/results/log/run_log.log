284 | def generate_time_sliced_maps(
285 |     time_bins: pd.DataFrame,
286 |     catalog: pd.DataFrame,
287 |     fault_polylines: List[np.ndarray],
288 |     mainshocks: pd.DataFrame,
289 |     lon_limits: Tuple[float, float],
290 |     lat_limits: Tuple[float, float],
291 | ) -> Tuple[pd.DataFrame, List[str]]:
292 |     payloads = build_page_payloads(time_bins, catalog)
293 |     log(f"Generating {len(payloads)} time-sliced map pages with up to {MAX_WORKERS} workers")
294 |     panel_rows: List[Dict[str, object]] = []
295 |     figure_paths: List[str] = []
296 |     workers = min(MAX_WORKERS, max(1, len(payloads)))
297 |     with ProcessPoolExecutor(max_workers=workers) as executor:
298 |         futures = {
299 |             executor.submit(
300 |                 plot_time_sliced_map_page,
301 |                 page,
302 |                 page_bins,
303 |                 fault_polylines,
304 |                 mainshocks,
305 |                 lon_limits,
306 |                 lat_limits,
307 |                 str(OUTPUT_DIR),
308 |             ): page
309 |             for page, page_bins in payloads
310 |         }
311 |         for future in tqdm(as_completed(futures), total=len(futures), desc="Map pages"):
312 |             result = future.result()
313 |             figure_paths.append(result["figure_path"])
314 |             panel_rows.extend(result["panel_rows"])
315 |     manifest = pd.DataFrame(panel_rows).sort_values(["page", "subplot_index"]).reset_index(drop=True)
316 |     return manifest, sorted(figure_paths)
317 | 
