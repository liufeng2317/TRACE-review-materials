    data = bin_summary.sort_values("bin_id").copy()
    data["mid_time"] = data["start_time"] + (data["end_time"] - data["start_time"]) / 2
    data["hours_since_start"] = (data["mid_time"] - data["mid_time"].iloc[0]).dt.total_seconds() / 3600.0
