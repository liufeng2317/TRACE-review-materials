147 | def build_time_bins(mainshock64: pd.Timestamp, mainshock71: pd.Timestamp) -> List[TimeBin]:
148 |     bins: List[TimeBin] = []
149 |     stage1_end = mainshock64 + pd.Timedelta(hours=4)
150 |     stage1_starts = pd.date_range(mainshock64, stage1_end, freq="30min", inclusive="left")
151 |     bin_id = 0
152 |     for start in stage1_starts:
153 |         end = start + pd.Timedelta(minutes=30)
154 |         bins.append(TimeBin(bin_id, "stage1", start, end, False, bin_id // 8 + 1, bin_id % 8))
155 |         bin_id += 1
156 |     stage2_starts = pd.date_range(stage1_end, mainshock71, freq="2h", inclusive="left")
157 |     for i, start in enumerate(stage2_starts):
158 |         end = min(start + pd.Timedelta(hours=2), mainshock71)
159 |         end_inclusive = i == len(stage2_starts) - 1
160 |         bins.append(TimeBin(bin_id, "stage2", start, end, end_inclusive, bin_id // 8 + 1, bin_id % 8))
161 |         bin_id += 1
162 |     return bins
