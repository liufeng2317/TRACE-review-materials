130 |     vals = vals[order]
131 |     vecs = vecs[:, order]
132 |     principal_vec = vecs[:, 0]
133 |     strike_deg = strike_from_dxdy(principal_vec[0], principal_vec[1])
134 |     major = float(np.sqrt(max(vals[0], 0.0)))
135 |     minor = float(np.sqrt(max(vals[1], 0.0)))
136 |     elong = float(major / minor) if minor > 0 else np.inf
137 |     return {
138 |         "centroid_x_km": float(np.mean(x_km)),
139 |         "centroid_y_km": float(np.mean(y_km)),
