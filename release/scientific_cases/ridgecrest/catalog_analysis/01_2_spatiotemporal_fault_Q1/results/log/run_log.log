139 |     polylines: List[np.ndarray] = []
140 |     grouped = fault_segments.sort_values(["fault_id", "segment_id"]).groupby("fault_id", sort=False)
141 |     for fault_id, group in tqdm(grouped, desc="Fault polyline reconstruction"):
142 |         xy = [[group.iloc[0]["lon1"], group.iloc[0]["lat1"]]]
143 |         for _, row in group.iterrows():
144 |             xy.append([row["lon2"], row["lat2"]])
145 |         polylines.append(np.asarray(xy, dtype=float))
146 |     log(f"Reconstructed {len(polylines):,} fault polylines")
147 |     return polylines
