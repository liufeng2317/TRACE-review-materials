281 | def summarize_group(
282 |     cell_id: int,
283 |     idx: np.ndarray,
284 |     event_hours: np.ndarray,
285 |     event_energy: np.ndarray,
286 |     edges_30m: np.ndarray,
287 |     edges_1h: np.ndarray,
288 | ) -> dict:
289 |     if idx.size == 0:
290 |         return {
291 |             "cell_id": cell_id,
292 |             "event_count": 0,
293 |             "cumulative_energy": 0.0,
294 |             "first_activation_hours": np.nan,
295 |             "peak_rate_time_30m_hours": np.nan,
296 |             "peak_rate_time_1h_hours": np.nan,
297 |             "first_nonzero_bin_30m_hours": np.nan,
298 |             "first_nonzero_bin_1h_hours": np.nan,
299 |             "counts_30m": np.zeros(edges_30m.size - 1, dtype=int),
300 |             "counts_1h": np.zeros(edges_1h.size - 1, dtype=int),
301 |         }
302 |     hours = event_hours[idx]
303 |     energy = event_energy[idx]
304 |     counts_30m, _ = np.histogram(hours, bins=edges_30m)
305 |     counts_1h, _ = np.histogram(hours, bins=edges_1h)
306 |     return {
307 |         "cell_id": cell_id,
308 |         "event_count": int(idx.size),
309 |         "cumulative_energy": float(np.sum(energy)),
310 |         "first_activation_hours": float(np.nanmin(hours)),
311 |         "peak_rate_time_30m_hours": peak_rate_time(counts_30m, edges_30m),
312 |         "peak_rate_time_1h_hours": peak_rate_time(counts_1h, edges_1h),
313 |         "first_nonzero_bin_30m_hours": first_nonzero_bin_center(counts_30m, edges_30m),
314 |         "first_nonzero_bin_1h_hours": first_nonzero_bin_center(counts_1h, edges_1h),
315 |         "counts_30m": counts_30m,
316 |         "counts_1h": counts_1h,
317 |     }
318 | 
319 | 
320 | def parallel_group_summaries(
321 |     group_map: dict[int, np.ndarray],
322 |     event_hours: np.ndarray,
323 |     event_energy: np.ndarray,
324 |     edges_30m: np.ndarray,
325 |     edges_1h: np.ndarray,
326 |     n_jobs: int,
327 | ) -> list[dict]:
328 |     ordered = sorted(group_map.items(), key=lambda kv: kv[0])
329 |     return Parallel(n_jobs=n_jobs, prefer="processes", verbose=10)(
330 |         delayed(summarize_group)(cell_id, idx, event_hours, event_energy, edges_30m, edges_1h)
331 |         for cell_id, idx in ordered
332 |     )
333 | 
334 | 
335 | def build_group_map(cell_ids: np.ndarray, total_cells: int) -> dict[int, np.ndarray]:
336 |     mapping = {cid: np.empty(0, dtype=int) for cid in range(total_cells)}
337 |     if cell_ids.size == 0:
338 |         return mapping
339 |     order = np.argsort(cell_ids)
340 |     sorted_ids = cell_ids[order]
341 |     unique_ids, starts = np.unique(sorted_ids, return_index=True)
342 |     starts = np.append(starts, sorted_ids.size)
343 |     for uid, s0, s1 in zip(unique_ids, starts[:-1], starts[1:]):
344 |         mapping[int(uid)] = order[s0:s1]
345 |     return mapping
