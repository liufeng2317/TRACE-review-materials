188 |     idxs = np.where(streak >= SUSTAINED_ACTIVITY_CONSECUTIVE_BINS)[0]
189 |     if idxs.size == 0:
190 |         return pd.NaT
191 |     return pd.Timestamp(post_df.iloc[int(idxs[0])]["bin_start"])
