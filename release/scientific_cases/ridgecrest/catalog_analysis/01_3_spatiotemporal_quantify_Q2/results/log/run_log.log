341 | def build_assignment_summary(df: pd.DataFrame, corridor_a: Corridor, corridor_b: Corridor) -> pd.DataFrame:
342 |     rows = []
343 |     total = len(df)
344 |     overlap_count = int((df["in_Region_A"] & df["in_Region_B"]).sum())
345 |     unassigned_frac = float((~df["in_Region_A"] & ~df["in_Region_B"]).mean())
346 |     for corridor in [corridor_a, corridor_b]:
347 |         mask = df[f"in_{corridor.name}"]
348 |         subset = df.loc[mask]
349 |         across_abs = subset[f"{corridor.name}_across_km"].abs()
350 |         along_vals = subset[f"{corridor.name}_along_km"]
351 |         rows.append(
352 |             {
353 |                 "region": corridor.name,
354 |                 "assigned_event_count": int(mask.sum()),
355 |                 "assigned_fraction": float(mask.mean()),
356 |                 "corridor_overlap_count": overlap_count,
357 |                 "corridor_overlap_fraction": overlap_count / total if total > 0 else np.nan,
358 |                 "unassigned_corridor_fraction": unassigned_frac,
359 |                 "median_abs_across_km": float(across_abs.median()) if len(across_abs) else np.nan,
360 |                 "p95_abs_across_km": float(across_abs.quantile(0.95)) if len(across_abs) else np.nan,
361 |                 "along_min_km": float(along_vals.min()) if len(along_vals) else np.nan,
362 |                 "along_max_km": float(along_vals.max()) if len(along_vals) else np.nan,
363 |                 "centerline_length_km": corridor.length_km,
364 |                 "half_width_km": corridor.half_width_km,
365 |             }
366 |         )
367 |     return pd.DataFrame(rows)
