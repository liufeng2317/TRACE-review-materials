399 |         counts_1h = s["counts_1h"]
400 |         for i in range(counts_30m.size):
401 |             heatmap_rows.append(
402 |                 {
403 |                     "region": region_name,
404 |                     "cell_id": cid,
405 |                     "along_km": meta["along_km"],
406 |                     "across_km": meta["across_km"],
407 |                     "resolution": "30min",
408 |                     "bin_start_hours": edges_30m[i],
409 |                     "bin_end_hours": edges_30m[i + 1],
410 |                     "event_count": int(counts_30m[i]),
411 |                     "rate_per_hour": float(counts_30m[i] / HALF_HOUR_HOURS),
412 |                 }
413 |             )
414 |         for i in range(counts_1h.size):
415 |             heatmap_rows.append(
