def binary_segmentation(signal: np.ndarray, max_changepoints: int, min_segment_bins: int) -> list[int]:
    signal = np.asarray(signal, dtype=float)
    if signal.size < (2 * min_segment_bins):
        return []
    candidates: list[int] = []
    segments: list[tuple[int, int]] = [(0, signal.size)]
    while segments and len(candidates) < max_changepoints:
        best_gain = -np.inf
        best_cp = None
        best_idx = None
        for seg_idx, (start, end) in enumerate(segments):
            if end - start < 2 * min_segment_bins:
                continue
            segment = signal[start:end]
            total_sse = float(np.sum((segment - segment.mean()) ** 2))
            for cp in range(start + min_segment_bins, end - min_segment_bins + 1):
                left = signal[start:cp]
                right = signal[cp:end]
                sse_left = float(np.sum((left - left.mean()) ** 2))
                sse_right = float(np.sum((right - right.mean()) ** 2))
                gain = total_sse - (sse_left + sse_right)
                if gain > best_gain:
                    best_gain = gain
                    best_cp = cp
                    best_idx = seg_idx
        if best_cp is None or best_gain <= 0:
            break
        candidates.append(int(best_cp))
        start, end = segments.pop(best_idx)
        segments.extend([(start, best_cp), (best_cp, end)])
    return sorted(set(candidates))
