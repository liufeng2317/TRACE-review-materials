215 | def first_nonzero_bin_center(counts: np.ndarray, edges: np.ndarray) -> float:
216 |     idx = np.flatnonzero(counts > 0)
217 |     if idx.size == 0:
218 |         return np.nan
219 |     return float((edges[idx[0]] + edges[idx[0] + 1]) / 2.0)
220 | 
221 | 
222 | def peak_rate_time(counts: np.ndarray, edges: np.ndarray) -> float:
223 |     if counts.size == 0 or np.all(counts == 0):
224 |         return np.nan
225 |     idx = int(np.argmax(counts))
226 |     return float((edges[idx] + edges[idx + 1]) / 2.0)
