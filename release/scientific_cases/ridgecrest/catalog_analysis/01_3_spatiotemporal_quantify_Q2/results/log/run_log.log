418 |                     "cell_id": cid,
419 |                     "along_km": meta["along_km"],
420 |                     "across_km": meta["across_km"],
421 |                     "resolution": "1h",
422 |                     "bin_start_hours": edges_1h[i],
423 |                     "bin_end_hours": edges_1h[i + 1],
424 |                     "event_count": int(counts_1h[i]),
425 |                     "rate_per_hour": float(counts_1h[i] / ONE_HOUR_HOURS),
426 |                 }
427 |             )
428 |     heatmap_df = pd.DataFrame(heatmap_rows)
