273 | def assign_circle_cell_indices(events: pd.DataFrame, cell_size_km: float, domain: CircleDomain) -> tuple[np.ndarray, np.ndarray]:
274 |     x = events["x_km"].to_numpy()
275 |     y = events["y_km"].to_numpy()
276 |     x_idx = np.floor((x - (domain.center_x_km - domain.radius_km)) / cell_size_km).astype(int)
277 |     y_idx = np.floor((y - (domain.center_y_km - domain.radius_km)) / cell_size_km).astype(int)
278 |     return x_idx, y_idx
