509 |     summary_df = pd.DataFrame(summaries).sort_values("cell_id").reset_index(drop=True)
510 |     cell_df = grid.merge(summary_df.drop(columns=["counts_30m", "counts_1h"]), on="cell_id", how="left")
511 |     lon, lat = inverse_project(inv_transformer, cell_df["x_km"].to_numpy(), cell_df["y_km"].to_numpy())
512 |     cell_df["longitude"] = lon
513 |     cell_df["latitude"] = lat
514 |     cell_df["distance_to_Mw6.4_km"] = np.hypot(cell_df["x_km"] - main64.x_km, cell_df["y_km"] - main64.y_km)
515 |     cell_df["distance_to_Mw7.1_km"] = np.hypot(cell_df["x_km"] - main71.x_km, cell_df["y_km"] - main71.y_km)
516 |     cell_df.insert(0, "domain", domain.name)
