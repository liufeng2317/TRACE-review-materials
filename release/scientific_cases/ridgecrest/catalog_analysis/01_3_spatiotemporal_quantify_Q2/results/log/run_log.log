471 |     log(f"Building neighborhood cell table for {domain.name}...")
472 |     grid = generate_circle_grid(domain, CELL_SIZE_KM)
473 |     if grid.empty:
474 |         raise ValueError(f"{domain.name} neighborhood grid is empty.")
475 |     domain_events = events.loc[events[domain.mask_column] & (events["hours_since_main64"] >= 0.0)].copy()
476 |     if domain_events.empty:
477 |         raise ValueError(f"{domain.name} contains no post-Mw6.4 events.")
478 | 
479 |     edges_30m = build_time_edges(max_hours, HALF_HOUR_HOURS)
