 81 | 
 82 | def build_local_transformer(center_lon: float, center_lat: float) -> tuple[Transformer, CRS]:
 83 |     proj4 = f"+proj=aeqd +lat_0={center_lat} +lon_0={center_lon} +datum=WGS84 +units=m +no_defs"
 84 |     crs_local = CRS.from_proj4(proj4)
 85 |     transformer = Transformer.from_crs("EPSG:4326", crs_local, always_xy=True)
 86 |     return transformer, crs_local
 87 | 
 88 | 
 89 | def project_lonlat(transformer: Transformer, lon: np.ndarray, lat: np.ndarray) -> tuple[np.ndarray, np.ndarray]:
 90 |     x_m, y_m = transformer.transform(lon, lat)
 91 |     return np.asarray(x_m) / 1000.0, np.asarray(y_m) / 1000.0
 92 | 
 93 | 
 94 | def make_corridor(defn: dict, transformer: Transformer) -> Corridor:
 95 |     sx, sy = project_lonlat(transformer, np.array([defn["start_lon"]]), np.array([defn["start_lat"]]))
 96 |     ex, ey = project_lonlat(transformer, np.array([defn["end_lon"]]), np.array([defn["end_lat"]]))
 97 |     sx = float(sx[0])
 98 |     sy = float(sy[0])
 99 |     ex = float(ex[0])
100 |     ey = float(ey[0])
101 |     dx = ex - sx
102 |     dy = ey - sy
103 |     length = float(math.hypot(dx, dy))
104 |     ux = dx / length
105 |     uy = dy / length
106 |     vx = -uy
107 |     vy = ux
108 |     hw = defn["half_width_km"]
109 |     boundary = np.array([
110 |         [sx + vx * hw, sy + vy * hw],
111 |         [ex + vx * hw, ey + vy * hw],
112 |         [ex - vx * hw, ey - vy * hw],
113 |         [sx - vx * hw, sy - vy * hw],
114 |         [sx + vx * hw, sy + vy * hw],
115 |     ])
116 |     return Corridor(
117 |         name=defn["name"],
118 |         strike_deg=defn["strike_deg"],
119 |         half_width_km=hw,
120 |         start_lon=defn["start_lon"],
121 |         start_lat=defn["start_lat"],
122 |         end_lon=defn["end_lon"],
123 |         end_lat=defn["end_lat"],
124 |         start_x_km=sx,
125 |         start_y_km=sy,
126 |         end_x_km=ex,
127 |         end_y_km=ey,
128 |         length_km=length,
129 |         ux=ux,
130 |         uy=uy,
131 |         vx=vx,
132 |         vy=vy,
133 |         boundary_xy=boundary,
134 |     )
135 | 
136 | 
137 | def compute_corridor_coordinates(df: pd.DataFrame, corridor: Corridor) -> pd.DataFrame:
138 |     rx = df["x_km"].to_numpy() - corridor.start_x_km
139 |     ry = df["y_km"].to_numpy() - corridor.start_y_km
140 |     along = rx * corridor.ux + ry * corridor.uy
141 |     across = rx * corridor.vx + ry * corridor.vy
142 |     assigned = (along >= 0.0) & (along <= corridor.length_km) & (np.abs(across) <= corridor.half_width_km)
143 |     return pd.DataFrame(
144 |         {
145 |             f"{corridor.name}_along_km": along,
146 |             f"{corridor.name}_across_km": across,
147 |             f"in_{corridor.name}": assigned,
148 |         },
149 |         index=df.index,
150 |     )
151 | 
152 | 
153 | def magnitude_to_energy_joule(magnitude: pd.Series) -> pd.Series:
154 |     return np.power(10.0, 1.5 * magnitude.astype(float) + 4.8)
