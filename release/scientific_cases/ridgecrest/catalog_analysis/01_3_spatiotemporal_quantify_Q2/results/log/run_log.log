120 | def project_lonlat(transformer: Transformer, lon: np.ndarray, lat: np.ndarray) -> tuple[np.ndarray, np.ndarray]:
121 |     x_m, y_m = transformer.transform(lon, lat)
122 |     return np.asarray(x_m) / 1000.0, np.asarray(y_m) / 1000.0
123 | 
124 | 
125 | def inverse_project(transformer: Transformer, x_km: np.ndarray, y_km: np.ndarray) -> tuple[np.ndarray, np.ndarray]:
126 |     lon, lat = transformer.transform(np.asarray(x_km) * 1000.0, np.asarray(y_km) * 1000.0)
127 |     return np.asarray(lon), np.asarray(lat)
