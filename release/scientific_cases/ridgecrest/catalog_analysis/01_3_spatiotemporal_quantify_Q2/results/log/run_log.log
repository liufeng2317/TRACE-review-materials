481 | 
482 |     x_idx, y_idx = assign_circle_cell_indices(domain_events, CELL_SIZE_KM, domain)
483 |     x_count = int(round((2.0 * domain.radius_km) / CELL_SIZE_KM))
484 |     y_count = x_count
