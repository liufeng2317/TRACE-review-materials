 97 | def robust_normalized_change(signal: np.ndarray) -> np.ndarray:
 98 |     if signal.size < 2:
 99 |         return np.array([], dtype=float)
100 |     diff = np.diff(signal)
101 |     mad = np.median(np.abs(diff - np.median(diff)))
102 |     scale = 1.4826 * mad
103 |     if not np.isfinite(scale) or scale <= 0:
104 |         scale = float(np.std(diff))
105 |     if not np.isfinite(scale) or scale <= 0:
106 |         scale = 1.0
107 |     return diff / scale
108 | 
