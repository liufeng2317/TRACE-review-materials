200 | def build_time_edges(max_hours: float, step_hours: float) -> np.ndarray:
201 |     nbins = int(math.ceil(max_hours / step_hours))
202 |     return np.linspace(0.0, nbins * step_hours, nbins + 1)
203 | 
204 | 
205 | def first_nonzero_bin_center(counts: np.ndarray, edges: np.ndarray) -> float:
206 |     idx = np.flatnonzero(counts > 0)
207 |     if idx.size == 0:
208 |         return np.nan
209 |     return float((edges[idx[0]] + edges[idx[0] + 1]) / 2.0)
210 | 
211 | 
212 | def peak_rate_time(counts: np.ndarray, edges: np.ndarray) -> float:
213 |     if counts.size == 0 or np.all(counts == 0):
214 |         return np.nan
215 |     idx = int(np.argmax(counts))
216 |     return float((edges[idx] + edges[idx + 1]) / 2.0)
217 | 
218 | 
219 | def generate_corridor_grid(corridor: Corridor, cell_size_km: float) -> pd.DataFrame:
220 |     along_centers = np.arange(cell_size_km / 2.0, corridor.length_km, cell_size_km)
221 |     across_centers = np.arange(-corridor.half_width_km + cell_size_km / 2.0, corridor.half_width_km, cell_size_km)
222 |     along_grid, across_grid = np.meshgrid(along_centers, across_centers, indexing="xy")
223 |     along_flat = along_grid.ravel()
224 |     across_flat = across_grid.ravel()
225 |     x = corridor.start_x_km + along_flat * corridor.ux + across_flat * corridor.vx
226 |     y = corridor.start_y_km + along_flat * corridor.uy + across_flat * corridor.vy
227 |     return pd.DataFrame(
228 |         {
229 |             "cell_id": np.arange(along_flat.size, dtype=int),
230 |             "along_km": along_flat,
231 |             "across_km": across_flat,
232 |             "x_km": x,
233 |             "y_km": y,
234 |         }
235 |     )
236 | 
237 | 
238 | def generate_circle_grid(domain: CircleDomain, cell_size_km: float) -> pd.DataFrame:
239 |     x_centers = np.arange(domain.center_x_km - domain.radius_km + cell_size_km / 2.0, domain.center_x_km + domain.radius_km, cell_size_km)
240 |     y_centers = np.arange(domain.center_y_km - domain.radius_km + cell_size_km / 2.0, domain.center_y_km + domain.radius_km, cell_size_km)
241 |     xg, yg = np.meshgrid(x_centers, y_centers, indexing="xy")
242 |     x_flat = xg.ravel()
243 |     y_flat = yg.ravel()
244 |     dist = np.hypot(x_flat - domain.center_x_km, y_flat - domain.center_y_km)
245 |     mask = dist <= domain.radius_km + 1e-9
246 |     return pd.DataFrame(
247 |         {
248 |             "cell_id": np.arange(mask.sum(), dtype=int),
249 |             "x_km": x_flat[mask],
250 |             "y_km": y_flat[mask],
251 |         }
252 |     )
253 | 
