300 | def hours_since(ts: pd.Timestamp | pd.NaT, ref: pd.Timestamp) -> float:
301 |     if pd.isna(ts):
302 |         return float("nan")
303 |     return float((pd.Timestamp(ts) - ref) / pd.Timedelta(hours=1))
