157 | def load_fault_traces() -> list[np.ndarray]:
158 |     with FAULT_PATH.open("r", encoding="utf-8") as f:
159 |         raw = json.load(f)
160 |     traces = []
161 |     for trace in raw:
162 |         arr = np.asarray(trace, dtype=float)
163 |         if arr.ndim == 2 and arr.shape[1] == 2 and arr.shape[0] >= 2:
164 |             traces.append(arr)
165 |     return traces
