306 | def save_dataframe(df: pd.DataFrame, path: Path) -> None:
307 |     if any(pd.api.types.is_datetime64tz_dtype(df[c]) or pd.api.types.is_datetime64_any_dtype(df[c]) for c in df.columns):
308 |         out = df.copy()
309 |         for col in out.columns:
310 |             if pd.api.types.is_datetime64tz_dtype(out[col]) or pd.api.types.is_datetime64_any_dtype(out[col]):
311 |                 out[col] = pd.to_datetime(out[col], utc=True).astype(str)
312 |         out.to_csv(path, index=False)
313 |     else:
