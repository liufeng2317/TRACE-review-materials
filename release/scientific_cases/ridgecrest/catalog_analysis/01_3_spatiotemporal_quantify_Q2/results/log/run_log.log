396 | def build_assignment_summary(df: pd.DataFrame, corridor_a: Corridor, corridor_b: Corridor) -> pd.DataFrame:
397 |     rows = []
398 |     total = len(df)
399 |     overlap_count = int((df["in_Region_A"] & df["in_Region_B"]).sum())
400 |     unassigned_frac = float((~df["in_Region_A"] & ~df["in_Region_B"]).mean())
401 |     for corridor in [corridor_a, corridor_b]:
402 |         mask = df[f"in_{corridor.name}"]
403 |         subset = df.loc[mask]
404 |         across_abs = subset[f"{corridor.name}_across_km"].abs()
405 |         along_vals = subset[f"{corridor.name}_along_km"]
406 |         rows.append(
407 |             {
408 |                 "region": corridor.name,
409 |                 "assigned_event_count": int(mask.sum()),
410 |                 "assigned_fraction": float(mask.mean()),
411 |                 "corridor_overlap_count": overlap_count,
412 |                 "corridor_overlap_fraction": overlap_count / total if total > 0 else np.nan,
413 |                 "unassigned_corridor_fraction": unassigned_frac,
414 |                 "median_abs_across_km": float(across_abs.median()) if len(across_abs) else np.nan,
415 |                 "p95_abs_across_km": float(across_abs.quantile(0.95)) if len(across_abs) else np.nan,
416 |                 "along_min_km": float(along_vals.min()) if len(along_vals) else np.nan,
417 |                 "along_max_km": float(along_vals.max()) if len(along_vals) else np.nan,
418 |                 "centerline_length_km": corridor.length_km,
419 |                 "half_width_km": corridor.half_width_km,
420 |             }
421 |         )
422 |     return pd.DataFrame(rows)
423 | 
