162 | def enrich_mainshocks(metadata: dict, transformer: Transformer) -> tuple[Mainshock, Mainshock]:
163 |     rows = []
164 |     for key, name in [("mainshock64", "Mw6.4"), ("mainshock71", "Mw7.1")]:
165 |         d = metadata[key]
166 |         x, y = project_lonlat(transformer, np.array([d["longitude"]]), np.array([d["latitude"]]))
167 |         rows.append(
168 |             Mainshock(
169 |                 name=name,
170 |                 event_time=pd.Timestamp(d["event_time"]),
171 |                 longitude=float(d["longitude"]),
172 |                 latitude=float(d["latitude"]),
173 |                 x_km=float(x[0]),
174 |                 y_km=float(y[0]),
175 |                 magnitude=float(d["magnitude"]),
176 |             )
177 |         )
178 |     return rows[0], rows[1]
