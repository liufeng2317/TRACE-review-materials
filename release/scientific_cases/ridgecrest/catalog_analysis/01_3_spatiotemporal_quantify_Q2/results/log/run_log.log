 96 | 
 97 | def load_json(path: Path) -> dict:
 98 |     with path.open("r", encoding="utf-8") as f:
 99 |         return json.load(f)
100 | 
101 | 
102 | def build_transformers(local_crs_wkt: str) -> tuple[Transformer, Transformer]:
103 |     local_crs = CRS.from_wkt(local_crs_wkt)
104 |     fwd = Transformer.from_crs("EPSG:4326", local_crs, always_xy=True)
105 |     inv = Transformer.from_crs(local_crs, "EPSG:4326", always_xy=True)
106 |     return fwd, inv
107 | 
108 | 
109 | def project_lonlat(transformer: Transformer, lon: np.ndarray, lat: np.ndarray) -> tuple[np.ndarray, np.ndarray]:
110 |     x_m, y_m = transformer.transform(lon, lat)
111 |     return np.asarray(x_m) / 1000.0, np.asarray(y_m) / 1000.0
112 | 
113 | 
114 | def inverse_project(transformer: Transformer, x_km: np.ndarray, y_km: np.ndarray) -> tuple[np.ndarray, np.ndarray]:
115 |     lon, lat = transformer.transform(np.asarray(x_km) * 1000.0, np.asarray(y_km) * 1000.0)
116 |     return np.asarray(lon), np.asarray(lat)
117 | 
118 | 
119 | def make_corridor(defn: dict, transformer: Transformer, name: str) -> Corridor:
120 |     sx, sy = project_lonlat(transformer, np.array([defn["start_lon"]]), np.array([defn["start_lat"]]))
121 |     ex, ey = project_lonlat(transformer, np.array([defn["end_lon"]]), np.array([defn["end_lat"]]))
122 |     sx = float(sx[0])
123 |     sy = float(sy[0])
124 |     ex = float(ex[0])
125 |     ey = float(ey[0])
126 |     dx = ex - sx
127 |     dy = ey - sy
128 |     length = float(math.hypot(dx, dy))
129 |     ux = dx / length
130 |     uy = dy / length
131 |     vx = -uy
132 |     vy = ux
133 |     hw = float(defn["half_width_km"])
134 |     boundary = np.array([
135 |         [sx + vx * hw, sy + vy * hw],
136 |         [ex + vx * hw, ey + vy * hw],
137 |         [ex - vx * hw, ey - vy * hw],
138 |         [sx - vx * hw, sy - vy * hw],
139 |         [sx + vx * hw, sy + vy * hw],
140 |     ])
141 |     return Corridor(
142 |         name=name,
143 |         half_width_km=hw,
144 |         start_lon=float(defn["start_lon"]),
145 |         start_lat=float(defn["start_lat"]),
146 |         end_lon=float(defn["end_lon"]),
147 |         end_lat=float(defn["end_lat"]),
148 |         start_x_km=sx,
149 |         start_y_km=sy,
150 |         end_x_km=ex,
151 |         end_y_km=ey,
152 |         length_km=length,
153 |         ux=ux,
154 |         uy=uy,
155 |         vx=vx,
156 |         vy=vy,
157 |         boundary_xy=boundary,
158 |     )
159 | 
