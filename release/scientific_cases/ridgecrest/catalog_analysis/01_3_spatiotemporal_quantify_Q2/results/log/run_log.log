112 | def build_local_transformer(center_lon: float, center_lat: float) -> tuple[Transformer, CRS]:
113 |     proj4 = f"+proj=aeqd +lat_0={center_lat} +lon_0={center_lon} +datum=WGS84 +units=m +no_defs"
114 |     crs_local = CRS.from_proj4(proj4)
115 |     transformer = Transformer.from_crs("EPSG:4326", crs_local, always_xy=True)
116 |     return transformer, crs_local
117 | 
118 | 
119 | def project_lonlat(transformer: Transformer, lon: np.ndarray, lat: np.ndarray) -> tuple[np.ndarray, np.ndarray]:
120 |     x_m, y_m = transformer.transform(lon, lat)
121 |     return np.asarray(x_m) / 1000.0, np.asarray(y_m) / 1000.0
122 | 
123 | 
124 | def make_corridor(defn: dict, transformer: Transformer) -> Corridor:
125 |     sx, sy = project_lonlat(transformer, np.array([defn["start_lon"]]), np.array([defn["start_lat"]]))
126 |     ex, ey = project_lonlat(transformer, np.array([defn["end_lon"]]), np.array([defn["end_lat"]]))
127 |     sx = float(sx[0])
128 |     sy = float(sy[0])
129 |     ex = float(ex[0])
130 |     ey = float(ey[0])
131 |     dx = ex - sx
132 |     dy = ey - sy
133 |     length = float(math.hypot(dx, dy))
134 |     ux = dx / length
135 |     uy = dy / length
136 |     vx = -uy
137 |     vy = ux
138 |     hw = defn["half_width_km"]
139 |     boundary = np.array([
140 |         [sx + vx * hw, sy + vy * hw],
141 |         [ex + vx * hw, ey + vy * hw],
142 |         [ex - vx * hw, ey - vy * hw],
143 |         [sx - vx * hw, sy - vy * hw],
144 |         [sx + vx * hw, sy + vy * hw],
145 |     ])
146 |     return Corridor(
147 |         name=defn["name"],
148 |         strike_deg=defn["strike_deg"],
149 |         half_width_km=hw,
150 |         start_lon=defn["start_lon"],
151 |         start_lat=defn["start_lat"],
152 |         end_lon=defn["end_lon"],
153 |         end_lat=defn["end_lat"],
154 |         start_x_km=sx,
155 |         start_y_km=sy,
156 |         end_x_km=ex,
157 |         end_y_km=ey,
158 |         length_km=length,
