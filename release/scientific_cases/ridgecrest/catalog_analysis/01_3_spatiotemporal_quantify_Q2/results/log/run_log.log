270 | def summarize_group(
271 |     cell_id: int,
272 |     idx: np.ndarray,
273 |     event_hours: np.ndarray,
274 |     event_energy: np.ndarray,
275 |     edges_30m: np.ndarray,
276 |     edges_1h: np.ndarray,
277 | ) -> dict:
278 |     if idx.size == 0:
279 |         return {
280 |             "cell_id": cell_id,
281 |             "event_count": 0,
282 |             "cumulative_energy": 0.0,
283 |             "first_activation_hours": np.nan,
284 |             "peak_rate_time_30m_hours": np.nan,
285 |             "peak_rate_time_1h_hours": np.nan,
286 |             "first_nonzero_bin_30m_hours": np.nan,
287 |             "first_nonzero_bin_1h_hours": np.nan,
288 |             "counts_30m": np.zeros(edges_30m.size - 1, dtype=int),
289 |             "counts_1h": np.zeros(edges_1h.size - 1, dtype=int),
290 |         }
291 |     hours = event_hours[idx]
292 |     energy = event_energy[idx]
293 |     counts_30m, _ = np.histogram(hours, bins=edges_30m)
294 |     counts_1h, _ = np.histogram(hours, bins=edges_1h)
295 |     return {
296 |         "cell_id": cell_id,
297 |         "event_count": int(idx.size),
298 |         "cumulative_energy": float(np.sum(energy)),
299 |         "first_activation_hours": float(np.nanmin(hours)),
300 |         "peak_rate_time_30m_hours": peak_rate_time(counts_30m, edges_30m),
301 |         "peak_rate_time_1h_hours": peak_rate_time(counts_1h, edges_1h),
302 |         "first_nonzero_bin_30m_hours": first_nonzero_bin_center(counts_30m, edges_30m),
303 |         "first_nonzero_bin_1h_hours": first_nonzero_bin_center(counts_1h, edges_1h),
304 |         "counts_30m": counts_30m,
305 |         "counts_1h": counts_1h,
306 |     }
307 | 
308 | 
309 | def parallel_group_summaries(
310 |     group_map: dict[int, np.ndarray],
311 |     event_hours: np.ndarray,
312 |     event_energy: np.ndarray,
313 |     edges_30m: np.ndarray,
314 |     edges_1h: np.ndarray,
315 |     n_jobs: int,
316 | ) -> list[dict]:
317 |     ordered = sorted(group_map.items(), key=lambda kv: kv[0])
318 |     return Parallel(n_jobs=n_jobs, prefer="processes", verbose=10)(
319 |         delayed(summarize_group)(cell_id, idx, event_hours, event_energy, edges_30m, edges_1h)
320 |         for cell_id, idx in ordered
321 |     )
322 | 
323 | 
324 | def build_group_map(cell_ids: np.ndarray, total_cells: int) -> dict[int, np.ndarray]:
325 |     mapping = {cid: np.empty(0, dtype=int) for cid in range(total_cells)}
326 |     if cell_ids.size == 0:
327 |         return mapping
328 |     order = np.argsort(cell_ids)
329 |     sorted_ids = cell_ids[order]
330 |     unique_ids, starts = np.unique(sorted_ids, return_index=True)
331 |     starts = np.append(starts, sorted_ids.size)
332 |     for uid, s0, s1 in zip(unique_ids, starts[:-1], starts[1:]):
333 |         mapping[int(uid)] = order[s0:s1]
334 |     return mapping
335 | 
