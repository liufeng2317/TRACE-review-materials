390 |     cell_df["distance_to_Mw7.1_km"] = np.hypot(cell_df["x_km"] - main71.x_km, cell_df["y_km"] - main71.y_km)
391 |     cell_df.insert(0, "region", region_name)
392 | 
393 |     grid_lookup = grid.set_index("cell_id")[["along_km", "across_km"]]
394 |     heatmap_rows = []
395 |     for s in summaries:
396 |         cid = int(s["cell_id"])
397 |         meta = grid_lookup.loc[cid]
