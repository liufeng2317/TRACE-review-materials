229 | def generate_corridor_grid(corridor: Corridor, cell_size_km: float) -> pd.DataFrame:
230 |     along_centers = np.arange(cell_size_km / 2.0, corridor.length_km, cell_size_km)
231 |     across_centers = np.arange(-corridor.half_width_km + cell_size_km / 2.0, corridor.half_width_km, cell_size_km)
232 |     along_grid, across_grid = np.meshgrid(along_centers, across_centers, indexing="xy")
233 |     along_flat = along_grid.ravel()
234 |     across_flat = across_grid.ravel()
235 |     x = corridor.start_x_km + along_flat * corridor.ux + across_flat * corridor.vx
236 |     y = corridor.start_y_km + along_flat * corridor.uy + across_flat * corridor.vy
237 |     return pd.DataFrame(
238 |         {
239 |             "cell_id": np.arange(along_flat.size, dtype=int),
240 |             "along_km": along_flat,
241 |             "across_km": across_flat,
242 |             "x_km": x,
243 |             "y_km": y,
244 |         }
245 |     )
246 | 
247 | 
248 | def generate_circle_grid(domain: CircleDomain, cell_size_km: float) -> pd.DataFrame:
249 |     x_centers = np.arange(domain.center_x_km - domain.radius_km + cell_size_km / 2.0, domain.center_x_km + domain.radius_km, cell_size_km)
250 |     y_centers = np.arange(domain.center_y_km - domain.radius_km + cell_size_km / 2.0, domain.center_y_km + domain.radius_km, cell_size_km)
251 |     xg, yg = np.meshgrid(x_centers, y_centers, indexing="xy")
252 |     x_flat = xg.ravel()
253 |     y_flat = yg.ravel()
254 |     dist = np.hypot(x_flat - domain.center_x_km, y_flat - domain.center_y_km)
255 |     mask = dist <= domain.radius_km + 1e-9
256 |     return pd.DataFrame(
257 |         {
258 |             "cell_id": np.arange(mask.sum(), dtype=int),
259 |             "x_km": x_flat[mask],
260 |             "y_km": y_flat[mask],
261 |         }
262 |     )
