 49 | class Corridor:
 50 |     name: str
 51 |     strike_deg: float
 52 |     half_width_km: float
 53 |     start_lon: float
 54 |     start_lat: float
 55 |     end_lon: float
 56 |     end_lat: float
 57 |     start_x_km: float
 58 |     start_y_km: float
 59 |     end_x_km: float
 60 |     end_y_km: float
 61 |     length_km: float
 62 |     ux: float
