183 | def first_sustained_activity_time(post_df: pd.DataFrame) -> pd.Timestamp | pd.NaT:
184 |     positive = (post_df["count"] > 0).to_numpy(dtype=bool)
185 |     if positive.size < SUSTAINED_ACTIVITY_CONSECUTIVE_BINS:
186 |         return pd.NaT
