172 |             "cp_start_time": cp_start_time,
173 |             "cp_center_time": cp_center_time,
174 |             "hours_since_main64": float((cp_center_time - main64_time) / pd.Timedelta(hours=1)),
175 |             "support_score": float(support),
176 |             "pre_level": float(pre.mean()),
177 |             "post_level": float(post.mean()),
178 |             "delta_level": delta,
179 |         })
180 |     return pd.DataFrame.from_records(records)
