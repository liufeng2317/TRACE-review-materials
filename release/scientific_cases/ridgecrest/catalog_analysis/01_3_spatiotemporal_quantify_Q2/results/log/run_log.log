199 | def build_time_edges(max_hours: float, step_hours: float) -> np.ndarray:
200 |     nbins = int(math.ceil(max_hours / step_hours))
201 |     return np.linspace(0.0, nbins * step_hours, nbins + 1)
202 | 
203 | 
204 | def first_nonzero_bin_center(counts: np.ndarray, edges: np.ndarray) -> float:
205 |     idx = np.flatnonzero(counts > 0)
206 |     if idx.size == 0:
207 |         return np.nan
208 |     return float((edges[idx[0]] + edges[idx[0] + 1]) / 2.0)
209 | 
210 | 
211 | def peak_rate_time(counts: np.ndarray, edges: np.ndarray) -> float:
212 |     if counts.size == 0 or np.all(counts == 0):
213 |         return np.nan
214 |     idx = int(np.argmax(counts))
215 |     return float((edges[idx] + edges[idx + 1]) / 2.0)
216 | 
217 | 
218 | def generate_corridor_grid(corridor: Corridor, cell_size_km: float) -> pd.DataFrame:
219 |     along_centers = np.arange(cell_size_km / 2.0, corridor.length_km, cell_size_km)
220 |     across_centers = np.arange(-corridor.half_width_km + cell_size_km / 2.0, corridor.half_width_km, cell_size_km)
221 |     along_grid, across_grid = np.meshgrid(along_centers, across_centers, indexing="xy")
222 |     along_flat = along_grid.ravel()
223 |     across_flat = across_grid.ravel()
224 |     x = corridor.start_x_km + along_flat * corridor.ux + across_flat * corridor.vx
225 |     y = corridor.start_y_km + along_flat * corridor.uy + across_flat * corridor.vy
226 |     return pd.DataFrame(
227 |         {
228 |             "cell_id": np.arange(along_flat.size, dtype=int),
229 |             "along_km": along_flat,
230 |             "across_km": across_flat,
231 |             "x_km": x,
232 |             "y_km": y,
233 |         }
234 |     )
235 | 
236 | 
237 | def generate_circle_grid(domain: CircleDomain, cell_size_km: float) -> pd.DataFrame:
238 |     x_centers = np.arange(domain.center_x_km - domain.radius_km + cell_size_km / 2.0, domain.center_x_km + domain.radius_km, cell_size_km)
239 |     y_centers = np.arange(domain.center_y_km - domain.radius_km + cell_size_km / 2.0, domain.center_y_km + domain.radius_km, cell_size_km)
240 |     xg, yg = np.meshgrid(x_centers, y_centers, indexing="xy")
241 |     x_flat = xg.ravel()
242 |     y_flat = yg.ravel()
243 |     dist = np.hypot(x_flat - domain.center_x_km, y_flat - domain.center_y_km)
244 |     mask = dist <= domain.radius_km + 1e-9
245 |     return pd.DataFrame(
246 |         {
247 |             "cell_id": np.arange(mask.sum(), dtype=int),
248 |             "x_km": x_flat[mask],
249 |             "y_km": y_flat[mask],
250 |         }
251 |     )
252 | 
253 | 
254 | def assign_corridor_cell_indices(events: pd.DataFrame, cell_size_km: float, corridor: Corridor) -> tuple[np.ndarray, np.ndarray]:
255 |     along = events[f"{corridor.name}_along_km"].to_numpy()
256 |     across = events[f"{corridor.name}_across_km"].to_numpy()
257 |     along_idx = np.floor(along / cell_size_km).astype(int)
258 |     across_idx = np.floor((across + corridor.half_width_km) / cell_size_km).astype(int)
259 |     return along_idx, across_idx
260 | 
261 | 
262 | def assign_circle_cell_indices(events: pd.DataFrame, cell_size_km: float, domain: CircleDomain) -> tuple[np.ndarray, np.ndarray]:
263 |     x = events["x_km"].to_numpy()
264 |     y = events["y_km"].to_numpy()
265 |     x_idx = np.floor((x - (domain.center_x_km - domain.radius_km)) / cell_size_km).astype(int)
266 |     y_idx = np.floor((y - (domain.center_y_km - domain.radius_km)) / cell_size_km).astype(int)
267 |     return x_idx, y_idx
268 | 
