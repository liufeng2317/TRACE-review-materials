130 | def make_corridor(defn: dict, transformer: Transformer, name: str) -> Corridor:
131 |     sx, sy = project_lonlat(transformer, np.array([defn["start_lon"]]), np.array([defn["start_lat"]]))
132 |     ex, ey = project_lonlat(transformer, np.array([defn["end_lon"]]), np.array([defn["end_lat"]]))
133 |     sx = float(sx[0])
134 |     sy = float(sy[0])
135 |     ex = float(ex[0])
136 |     ey = float(ey[0])
137 |     dx = ex - sx
138 |     dy = ey - sy
139 |     length = float(math.hypot(dx, dy))
140 |     ux = dx / length
141 |     uy = dy / length
142 |     vx = -uy
143 |     vy = ux
144 |     hw = float(defn["half_width_km"])
145 |     boundary = np.array([
146 |         [sx + vx * hw, sy + vy * hw],
147 |         [ex + vx * hw, ey + vy * hw],
148 |         [ex - vx * hw, ey - vy * hw],
149 |         [sx - vx * hw, sy - vy * hw],
150 |         [sx + vx * hw, sy + vy * hw],
151 |     ])
152 |     return Corridor(
153 |         name=name,
154 |         half_width_km=hw,
155 |         start_lon=float(defn["start_lon"]),
156 |         start_lat=float(defn["start_lat"]),
157 |         end_lon=float(defn["end_lon"]),
158 |         end_lat=float(defn["end_lat"]),
159 |         start_x_km=sx,
160 |         start_y_km=sy,
161 |         end_x_km=ex,
162 |         end_y_km=ey,
163 |         length_km=length,
164 |         ux=ux,
165 |         uy=uy,
166 |         vx=vx,
167 |         vy=vy,
168 |         boundary_xy=boundary,
169 |     )
