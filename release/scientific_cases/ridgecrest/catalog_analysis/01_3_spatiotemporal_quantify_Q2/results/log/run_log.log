102 | 
103 | def build_transformers(local_crs_wkt: str) -> tuple[Transformer, Transformer]:
104 |     local_crs = CRS.from_wkt(local_crs_wkt)
105 |     fwd = Transformer.from_crs("EPSG:4326", local_crs, always_xy=True)
106 |     inv = Transformer.from_crs(local_crs, "EPSG:4326", always_xy=True)
107 |     return fwd, inv
108 | 
109 | 
110 | def project_lonlat(transformer: Transformer, lon: np.ndarray, lat: np.ndarray) -> tuple[np.ndarray, np.ndarray]:
111 |     x_m, y_m = transformer.transform(lon, lat)
112 |     return np.asarray(x_m) / 1000.0, np.asarray(y_m) / 1000.0
113 | 
114 | 
115 | def inverse_project(transformer: Transformer, x_km: np.ndarray, y_km: np.ndarray) -> tuple[np.ndarray, np.ndarray]:
116 |     lon, lat = transformer.transform(np.asarray(x_km) * 1000.0, np.asarray(y_km) * 1000.0)
117 |     return np.asarray(lon), np.asarray(lat)
118 | 
119 | 
120 | def make_corridor(defn: dict, transformer: Transformer, name: str) -> Corridor:
121 |     sx, sy = project_lonlat(transformer, np.array([defn["start_lon"]]), np.array([defn["start_lat"]]))
122 |     ex, ey = project_lonlat(transformer, np.array([defn["end_lon"]]), np.array([defn["end_lat"]]))
123 |     sx = float(sx[0])
124 |     sy = float(sy[0])
125 |     ex = float(ex[0])
126 |     ey = float(ey[0])
127 |     dx = ex - sx
128 |     dy = ey - sy
129 |     length = float(math.hypot(dx, dy))
130 |     ux = dx / length
131 |     uy = dy / length
132 |     vx = -uy
133 |     vy = ux
134 |     hw = float(defn["half_width_km"])
135 |     boundary = np.array([
136 |         [sx + vx * hw, sy + vy * hw],
137 |         [ex + vx * hw, ey + vy * hw],
138 |         [ex - vx * hw, ey - vy * hw],
139 |         [sx - vx * hw, sy - vy * hw],
140 |         [sx + vx * hw, sy + vy * hw],
141 |     ])
142 |     return Corridor(
143 |         name=name,
144 |         half_width_km=hw,
145 |         start_lon=float(defn["start_lon"]),
146 |         start_lat=float(defn["start_lat"]),
147 |         end_lon=float(defn["end_lon"]),
148 |         end_lat=float(defn["end_lat"]),
149 |         start_x_km=sx,
150 |         start_y_km=sy,
151 |         end_x_km=ex,
152 |         end_y_km=ey,
153 |         length_km=length,
154 |         ux=ux,
155 |         uy=uy,
156 |         vx=vx,
157 |         vy=vy,
158 |         boundary_xy=boundary,
159 |     )
160 | 
