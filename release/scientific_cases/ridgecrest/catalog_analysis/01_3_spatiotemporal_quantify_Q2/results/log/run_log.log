265 | def assign_corridor_cell_indices(events: pd.DataFrame, cell_size_km: float, corridor: Corridor) -> tuple[np.ndarray, np.ndarray]:
266 |     along = events[f"{corridor.name}_along_km"].to_numpy()
267 |     across = events[f"{corridor.name}_across_km"].to_numpy()
268 |     along_idx = np.floor(along / cell_size_km).astype(int)
269 |     across_idx = np.floor((across + corridor.half_width_km) / cell_size_km).astype(int)
270 |     return along_idx, across_idx
