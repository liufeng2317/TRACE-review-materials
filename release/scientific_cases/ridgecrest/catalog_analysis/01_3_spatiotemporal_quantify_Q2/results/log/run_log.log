167 | def compute_corridor_coordinates(df: pd.DataFrame, corridor: Corridor) -> pd.DataFrame:
168 |     rx = df["x_km"].to_numpy() - corridor.start_x_km
169 |     ry = df["y_km"].to_numpy() - corridor.start_y_km
170 |     along = rx * corridor.ux + ry * corridor.uy
171 |     across = rx * corridor.vx + ry * corridor.vy
172 |     assigned = (along >= 0.0) & (along <= corridor.length_km) & (np.abs(across) <= corridor.half_width_km)
173 |     return pd.DataFrame(
174 |         {
175 |             f"{corridor.name}_along_km": along,
176 |             f"{corridor.name}_across_km": across,
177 |             f"in_{corridor.name}": assigned,
178 |         },
179 |         index=df.index,
