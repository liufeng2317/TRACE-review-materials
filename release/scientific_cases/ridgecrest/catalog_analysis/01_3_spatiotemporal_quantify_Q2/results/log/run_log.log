143 | def changepoint_table_for_series(
144 |     series_df: pd.DataFrame,
145 |     value_col: str,
146 |     domain: str,
147 |     resolution: str,
148 |     main64_time: pd.Timestamp,
149 | ) -> pd.DataFrame:
150 |     values = series_df[value_col].to_numpy(dtype=float)
151 |     if values.size < (2 * CHANGEPOINT_MIN_SEGMENT_BINS):
152 |         return pd.DataFrame(columns=[
153 |             "domain", "resolution", "observable", "cp_index", "cp_start_time", "cp_center_time",
154 |             "hours_since_main64", "support_score", "pre_level", "post_level", "delta_level",
155 |         ])
156 |     cps = binary_segmentation(values, MAX_CHANGEPOINTS, CHANGEPOINT_MIN_SEGMENT_BINS)
157 |     records = []
158 |     for cp in cps:
159 |         pre = values[:cp]
160 |         post = values[cp:]
161 |         delta = float(post.mean() - pre.mean())
162 |         pooled = np.concatenate([pre, post])
163 |         pooled_std = float(np.std(pooled))
164 |         support = delta / (pooled_std if pooled_std > 0 else 1.0)
165 |         cp_start_time = pd.Timestamp(series_df.iloc[cp]["bin_start"])
166 |         cp_center_time = pd.Timestamp(series_df.iloc[cp]["bin_center"])
167 |         records.append({
