110 | def binary_segmentation(signal: np.ndarray, max_changepoints: int, min_segment_bins: int) -> list[int]:
111 |     signal = np.asarray(signal, dtype=float)
112 |     if signal.size < (2 * min_segment_bins):
113 |         return []
114 |     candidates: list[int] = []
115 |     segments: list[tuple[int, int]] = [(0, signal.size)]
116 |     while segments and len(candidates) < max_changepoints:
117 |         best_gain = -np.inf
118 |         best_cp = None
119 |         best_idx = None
120 |         for seg_idx, (start, end) in enumerate(segments):
121 |             if end - start < 2 * min_segment_bins:
122 |                 continue
123 |             segment = signal[start:end]
124 |             total_sse = float(np.sum((segment - segment.mean()) ** 2))
125 |             for cp in range(start + min_segment_bins, end - min_segment_bins + 1):
126 |                 left = signal[start:cp]
127 |                 right = signal[cp:end]
128 |                 sse_left = float(np.sum((left - left.mean()) ** 2))
129 |                 sse_right = float(np.sum((right - right.mean()) ** 2))
130 |                 gain = total_sse - (sse_left + sse_right)
131 |                 if gain > best_gain:
132 |                     best_gain = gain
133 |                     best_cp = cp
134 |                     best_idx = seg_idx
135 |         if best_cp is None or best_gain <= 0:
136 |             break
137 |         candidates.append(int(best_cp))
138 |         start, end = segments.pop(best_idx)
139 |         segments.extend([(start, best_cp), (best_cp, end)])
140 |     return sorted(set(candidates))
