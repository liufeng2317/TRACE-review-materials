113 | def build_transformers(local_crs_wkt: str) -> tuple[Transformer, Transformer]:
114 |     local_crs = CRS.from_wkt(local_crs_wkt)
115 |     fwd = Transformer.from_crs("EPSG:4326", local_crs, always_xy=True)
116 |     inv = Transformer.from_crs(local_crs, "EPSG:4326", always_xy=True)
117 |     return fwd, inv
