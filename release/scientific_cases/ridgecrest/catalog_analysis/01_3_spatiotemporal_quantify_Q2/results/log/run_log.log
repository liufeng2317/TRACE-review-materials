 73 | def reset_output_dir(output_dir: Path) -> None:
 74 |     if output_dir.exists():
 75 |         shutil.rmtree(output_dir)
 76 |     output_dir.mkdir(parents=True, exist_ok=True)
 77 |     (output_dir / "figures").mkdir(exist_ok=True)
