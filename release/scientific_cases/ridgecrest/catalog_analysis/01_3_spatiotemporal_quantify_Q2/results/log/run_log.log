197 | def build_domain_series(args: tuple[str, str, pd.Timedelta, pd.DataFrame, pd.Timestamp, pd.Timestamp]) -> tuple[pd.DataFrame, pd.DataFrame, dict]:
198 |     domain, mask_col, delta, df, main64_time, main71_time = args
199 |     domain_df = df.loc[df[mask_col].astype(bool)].copy()
200 |     start_time = pd.Timestamp(df["event_time"].min()).floor("30min")
201 |     end_time = pd.Timestamp(main71_time).ceil("30min")
202 |     edges = pd.date_range(start=start_time, end=end_time, freq=delta)
203 |     if edges[-1] < main71_time:
204 |         edges = edges.append(pd.DatetimeIndex([edges[-1] + delta]))
205 |     if len(edges) < 2:
206 |         raise ValueError(f"Insufficient time-bin edges for {domain} at {delta}.")
207 |     bin_start = edges[:-1]
208 |     bin_end = edges[1:]
209 |     bin_center = bin_start + (delta / 2)
210 |     interval_hours = delta / pd.Timedelta(hours=1)
211 |     counts = np.zeros(len(bin_start), dtype=int)
212 |     energy = np.zeros(len(bin_start), dtype=float)
213 |     if not domain_df.empty:
214 |         idx = np.searchsorted(edges.to_numpy(), domain_df["event_time"].to_numpy(), side="right") - 1
215 |         valid = (idx >= 0) & (idx < len(counts))
216 |         idx = idx[valid]
217 |         np.add.at(counts, idx, 1)
218 |         np.add.at(energy, idx, domain_df.loc[valid, "energy_joule"].to_numpy(dtype=float))
219 |     rate = counts.astype(float) / interval_hours
220 |     cumulative_count = np.cumsum(counts)
221 |     cumulative_energy = np.cumsum(energy)
222 |     post_mask = bin_end > main64_time
223 |     post_counts = counts[post_mask]
224 |     post_energy = energy[post_mask]
225 |     post_cum_count = np.cumsum(post_counts)
226 |     post_cum_energy = np.cumsum(post_energy)
227 |     total_post_count = int(post_counts.sum())
228 |     total_post_energy = float(post_energy.sum())
229 |     norm_count = np.full(len(counts), np.nan)
230 |     norm_energy = np.full(len(counts), np.nan)
231 |     if total_post_count > 0:
232 |         norm_count[post_mask] = post_cum_count / total_post_count
233 |     if total_post_energy > 0:
234 |         norm_energy[post_mask] = post_cum_energy / total_post_energy
235 |     series_df = pd.DataFrame({
236 |         "domain": domain,
237 |         "resolution": resolution_label(delta),
238 |         "bin_start": bin_start,
239 |         "bin_end": bin_end,
240 |         "bin_center": bin_center,
241 |         "hours_since_main64_bin_center": ((bin_center - main64_time) / pd.Timedelta(hours=1)).astype(float),
242 |         "count": counts,
243 |         "rate_per_hour": rate,
244 |         "energy_joule": energy,
245 |         "cumulative_count": cumulative_count,
246 |         "cumulative_energy_joule": cumulative_energy,
247 |         "normalized_cumulative_count_fraction": norm_count,
248 |         "normalized_cumulative_energy_fraction": norm_energy,
249 |         "rate_change_per_hour": np.r_[np.nan, np.diff(rate)],
250 |         "energy_change_joule": np.r_[np.nan, np.diff(energy)],
251 |         "rate_change_z": np.r_[np.nan, robust_normalized_change(rate)],
252 |         "energy_change_z": np.r_[np.nan, robust_normalized_change(energy)],
253 |     })
254 |     cp_rate = changepoint_table_for_series(series_df, "rate_per_hour", domain, resolution_label(delta), main64_time)
255 |     cp_energy = changepoint_table_for_series(series_df, "energy_joule", domain, resolution_label(delta), main64_time)
256 |     cp_df = pd.concat([cp_rate, cp_energy], ignore_index=True)
257 |     first_event_time = pd.NaT
258 |     if not domain_df.empty:
259 |         post_event_times = domain_df.loc[domain_df["event_time"] >= main64_time, "event_time"]
260 |         if not post_event_times.empty:
261 |             first_event_time = pd.Timestamp(post_event_times.min())
262 |     post_series = series_df.loc[series_df["bin_end"] > main64_time].reset_index(drop=True)
263 |     sustained_time = first_sustained_activity_time(post_series)
264 |     strongest_rate_time = strongest_positive_cp_time(cp_rate.loc[cp_rate["cp_center_time"] >= main64_time])
265 |     peak_rate_time = pd.NaT
266 |     if not post_series.empty and post_series["rate_per_hour"].max() > 0:
267 |         peak_rate_time = pd.Timestamp(post_series.iloc[post_series["rate_per_hour"].to_numpy().argmax()]["bin_center"])
268 |     strongest_energy_time = strongest_positive_cp_time(cp_energy.loc[cp_energy["cp_center_time"] >= main64_time])
269 |     peak_energy_time = pd.NaT
270 |     if not post_series.empty and post_series["energy_joule"].max() > 0:
271 |         peak_energy_time = pd.Timestamp(post_series.iloc[post_series["energy_joule"].to_numpy().argmax()]["bin_center"])
272 |     summary = {
273 |         "domain": domain,
274 |         "resolution": resolution_label(delta),
275 |         "post_main64_event_count": total_post_count,
276 |         "post_main64_cumulative_energy_joule": total_post_energy,
277 |         "first_event_time": first_event_time,
278 |         "first_event_hours_since_main64": hours_since(first_event_time, main64_time),
279 |         "first_sustained_activity_time": sustained_time,
280 |         "first_sustained_activity_hours_since_main64": hours_since(sustained_time, main64_time),
281 |         "strongest_rate_change_time": strongest_rate_time,
282 |         "strongest_rate_change_hours_since_main64": hours_since(strongest_rate_time, main64_time),
283 |         "peak_rate_time": peak_rate_time,
284 |         "peak_rate_hours_since_main64": hours_since(peak_rate_time, main64_time),
285 |         "strongest_energy_change_time": strongest_energy_time,
286 |         "strongest_energy_change_hours_since_main64": hours_since(strongest_energy_time, main64_time),
287 |         "peak_energy_time": peak_energy_time,
288 |         "peak_energy_hours_since_main64": hours_since(peak_energy_time, main64_time),
289 |     }
290 |     return series_df, cp_df, summary
291 | 
