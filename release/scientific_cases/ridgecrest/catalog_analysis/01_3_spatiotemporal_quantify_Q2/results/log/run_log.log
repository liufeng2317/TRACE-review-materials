486 |     domain_events = domain_events.loc[valid].copy()
487 |     x_idx = x_idx[valid]
488 |     y_idx = y_idx[valid]
489 | 
490 |     center_lookup = {
491 |         (int(np.floor((x - (domain.center_x_km - domain.radius_km)) / CELL_SIZE_KM)), int(np.floor((y - (domain.center_y_km - domain.radius_km)) / CELL_SIZE_KM))): cid
492 |         for cid, x, y in grid[["cell_id", "x_km", "y_km"]].itertuples(index=False)
493 |     }
494 |     cell_ids = np.array([center_lookup.get((ix, iy), -1) for ix, iy in zip(x_idx, y_idx)], dtype=int)
495 |     valid_ids = cell_ids >= 0
496 |     domain_events = domain_events.loc[valid_ids].copy()
497 |     cell_ids = cell_ids[valid_ids]
498 |     domain_events["cell_id"] = cell_ids
