121 |                 sse_left = float(np.sum((left - left.mean()) ** 2))
122 |                 sse_right = float(np.sum((right - right.mean()) ** 2))
123 |                 gain = total_sse - (sse_left + sse_right)
124 |                 if gain > best_gain:
125 |                     best_gain = gain
126 |                     best_cp = cp
127 |                     best_idx = seg_idx
128 |         if best_cp is None or best_gain <= 0:
129 |             break
130 |         candidates.append(int(best_cp))
131 |         start, end = segments.pop(best_idx)
132 |         segments.extend([(start, best_cp), (best_cp, end)])
133 |     return sorted(set(candidates))
134 | 
135 | 
136 | def changepoint_table_for_series(
137 |     series_df: pd.DataFrame,
138 |     value_col: str,
139 |     domain: str,
140 |     resolution: str,
141 |     main64_time: pd.Timestamp,
142 | ) -> pd.DataFrame:
143 |     values = series_df[value_col].to_numpy(dtype=float)
144 |     if values.size < (2 * CHANGEPOINT_MIN_SEGMENT_BINS):
145 |         return pd.DataFrame(columns=[
146 |             "domain", "resolution", "observable", "cp_index", "cp_start_time", "cp_center_time",
147 |             "hours_since_main64", "support_score", "pre_level", "post_level", "delta_level",
148 |         ])
149 |     cps = binary_segmentation(values, MAX_CHANGEPOINTS, CHANGEPOINT_MIN_SEGMENT_BINS)
150 |     records = []
151 |     for cp in cps:
152 |         pre = values[:cp]
153 |         post = values[cp:]
154 |         delta = float(post.mean() - pre.mean())
155 |         pooled = np.concatenate([pre, post])
156 |         pooled_std = float(np.std(pooled))
157 |         support = delta / (pooled_std if pooled_std > 0 else 1.0)
158 |         cp_start_time = pd.Timestamp(series_df.iloc[cp]["bin_start"])
159 |         cp_center_time = pd.Timestamp(series_df.iloc[cp]["bin_center"])
160 |         records.append({
161 |             "domain": domain,
162 |             "resolution": resolution,
163 |             "observable": value_col,
164 |             "cp_index": int(cp),
165 |             "cp_start_time": cp_start_time,
166 |             "cp_center_time": cp_center_time,
167 |             "hours_since_main64": float((cp_center_time - main64_time) / pd.Timedelta(hours=1)),
168 |             "support_score": float(support),
169 |             "pre_level": float(pre.mean()),
170 |             "post_level": float(post.mean()),
171 |             "delta_level": delta,
172 |         })
173 |     return pd.DataFrame.from_records(records)
174 | 
175 | 
176 | def first_sustained_activity_time(post_df: pd.DataFrame) -> pd.Timestamp | pd.NaT:
177 |     positive = (post_df["count"] > 0).to_numpy(dtype=bool)
178 |     if positive.size < SUSTAINED_ACTIVITY_CONSECUTIVE_BINS:
179 |         return pd.NaT
180 |     streak = np.convolve(positive.astype(int), np.ones(SUSTAINED_ACTIVITY_CONSECUTIVE_BINS, dtype=int), mode="valid")
181 |     idxs = np.where(streak >= SUSTAINED_ACTIVITY_CONSECUTIVE_BINS)[0]
182 |     if idxs.size == 0:
183 |         return pd.NaT
184 |     return pd.Timestamp(post_df.iloc[int(idxs[0])]["bin_start"])
185 | 
186 | 
187 | def strongest_positive_cp_time(cp_df: pd.DataFrame) -> pd.Timestamp | pd.NaT:
188 |     if cp_df.empty:
189 |         return pd.NaT
190 |     positive = cp_df.loc[cp_df["delta_level"] > 0].copy()
191 |     if positive.empty:
192 |         return pd.NaT
193 |     row = positive.iloc[positive["support_score"].to_numpy(dtype=float).argmax()]
194 |     return pd.Timestamp(row["cp_center_time"])
195 | 
