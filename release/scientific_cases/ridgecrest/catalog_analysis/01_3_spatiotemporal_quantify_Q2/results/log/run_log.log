370 | def main() -> None:
371 |     try:
372 |         log(f"Preparing output directory: {OUTPUT_DIR}")
373 |         reset_output_dir(OUTPUT_DIR)
374 | 
375 |         log(f"Loading catalog: {CATALOG_PATH}")
376 |         catalog = pd.read_csv(CATALOG_PATH, parse_dates=["event_time"])
377 |         log(f"Loaded {len(catalog):,} catalog events")
378 | 
379 |         log(f"Loading mainshocks: {MAINSHOCK_PATH}")
380 |         mainshocks = pd.read_csv(MAINSHOCK_PATH, parse_dates=["event_time"])
381 |         main64, main71 = select_mainshocks(mainshocks)
382 |         log(f"Mw 6.4 event time: {main64['event_time']}")
383 |         log(f"Mw 7.1 event time: {main71['event_time']}")
384 | 
385 |         catalog = catalog.sort_values("event_time").reset_index(drop=True)
386 |         catalog = catalog.loc[catalog["event_time"] <= main71["event_time"]].copy()
387 |         log(f"Catalog truncated to pre-Mw7.1 window: {len(catalog):,} events")
388 | 
389 |         center_lon = float(np.r_[catalog["longitude"].to_numpy(), mainshocks["longitude"].to_numpy()].mean())
390 |         center_lat = float(np.r_[catalog["latitude"].to_numpy(), mainshocks["latitude"].to_numpy()].mean())
391 |         transformer, crs_local = build_local_transformer(center_lon, center_lat)
392 |         log("Built local azimuthal equidistant projection")
393 | 
394 |         x_km, y_km = project_lonlat(transformer, catalog["longitude"].to_numpy(), catalog["latitude"].to_numpy())
395 |         catalog["x_km"] = x_km
396 |         catalog["y_km"] = y_km
397 |         catalog["energy_joule"] = magnitude_to_energy_joule(catalog["magnitude"])
398 |         catalog["hours_since_main64"] = (catalog["event_time"] - main64["event_time"]).dt.total_seconds() / 3600.0
399 |         catalog["hours_to_main71"] = (main71["event_time"] - catalog["event_time"]).dt.total_seconds() / 3600.0
400 |         catalog["is_all_region"] = True
401 | 
402 |         main_xy_x, main_xy_y = project_lonlat(transformer, mainshocks["longitude"].to_numpy(), mainshocks["latitude"].to_numpy())
403 |         mainshocks = mainshocks.copy()
404 |         mainshocks["x_km"] = main_xy_x
405 |         mainshocks["y_km"] = main_xy_y
406 |         main64 = mainshocks.loc[np.isclose(mainshocks["magnitude"], 6.4)].sort_values("event_time").iloc[0]
407 |         main71 = mainshocks.loc[np.isclose(mainshocks["magnitude"], 7.1)].sort_values("event_time").iloc[0]
408 | 
409 |         corridor_a = make_corridor(REGION_A, transformer)
410 |         corridor_b = make_corridor(REGION_B, transformer)
411 |         log(f"Region A centerline length: {corridor_a.length_km:.2f} km")
412 |         log(f"Region B centerline length: {corridor_b.length_km:.2f} km")
413 | 
414 |         catalog = pd.concat([catalog, compute_corridor_coordinates(catalog, corridor_a), compute_corridor_coordinates(catalog, corridor_b)], axis=1)
415 | 
416 |         catalog["dist_to_main64_km"] = np.hypot(catalog["x_km"] - float(main64["x_km"]), catalog["y_km"] - float(main64["y_km"]))
417 |         catalog["dist_to_main71_km"] = np.hypot(catalog["x_km"] - float(main71["x_km"]), catalog["y_km"] - float(main71["y_km"]))
418 |         catalog["in_Mw64_neighborhood"] = catalog["dist_to_main64_km"] <= NEIGHBORHOOD_RADIUS_KM
419 |         catalog["in_Mw71_neighborhood"] = catalog["dist_to_main71_km"] <= NEIGHBORHOOD_RADIUS_KM
