181 |     return [
182 |         CircleDomain(
183 |             name="Mw6.4_neighborhood",
184 |             center_x_km=main64.x_km,
185 |             center_y_km=main64.y_km,
186 |             radius_km=radius_km,
187 |             mask_column="in_Mw64_neighborhood",
188 |         ),
189 |         CircleDomain(
190 |             name="Mw7.1_neighborhood",
191 |             center_x_km=main71.x_km,
192 |             center_y_km=main71.y_km,
193 |             radius_km=radius_km,
194 |             mask_column="in_Mw71_neighborhood",
195 |         ),
196 |     ]
