255 | def assign_corridor_cell_indices(events: pd.DataFrame, cell_size_km: float, corridor: Corridor) -> tuple[np.ndarray, np.ndarray]:
256 |     along = events[f"{corridor.name}_along_km"].to_numpy()
257 |     across = events[f"{corridor.name}_across_km"].to_numpy()
258 |     along_idx = np.floor(along / cell_size_km).astype(int)
259 |     across_idx = np.floor((across + corridor.half_width_km) / cell_size_km).astype(int)
260 |     return along_idx, across_idx[0m

