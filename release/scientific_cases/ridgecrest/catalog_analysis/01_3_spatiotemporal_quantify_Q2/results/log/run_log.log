161 | def enrich_mainshocks(metadata: dict, transformer: Transformer) -> tuple[Mainshock, Mainshock]:
162 |     rows = []
163 |     for key, name in [("mainshock64", "Mw6.4"), ("mainshock71", "Mw7.1")]:
164 |         d = metadata[key]
165 |         x, y = project_lonlat(transformer, np.array([d["longitude"]]), np.array([d["latitude"]]))
166 |         rows.append(
167 |             Mainshock(
168 |                 name=name,
169 |                 event_time=pd.Timestamp(d["event_time"]),
170 |                 longitude=float(d["longitude"]),
171 |                 latitude=float(d["latitude"]),
172 |                 x_km=float(x[0]),
173 |                 y_km=float(y[0]),
174 |                 magnitude=float(d["magnitude"]),
175 |             )
176 |         )
177 |     return rows[0], rows[1]
