208 | def segment_single_polyline(line_id: int, xy: np.ndarray, to_geo: Transformer) -> list[dict]:
209 |     diffs = np.diff(xy, axis=0)
210 |     seglens = np.sqrt((diffs ** 2).sum(axis=1))
211 |     cum = np.concatenate([[0.0], np.cumsum(seglens)])
212 |     total_length = float(cum[-1])
213 |     if total_length <= 0.0:
214 |         return []
215 | 
216 |     if total_length <= SEGMENT_TARGET_LENGTH_KM:
217 |         positions = np.array([0.0, total_length], dtype=float)
218 |     else:
219 |         n_segments = max(1, int(math.ceil(total_length / SEGMENT_TARGET_LENGTH_KM)))
220 |         positions = np.linspace(0.0, total_length, n_segments + 1)
221 | 
222 |     x_interp = np.interp(positions, cum, xy[:, 0])
223 |     y_interp = np.interp(positions, cum, xy[:, 1])
224 | 
225 |     records = []
226 |     for idx in range(len(positions) - 1):
227 |         x0 = float(x_interp[idx])
228 |         y0 = float(y_interp[idx])
229 |         x1 = float(x_interp[idx + 1])
230 |         y1 = float(y_interp[idx + 1])
231 |         length_km = float(math.hypot(x1 - x0, y1 - y0))
232 |         if length_km <= 0.0:
233 |             continue
234 |         xm = 0.5 * (x0 + x1)
235 |         ym = 0.5 * (y0 + y1)
236 |         lon0, lat0 = to_geo.transform(x0, y0)
237 |         lon1, lat1 = to_geo.transform(x1, y1)
238 |         lonm, latm = to_geo.transform(xm, ym)
239 |         strike = compute_orientation_strike(x0, y0, x1, y1)
240 |         records.append(
241 |             {
242 |                 'line_id': int(line_id),
243 |                 'segment_id': int(idx),
244 |                 'global_segment_id': -1,
245 |                 'line_segment_count': int(len(positions) - 1),
246 |                 'line_total_length_km': total_length,
247 |                 'segment_length_km': length_km,
248 |                 'start_x_km': x0,
249 |                 'start_y_km': y0,
250 |                 'end_x_km': x1,
251 |                 'end_y_km': y1,
252 |                 'mid_x_km': xm,
253 |                 'mid_y_km': ym,
254 |                 'start_lon': lon0,
255 |                 'start_lat': lat0,
256 |                 'end_lon': lon1,
257 |                 'end_lat': lat1,
258 |                 'mid_lon': lonm,
259 |                 'mid_lat': latm,
260 |                 'along_line_start_km': float(positions[idx]),
261 |                 'along_line_end_km': float(positions[idx + 1]),
262 |                 'along_line_mid_km': float(0.5 * (positions[idx] + positions[idx + 1])),
263 |                 'raw_azimuth_deg': float((math.degrees(math.atan2(y1 - y0, x1 - x0)) + 360.0) % 360.0),
264 |                 'strike_deg': float(strike),
265 |             }
266 |         )
267 |     return records
