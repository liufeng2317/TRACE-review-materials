154 | def build_local_transformer(main_df: pd.DataFrame) -> tuple[Transformer, Transformer, CRS]:
155 |     lon0 = float(main_df['longitude'].mean())
156 |     lat0 = float(main_df['latitude'].mean())
157 |     proj4 = f'+proj=aeqd +lat_0={lat0} +lon_0={lon0} +datum=WGS84 +units=km +no_defs'
158 |     crs_local = CRS.from_proj4(proj4)
159 |     to_local = Transformer.from_crs('EPSG:4326', crs_local, always_xy=True)
160 |     to_geo = Transformer.from_crs(crs_local, 'EPSG:4326', always_xy=True)
161 |     return to_local, to_geo, crs_local
