416 | def fig_size_from_bounds(bounds: tuple[float, float, float, float], base: float = 10.0) -> tuple[float, float]:
417 |     xmin, xmax, ymin, ymax = bounds
418 |     width = xmax - xmin
419 |     height = ymax - ymin
420 |     if width <= 0 or height <= 0:
421 |         return (10, 8)
422 |     aspect = width / height
423 |     if aspect >= 1:
424 |         return (base, max(6.5, base / max(aspect, 1e-6)))
425 |     return (max(6.5, base * aspect), base)
