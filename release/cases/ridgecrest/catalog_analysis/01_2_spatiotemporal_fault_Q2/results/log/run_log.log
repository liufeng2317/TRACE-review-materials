283 | def classify_fault_style(spearman_rho: float, p_value: float, activation_span_km: float, n_activated_segments: int, n_early_jumps: int, late_residual_fraction: float) -> str:
284 |     if n_activated_segments < MAJOR_FAULT_MIN_ACTIVATED_SEGMENTS:
285 |         return 'complex/indeterminate'
286 |     if np.isfinite(spearman_rho) and abs(spearman_rho) >= 0.75 and p_value <= 0.05 and activation_span_km >= 5.0:
287 |         return 'staged/progressive'
288 |     if np.isfinite(spearman_rho) and abs(spearman_rho) <= 0.25 and n_early_jumps <= 1 and late_residual_fraction < 0.25:
289 |         return 'near-synchronous'
290 |     if n_early_jumps >= 2:
291 |         return 'jump-like'
292 |     return 'complex/indeterminate'
