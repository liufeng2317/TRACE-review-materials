218 | def segment_single_polyline(line_id: int, xy: np.ndarray, to_geo: Transformer) -> list[dict]:
219 |     diffs = np.diff(xy, axis=0)
220 |     seglens = np.sqrt((diffs ** 2).sum(axis=1))
221 |     cum = np.concatenate([[0.0], np.cumsum(seglens)])
222 |     total_length = float(cum[-1])
223 |     if total_length <= 0.0:
224 |         return []
225 | 
226 |     if total_length <= SEGMENT_TARGET_LENGTH_KM:
227 |         positions = np.array([0.0, total_length], dtype=float)
228 |     else:
229 |         n_segments = max(1, int(math.ceil(total_length / SEGMENT_TARGET_LENGTH_KM)))
230 |         positions = np.linspace(0.0, total_length, n_segments + 1)
231 | 
232 |     x_interp = np.interp(positions, cum, xy[:, 0])
233 |     y_interp = np.interp(positions, cum, xy[:, 1])
234 | 
235 |     records = []
236 |     for idx in range(len(positions) - 1):
237 |         x0 = float(x_interp[idx])
238 |         y0 = float(y_interp[idx])
239 |         x1 = float(x_interp[idx + 1])
240 |         y1 = float(y_interp[idx + 1])
241 |         length_km = float(math.hypot(x1 - x0, y1 - y0))
242 |         if length_km <= 0.0:
243 |             continue
244 |         xm = 0.5 * (x0 + x1)
245 |         ym = 0.5 * (y0 + y1)
246 |         lon0, lat0 = to_geo.transform(x0, y0)
247 |         lon1, lat1 = to_geo.transform(x1, y1)
248 |         lonm, latm = to_geo.transform(xm, ym)
249 |         strike = compute_orientation_strike(x0, y0, x1, y1)
250 |         records.append(
251 |             {
252 |                 'line_id': int(line_id),
253 |                 'segment_id': int(idx),
254 |                 'global_segment_id': -1,
255 |                 'line_segment_count': int(len(positions) - 1),
256 |                 'line_total_length_km': total_length,
257 |                 'segment_length_km': length_km,
258 |                 'start_x_km': x0,
259 |                 'start_y_km': y0,
260 |                 'end_x_km': x1,
