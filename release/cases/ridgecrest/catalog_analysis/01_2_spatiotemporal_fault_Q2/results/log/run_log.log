151 | def build_local_transformer(main_df: pd.DataFrame) -> tuple[Transformer, Transformer, CRS]:
152 |     lon0 = float(main_df['longitude'].mean())
153 |     lat0 = float(main_df['latitude'].mean())
154 |     proj4 = f'+proj=aeqd +lat_0={lat0} +lon_0={lon0} +datum=WGS84 +units=km +no_defs'
155 |     crs_local = CRS.from_proj4(proj4)
156 |     to_local = Transformer.from_crs('EPSG:4326', crs_local, always_xy=True)
157 |     to_geo = Transformer.from_crs(crs_local, 'EPSG:4326', always_xy=True)
158 |     return to_local, to_geo, crs_local
159 | 
160 | 
161 | def project_xy(lon: np.ndarray, lat: np.ndarray, transformer: Transformer) -> tuple[np.ndarray, np.ndarray]:
162 |     x, y = transformer.transform(lon, lat)
163 |     return np.asarray(x, dtype=float), np.asarray(y, dtype=float)
164 | 
165 | 
166 | def build_study_region(faults: list[np.ndarray], transformer: Transformer) -> tuple[pd.DataFrame, tuple[float, float, float, float], np.ndarray, np.ndarray]:
167 |     xs_all = []
168 |     ys_all = []
169 |     for arr in faults:
170 |         x, y = project_xy(arr[:, 0], arr[:, 1], transformer)
171 |         xs_all.append(x)
172 |         ys_all.append(y)
173 |     xs = np.concatenate(xs_all)
174 |     ys = np.concatenate(ys_all)
175 |     xmin = math.floor((float(xs.min()) - BUFFER_KM) / GRID_SPACING_KM) * GRID_SPACING_KM
176 |     xmax = math.ceil((float(xs.max()) + BUFFER_KM) / GRID_SPACING_KM) * GRID_SPACING_KM
177 |     ymin = math.floor((float(ys.min()) - BUFFER_KM) / GRID_SPACING_KM) * GRID_SPACING_KM
178 |     ymax = math.ceil((float(ys.max()) + BUFFER_KM) / GRID_SPACING_KM) * GRID_SPACING_KM
179 |     bounds = (xmin, xmax, ymin, ymax)
180 |     region_df = pd.DataFrame([
181 |         {
182 |             'xmin_km': xmin,
183 |             'xmax_km': xmax,
184 |             'ymin_km': ymin,
185 |             'ymax_km': ymax,
186 |             'buffer_km': BUFFER_KM,
187 |             'grid_spacing_km': GRID_SPACING_KM,
188 |         }
189 |     ])
190 |     return region_df, bounds, xs, ys
191 | 
