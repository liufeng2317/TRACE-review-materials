198 |     ms64 = main_df.loc[np.isclose(mags, 6.4)]
199 |     ms71 = main_df.loc[np.isclose(mags, 7.1)]
200 |     if len(ms64) != 1 or len(ms71) != 1:
201 |         raise ValueError('Failed to identify unique Mw 6.4 and Mw 7.1 mainshocks from main_shock_events.csv')
202 |     out = pd.concat([ms64, ms71], ignore_index=True).copy()
203 |     out = out.sort_values('event_time').reset_index(drop=True)
204 |     if not np.isclose(out.iloc[0]['magnitude'], 6.4) or not np.isclose(out.iloc[1]['magnitude'], 7.1):
205 |         raise ValueError('Mainshock chronology inconsistent with expected Mw 6.4 then Mw 7.1 ordering')
206 |     out['mainshock_label'] = ['Mainshock64', 'Mainshock71']
