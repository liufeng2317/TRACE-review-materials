179 |     xmax = math.ceil((float(xs.max()) + BUFFER_KM) / GRID_SPACING_KM) * GRID_SPACING_KM
180 |     ymin = math.floor((float(ys.min()) - BUFFER_KM) / GRID_SPACING_KM) * GRID_SPACING_KM
181 |     ymax = math.ceil((float(ys.max()) + BUFFER_KM) / GRID_SPACING_KM) * GRID_SPACING_KM
