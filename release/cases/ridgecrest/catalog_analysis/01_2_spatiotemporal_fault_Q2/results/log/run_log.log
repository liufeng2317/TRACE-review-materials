270 | def build_fault_segments(projected_faults: list[np.ndarray], to_geo: Transformer) -> pd.DataFrame:
271 |     n_jobs = min(MAX_CORES, max(1, len(projected_faults)))
272 |     log(f'Discretizing {len(projected_faults)} fault polylines into ~{SEGMENT_TARGET_LENGTH_KM:.1f} km segments with n_jobs={n_jobs}')
273 |     chunk_size = 500
274 |     all_records: list[dict] = []
275 |     for start in range(0, len(projected_faults), chunk_size):
276 |         stop = min(len(projected_faults), start + chunk_size)
277 |         log(f'  segmenting polyline chunk {start}:{stop}')
278 |         chunk_records = Parallel(n_jobs=n_jobs, prefer='threads')(
279 |             delayed(segment_single_polyline)(line_id, projected_faults[line_id], to_geo)
280 |             for line_id in range(start, stop)
281 |         )
282 |         for recs in chunk_records:
283 |             all_records.extend(recs)
284 |     if not all_records:
285 |         raise ValueError('No fault segments were generated from the provided fault polylines')
286 |     df = pd.DataFrame(all_records)
287 |     df = df.sort_values(['line_id', 'segment_id']).reset_index(drop=True)
288 |     df['global_segment_id'] = np.arange(len(df), dtype=np.int64)
