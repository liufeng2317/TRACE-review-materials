207 | def filter_events(catalog: pd.DataFrame, main_df: pd.DataFrame, bounds: tuple[float, float, float, float], transformer: Transformer) -> tuple[pd.DataFrame, dict]:
208 |     t0 = main_df.loc[main_df['mainshock_label'] == 'Mainshock64', 'event_time'].iloc[0]
209 |     t1 = main_df.loc[main_df['mainshock_label'] == 'Mainshock71', 'event_time'].iloc[0]
210 |     xmin, xmax, ymin, ymax = bounds
211 |     work = catalog.copy()
212 |     work['x_km'], work['y_km'] = project_xy(work['longitude'].to_numpy(), work['latitude'].to_numpy(), transformer)
213 | 
214 |     time_mask = (work['event_time'] >= t0) & (work['event_time'] <= t1)
215 |     spatial_mask = (work['x_km'] >= xmin) & (work['x_km'] < xmax) & (work['y_km'] >= ymin) & (work['y_km'] < ymax)
216 |     final = work.loc[time_mask & spatial_mask].copy()
217 |     final = final.sort_values('event_time').reset_index(drop=True)
218 |     final['elapsed_minutes'] = (final['event_time'] - t0).dt.total_seconds() / 60.0
219 |     final['elapsed_hours'] = final['elapsed_minutes'] / 60.0
220 |     final['time_bin'] = np.floor(final['elapsed_minutes'] / TIME_BIN_MINUTES).astype(int)
221 | 
222 |     qc = {
