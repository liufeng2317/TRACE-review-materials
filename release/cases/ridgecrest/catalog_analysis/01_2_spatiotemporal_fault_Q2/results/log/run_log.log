623 | def build_summary_tables(grid_onset: pd.DataFrame, main_df: pd.DataFrame, filtered_events: pd.DataFrame) -> tuple[pd.DataFrame, pd.DataFrame]:
624 |     activated = grid_onset.loc[np.isfinite(grid_onset['onset_minutes'])].copy()
625 |     thresholds_min = [30, 60, 120, 240]
626 |     rows = []
627 |     n_occ = int(grid_onset['occupied'].sum())
628 |     n_act = len(activated)
629 |     for thr in thresholds_min:
630 |         count = int((activated['onset_minutes'] <= thr).sum())
631 |         rows.append(
632 |             {
633 |                 'metric': f'fraction_activated_within_{thr}_minutes',
634 |                 'value': float(count / n_occ) if n_occ > 0 else np.nan,
635 |                 'denominator_occupied_cells': n_occ,
636 |                 'numerator_activated_cells': count,
637 |             }
638 |         )
639 |     if n_act > 0:
640 |         for q in [0.1, 0.25, 0.5, 0.75, 0.9]:
641 |             rows.append(
642 |                 {
643 |                     'metric': f'onset_time_quantile_q{str(q).replace(".", "")}_hours',
644 |                     'value': float(activated['onset_hours'].quantile(q)),
645 |                     'denominator_occupied_cells': n_occ,
646 |                     'numerator_activated_cells': n_act,
647 |                 }
648 |             )
649 |     ms64 = main_df.loc[main_df['mainshock_label'] == 'Mainshock64'].iloc[0]
650 |     if n_act > 1:
651 |         activated['distance_to_mw64_km'] = np.hypot(activated['x_center_km'] - ms64['x_km'], activated['y_center_km'] - ms64['y_km'])
652 |         corr = activated[['distance_to_mw64_km', 'onset_hours']].corr(method='spearman').iloc[0, 1]
653 |         rows.append(
654 |             {
655 |                 'metric': 'spearman_onset_vs_distance_to_mw64',
656 |                 'value': float(corr),
657 |                 'denominator_occupied_cells': n_occ,
658 |                 'numerator_activated_cells': n_act,
659 |             }
660 |         )
661 |     metrics = pd.DataFrame(rows)
662 | 
663 |     validation = pd.DataFrame([
664 |         {'metric': 'filtered_events', 'value': int(len(filtered_events))},
665 |         {'metric': 'occupied_grid_cells', 'value': int(grid_onset['occupied'].sum())},
666 |         {'metric': 'activated_grid_cells', 'value': int(np.isfinite(grid_onset['onset_minutes']).sum())},
667 |         {'metric': 'robust_onset_cells', 'value': int((grid_onset['confidence_class'] == 'robust onset').sum())},
668 |         {'metric': 'weak_onset_cells', 'value': int((grid_onset['confidence_class'] == 'weak onset').sum())},
669 |         {'metric': 'no_onset_occupied_cells', 'value': int(((grid_onset['occupied']) & (~np.isfinite(grid_onset['onset_minutes']))).sum())},
670 |     ])
671 |     return metrics, validation
