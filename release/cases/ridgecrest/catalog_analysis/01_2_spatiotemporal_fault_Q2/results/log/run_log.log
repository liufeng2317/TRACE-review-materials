343 | def detect_onset(counts: np.ndarray) -> OnsetResult:
344 |     total = int(counts.sum())
345 |     peak = int(counts.max()) if len(counts) else 0
346 |     peak_rate = peak * (60.0 / TIME_BIN_MINUTES)
347 |     for i, c in enumerate(counts):
348 |         if c < 2:
349 |             continue
350 |         next1 = int(c + (counts[i + 1] if i + 1 < len(counts) else 0))
351 |         next2 = int(c + counts[i + 1:i + 3].sum())
352 |         nonzero_after = bool((counts[i + 1:i + 3] > 0).any())
353 |         sustained = (next1 >= 3) or (next2 >= 3 and nonzero_after)
354 |         if sustained:
355 |             confidence = 'robust onset' if (total >= 4 and next1 >= 3) else 'weak onset'
356 |             return OnsetResult(
357 |                 onset_bin=float(i),
358 |                 onset_minutes=float(i * TIME_BIN_MINUTES),
359 |                 support_candidate_next1=float(next1),
360 |                 support_candidate_next2=float(next2),
361 |                 total_events=total,
362 |                 peak_count=peak,
363 |                 peak_rate_per_hour=float(peak_rate),
364 |                 confidence_class=confidence,
365 |             )
366 |     return OnsetResult(
367 |         onset_bin=np.nan,
368 |         onset_minutes=np.nan,
369 |         support_candidate_next1=np.nan,
370 |         support_candidate_next2=np.nan,
371 |         total_events=total,
372 |         peak_count=peak,
373 |         peak_rate_per_hour=float(peak_rate),
374 |         confidence_class='no onset',
375 |     )
