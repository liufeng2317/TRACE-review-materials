318 | def build_cell_time_series(assignments: pd.DataFrame, time_bins: pd.DataFrame, n_jobs: int) -> pd.DataFrame:
319 |     n_bins = len(time_bins)
320 |     grouped = assignments.groupby('cell_id', sort=True)
321 |     cell_ids = list(grouped.groups.keys())
322 |     log(f'Constructing per-cell time series for {len(cell_ids)} occupied cells using {n_jobs} workers')
323 | 
324 |     def _one(cell_id: int) -> pd.DataFrame:
325 |         sub = grouped.get_group(cell_id)
326 |         counts = np.bincount(sub['time_bin'].to_numpy(), minlength=n_bins)
327 |         df = pd.DataFrame(
328 |             {
