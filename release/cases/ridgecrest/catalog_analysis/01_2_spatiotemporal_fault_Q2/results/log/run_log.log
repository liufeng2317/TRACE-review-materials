236 |             {'domain': domain, 'metric': 'n_active_domain', 'value': float(active_n), 'n_total_domain': total_n, 'n_active_domain': active_n},
237 |             {'domain': domain, 'metric': 'activation_time_iqr_minutes', 'value': iqr, 'n_total_domain': total_n, 'n_active_domain': active_n},
