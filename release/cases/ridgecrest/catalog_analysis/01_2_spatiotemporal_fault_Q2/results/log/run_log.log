200 | def compute_orientation_strike(x0: float, y0: float, x1: float, y1: float) -> float:
201 |     dx = x1 - x0
202 |     dy = y1 - y0
203 |     angle = (90.0 - math.degrees(math.atan2(dy, dx))) % 360.0
