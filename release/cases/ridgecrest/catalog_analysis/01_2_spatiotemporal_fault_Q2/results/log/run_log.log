312 | def associate_event_chunk(chunk: pd.DataFrame, segment_lookup: pd.DataFrame, tree: cKDTree, candidate_radius_km: float) -> pd.DataFrame:
313 |     px = chunk['x_km'].to_numpy(dtype=float)
314 |     py = chunk['y_km'].to_numpy(dtype=float)
315 |     candidate_lists = tree.query_ball_point(np.column_stack([px, py]), r=candidate_radius_km)
316 | 
317 |     seg_mid_x = segment_lookup['mid_x_km'].to_numpy(dtype=float)
318 |     seg_mid_y = segment_lookup['mid_y_km'].to_numpy(dtype=float)
319 |     seg_x0 = segment_lookup['start_x_km'].to_numpy(dtype=float)
320 |     seg_y0 = segment_lookup['start_y_km'].to_numpy(dtype=float)
321 |     seg_x1 = segment_lookup['end_x_km'].to_numpy(dtype=float)
322 |     seg_y1 = segment_lookup['end_y_km'].to_numpy(dtype=float)
323 |     seg_len = segment_lookup['segment_length_km'].to_numpy(dtype=float)
324 | 
325 |     rows = []
326 |     for local_i, (_, ev) in enumerate(chunk.iterrows()):
327 |         cand = candidate_lists[local_i]
328 |         if not cand:
329 |             dist_mid, nearest_mid_idx = tree.query([px[local_i], py[local_i]], k=1)
330 |             if np.isscalar(nearest_mid_idx):
331 |                 cand = [int(nearest_mid_idx)]
332 |             else:
333 |                 cand = [int(nearest_mid_idx[0])]
334 |         cand = np.asarray(sorted(set(int(i) for i in cand)), dtype=np.int64)
335 |         dist, idx_local, t_best = point_to_segment_distance(
336 |             np.asarray([px[local_i]]),
337 |             np.asarray([py[local_i]]),
338 |             seg_x0[cand],
339 |             seg_y0[cand],
340 |             seg_x1[cand],
341 |             seg_y1[cand],
342 |         )
343 |         best_local = int(idx_local[0])
344 |         best_tree_idx = int(cand[best_local])
345 |         best = segment_lookup.iloc[best_tree_idx]
346 |         along_km = float(best['along_line_start_km'] + t_best[0] * seg_len[best_tree_idx])
347 |         distance_km = float(dist[0])
348 |         rows.append(
349 |             {
350 |                 'event_id': int(ev['event_id']),
351 |                 'event_time': ev['event_time'],
352 |                 'latitude': float(ev['latitude']),
353 |                 'longitude': float(ev['longitude']),
354 |                 'depth_km': float(ev['depth_km']),
355 |                 'magnitude': float(ev['magnitude']),
356 |                 'x_km': float(ev['x_km']),
357 |                 'y_km': float(ev['y_km']),
358 |                 'elapsed_minutes': float(ev['elapsed_minutes']),
359 |                 'elapsed_hours': float(ev['elapsed_hours']),
360 |                 'time_bin': int(ev['time_bin']),
361 |                 'nearest_line_id': int(best['line_id']),
362 |                 'nearest_segment_id': int(best['segment_id']),
363 |                 'global_segment_id': int(best['global_segment_id']),
364 |                 'segment_strike_deg': float(best['strike_deg']),
365 |                 'segment_mid_x_km': float(best['mid_x_km']),
366 |                 'segment_mid_y_km': float(best['mid_y_km']),
367 |                 'distance_to_segment_km': distance_km,
368 |                 'along_line_position_km': along_km,
369 |                 'assigned_to_segment': bool(distance_km < ASSOCIATION_THRESHOLD_KM),
370 |             }
