333 |         )
334 |         df['rate_events_per_hour'] = df['event_count'] * (60.0 / TIME_BIN_MINUTES)
335 |         df['cumulative_count'] = df['event_count'].cumsum()
336 |         return df
337 | 
338 |     pieces = Parallel(n_jobs=n_jobs, prefer='processes', verbose=10)(delayed(_one)(cid) for cid in cell_ids)
