125 |             n_invalid += 1
126 |             continue
127 |         arr = np.asarray(poly, dtype=float)
128 |         if arr.ndim != 2 or arr.shape[1] != 2 or len(arr) < 2:
129 |             n_invalid += 1
130 |             continue
131 |         arr = arr[np.isfinite(arr).all(axis=1)]
132 |         if len(arr) < 2:
133 |             n_short += 1
134 |             continue
135 |         dedup = [arr[0]]
136 |         for p in arr[1:]:
137 |             if not np.allclose(p, dedup[-1]):
138 |                 dedup.append(p)
139 |         arr = np.asarray(dedup, dtype=float)
140 |         if len(arr) < 2:
141 |             n_short += 1
142 |             continue
143 |         cleaned.append(arr)
144 |     qc = {
145 |         'input_fault_polylines': int(len(faults)),
146 |         'invalid_fault_polylines': int(n_invalid),
147 |         'too_short_fault_polylines': int(n_short),
148 |         'retained_fault_polylines': int(len(cleaned)),
