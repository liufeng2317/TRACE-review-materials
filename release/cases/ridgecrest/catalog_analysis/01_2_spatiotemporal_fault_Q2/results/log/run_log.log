380 |     grouped = cell_time_series.groupby('cell_id', sort=True)
381 |     cell_ids = list(grouped.groups.keys())
382 |     log(f'Computing onset table for {len(cell_ids)} occupied cells using {n_jobs} workers')
383 | 
384 |     def _one(cell_id: int) -> dict:
385 |         sub = grouped.get_group(cell_id)
386 |         result = detect_onset(sub['event_count'].to_numpy())
