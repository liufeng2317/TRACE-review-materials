292 | def point_to_segment_distance(px: np.ndarray, py: np.ndarray, x0: np.ndarray, y0: np.ndarray, x1: np.ndarray, y1: np.ndarray) -> tuple[np.ndarray, np.ndarray]:
293 |     vx = x1 - x0
294 |     vy = y1 - y0
295 |     wx = px[:, None] - x0[None, :]
296 |     wy = py[:, None] - y0[None, :]
297 |     denom = vx * vx + vy * vy
298 |     denom = np.where(denom <= 0.0, 1.0, denom)
299 |     t = (wx * vx[None, :] + wy * vy[None, :]) / denom[None, :]
300 |     t = np.clip(t, 0.0, 1.0)
301 |     projx = x0[None, :] + t * vx[None, :]
302 |     projy = y0[None, :] + t * vy[None, :]
303 |     dx = px[:, None] - projx
304 |     dy = py[:, None] - projy
305 |     d2 = dx * dx + dy * dy
306 |     idx = np.argmin(d2, axis=1)
307 |     dist = np.sqrt(d2[np.arange(len(px)), idx])
308 |     t_best = t[np.arange(len(px)), idx]
309 |     return dist, idx.astype(np.int64), t_best
310 | 
