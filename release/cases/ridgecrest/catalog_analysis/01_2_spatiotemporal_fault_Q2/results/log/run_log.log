175 | def add_segment_geometry_diagnostics(segment_df: pd.DataFrame) -> pd.DataFrame:
176 |     out = segment_df.sort_values(['line_id', 'segment_id']).reset_index(drop=True).copy()
177 |     out['segment_dx_km'] = out['end_x_km'] - out['start_x_km']
178 |     out['segment_dy_km'] = out['end_y_km'] - out['start_y_km']
179 |     out['segment_mid_distance_from_origin_km'] = np.hypot(out['mid_x_km'], out['mid_y_km'])
180 |     out['bend_flag'] = False
181 |     out['local_turn_angle_deg'] = np.nan
182 |     for line_id, idx in out.groupby('line_id').groups.items():
183 |         ids = list(idx)
184 |         if len(ids) < 3:
185 |             continue
186 |         strikes = out.loc[ids, 'strike_deg'].to_numpy(dtype=float)
187 |         turn = np.abs(np.diff(strikes))
188 |         turn = np.minimum(turn, 180.0 - turn)
189 |         for pos in range(1, len(ids) - 1):
190 |             angle = max(turn[pos - 1], turn[pos])
191 |             out.at[ids[pos], 'local_turn_angle_deg'] = angle
192 |             out.at[ids[pos], 'bend_flag'] = bool(angle >= BEND_ANGLE_THRESHOLD_DEG)
193 |     return out
