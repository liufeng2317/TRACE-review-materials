225 |     if total_length <= SEGMENT_TARGET_LENGTH_KM:
226 |         positions = np.array([0.0, total_length], dtype=float)
227 |     else:
228 |         n_segments = max(1, int(math.ceil(total_length / SEGMENT_TARGET_LENGTH_KM)))
229 |         positions = np.linspace(0.0, total_length, n_segments + 1)
230 | 
231 |     x_interp = np.interp(positions, cum, xy[:, 0])
232 |     y_interp = np.interp(positions, cum, xy[:, 1])
233 | 
234 |     records = []
