    ax.set_ylabel('Local y (km)')
    ax.set_title('Grid-cell activation onset time map')
    ax.set_aspect('equal', adjustable='box')
    cbar = fig.colorbar(sc, ax=ax, label='Onset time since Mw 6.4 (hours)') if len(activated) else None
