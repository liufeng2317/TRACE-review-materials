217 | def segment_single_polyline(line_id: int, xy: np.ndarray, to_geo: Transformer) -> list[dict]:
218 |     diffs = np.diff(xy, axis=0)
219 |     seglens = np.sqrt((diffs ** 2).sum(axis=1))
220 |     cum = np.concatenate([[0.0], np.cumsum(seglens)])
