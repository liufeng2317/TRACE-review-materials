    plt.close(fig)
    log(f'Saved figure: {outpath}')


def plot_onset_map(grid_onset: pd.DataFrame, main_df: pd.DataFrame, fault_xs: np.ndarray, fault_ys: np.ndarray, bounds: tuple[float, float, float, float], outpath: Path) -> None:
