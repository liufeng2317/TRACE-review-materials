236 | def assign_events_to_grid_and_time(events: pd.DataFrame, grid_meta: Dict[str, float], time_edges: np.ndarray) -> pd.DataFrame:
237 |     log("Assigning events to grid cells and 30-minute time bins")
238 |     nx = int(grid_meta["nx"])
239 |     ny = int(grid_meta["ny"])
240 |     x_min = float(grid_meta["x_min_km"])
241 |     y_min = float(grid_meta["y_min_km"])
242 | 
243 |     x_index = np.floor((events["x_km"].to_numpy() - x_min) / GRID_SIZE_KM).astype(int)
244 |     y_index = np.floor((events["y_km"].to_numpy() - y_min) / GRID_SIZE_KM).astype(int)
245 |     x_index = np.clip(x_index, 0, nx - 1)
246 |     y_index = np.clip(y_index, 0, ny - 1)
247 |     cell_id = y_index * nx + x_index
248 | 
249 |     rel_min = events["time_rel_min_from_64"].to_numpy(dtype=float)
250 |     duration_minutes = float(time_edges[-1])
251 |     time_bin = np.searchsorted(time_edges, rel_min, side="right") - 1
252 |     time_bin = np.where(np.isclose(rel_min, duration_minutes), len(time_edges) - 2, time_bin)
253 |     time_bin = np.clip(time_bin, 0, len(time_edges) - 2)
254 | 
255 |     out = events.copy()
256 |     out["grid_ix"] = x_index.astype(np.int32)
257 |     out["grid_iy"] = y_index.astype(np.int32)
258 |     out["cell_id"] = cell_id.astype(np.int64)
259 |     out["time_bin_index_30min"] = time_bin.astype(np.int32)
260 |     out["time_bin_start_min_30min"] = time_edges[time_bin]
261 |     out["time_bin_end_min_30min"] = time_edges[time_bin + 1]
262 |     return out
