def build_grid(events: pd.DataFrame) -> Tuple[pd.DataFrame, Dict[str, float]]:
    log("Constructing 0.5 km × 0.5 km study grid from [Mw 6.4, Mw 7.1] event extent")
    x_min = math.floor(events["x_km"].min() / GRID_SIZE_KM) * GRID_SIZE_KM
    x_max = math.ceil(events["x_km"].max() / GRID_SIZE_KM) * GRID_SIZE_KM
    y_min = math.floor(events["y_km"].min() / GRID_SIZE_KM) * GRID_SIZE_KM
    y_max = math.ceil(events["y_km"].max() / GRID_SIZE_KM) * GRID_SIZE_KM

    x_edges = np.arange(x_min, x_max + GRID_SIZE_KM, GRID_SIZE_KM)
    y_edges = np.arange(y_min, y_max + GRID_SIZE_KM, GRID_SIZE_KM)
    if len(x_edges) < 2 or len(y_edges) < 2:
        raise ValueError("Invalid grid extent: insufficient number of x/y edges")

    nx = len(x_edges) - 1
    ny = len(y_edges) - 1
    x_centers = x_edges[:-1] + GRID_SIZE_KM / 2.0
    y_centers = y_edges[:-1] + GRID_SIZE_KM / 2.0
    xx, yy = np.meshgrid(x_centers, y_centers)
    ix, iy = np.meshgrid(np.arange(nx), np.arange(ny))
    cell_id = (iy * nx + ix).astype(np.int64)

    grid = pd.DataFrame(
        {
            "cell_id": cell_id.ravel(),
            "ix": ix.ravel().astype(np.int32),
            "iy": iy.ravel().astype(np.int32),
            "x_left_km": np.repeat(x_edges[:-1], ny) if False else np.tile(x_edges[:-1], ny),
            "x_right_km": np.repeat(x_edges[1:], ny) if False else np.tile(x_edges[1:], ny),
            "y_bottom_km": np.repeat(y_edges[:-1], nx),
            "y_top_km": np.repeat(y_edges[1:], nx),
            "x_center_km": xx.ravel(),
            "y_center_km": yy.ravel(),
        }
    )

    meta = {
        "x_min_km": x_min,
        "x_max_km": x_max,
        "y_min_km": y_min,
        "y_max_km": y_max,
        "nx": nx,
        "ny": ny,
        "n_cells": len(grid),
    }
    return grid, meta
