420 | def add_mainshock_distance_metrics(
421 |     spatial_summary: pd.DataFrame,
422 |     projection_meta: Dict[str, float],
423 | ) -> pd.DataFrame:
424 |     ms64_xy = np.array([projection_meta["mainshock64_x_km"], projection_meta["mainshock64_y_km"]])
425 |     ms71_xy = np.array([projection_meta["mainshock71_x_km"], projection_meta["mainshock71_y_km"]])
426 |     df = spatial_summary.copy()
427 |     centroids = df[["centroid_x_km", "centroid_y_km"]].to_numpy(dtype=float)
428 |     dist64 = np.full(len(df), np.nan)
429 |     dist71 = np.full(len(df), np.nan)
430 |     good = np.isfinite(centroids).all(axis=1)
431 |     dist64[good] = np.linalg.norm(centroids[good] - ms64_xy, axis=1)
432 |     dist71[good] = np.linalg.norm(centroids[good] - ms71_xy, axis=1)
433 |     df["centroid_dist_to_mw64_km"] = dist64
434 |     df["centroid_dist_to_mw71_km"] = dist71
435 |     return df
