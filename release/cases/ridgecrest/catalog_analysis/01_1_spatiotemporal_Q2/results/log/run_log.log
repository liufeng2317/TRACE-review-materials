166 | def add_relative_time_and_projection(
167 |     catalog: pd.DataFrame,
168 |     ms64: MainshockReference,
169 |     ms71: MainshockReference,
170 | ) -> Tuple[pd.DataFrame, Dict[str, float]]:
171 |     log("Deriving relative-time fields and projected coordinates")
172 |     center_lon = (ms64.longitude + ms71.longitude) / 2.0
173 |     center_lat = (ms64.latitude + ms71.latitude) / 2.0
174 |     transformer, crs_name = build_local_transformer(center_lon, center_lat)
175 | 
176 |     x_m, y_m = transformer.transform(catalog["longitude"].to_numpy(), catalog["latitude"].to_numpy())
177 |     ms64_x_m, ms64_y_m = transformer.transform(ms64.longitude, ms64.latitude)
178 |     ms71_x_m, ms71_y_m = transformer.transform(ms71.longitude, ms71.latitude)
179 | 
180 |     enriched = catalog.copy()
181 |     delta = enriched["event_time"] - ms64.event_time
182 |     enriched["time_rel_sec_from_64"] = delta.dt.total_seconds()
183 |     enriched["time_rel_min_from_64"] = enriched["time_rel_sec_from_64"] / 60.0
184 |     enriched["time_rel_hr_from_64"] = enriched["time_rel_sec_from_64"] / 3600.0
185 |     enriched["x_km"] = x_m / 1000.0
186 |     enriched["y_km"] = y_m / 1000.0
187 | 
188 |     projection_meta = {
189 |         "projection_crs": crs_name,
190 |         "projection_center_lon": center_lon,
191 |         "projection_center_lat": center_lat,
192 |         "mainshock64_x_km": ms64_x_m / 1000.0,
193 |         "mainshock64_y_km": ms64_y_m / 1000.0,
194 |         "mainshock71_x_km": ms71_x_m / 1000.0,
195 |         "mainshock71_y_km": ms71_y_m / 1000.0,
196 |     }
197 |     return enriched, projection_meta
