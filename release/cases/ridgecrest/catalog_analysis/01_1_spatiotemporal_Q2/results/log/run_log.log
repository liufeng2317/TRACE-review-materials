208 | def assign_time_bins(
209 |     df: pd.DataFrame,
210 |     window: WindowDefinition,
211 |     reference_time: pd.Timestamp,
212 | ) -> Tuple[pd.DataFrame, pd.DataFrame, np.ndarray]:
213 |     subset = df.copy()
214 |     rel_minutes = (subset["event_time"] - reference_time).dt.total_seconds() / 60.0
215 |     subset["time_since_64_min"] = rel_minutes
216 | 
217 |     duration_minutes = (window.end_time - window.start_time).total_seconds() / 60.0
218 |     edges = np.arange(0.0, duration_minutes + window.bin_minutes, window.bin_minutes, dtype=float)
219 |     if edges[-1] < duration_minutes:
220 |         edges = np.append(edges, duration_minutes)
221 |     if edges[-1] > duration_minutes:
222 |         edges[-1] = duration_minutes
223 |     if len(edges) < 2:
224 |         edges = np.array([0.0, duration_minutes], dtype=float)
225 | 
226 |     bin_indices = np.searchsorted(edges, rel_minutes.to_numpy(), side="right") - 1
227 |     bin_indices = np.clip(bin_indices, 0, len(edges) - 2)
228 | 
229 |     labels = []
230 |     starts = edges[:-1]
231 |     ends = edges[1:]
232 |     for i, (start_min, end_min) in enumerate(zip(starts, ends)):
233 |         if window.bin_minutes < 60:
234 |             label = f"{int(round(start_min))}-{int(round(end_min))} min"
235 |         else:
236 |             label = f"{start_min / 60.0:.1f}-{end_min / 60.0:.1f} h"
237 |         labels.append(label)
238 | 
239 |     subset["time_bin_index"] = bin_indices.astype(int)
240 |     subset["time_bin_label"] = [labels[idx] for idx in subset["time_bin_index"]]
241 |     subset["time_bin_start_min"] = [starts[idx] for idx in subset["time_bin_index"]]
242 |     subset["time_bin_end_min"] = [ends[idx] for idx in subset["time_bin_index"]]
243 | 
244 |     all_bins = pd.DataFrame(
245 |         {
246 |             "window_name": window.name,
247 |             "time_bin_index": np.arange(len(starts), dtype=int),
248 |             "time_bin_start_min": starts,
249 |             "time_bin_end_min": ends,
250 |             "time_bin_label": labels,
251 |         }
252 |     )
253 |     counts = subset.groupby("time_bin_index", as_index=False).size().rename(columns={"size": "event_count"})
254 |     summary = all_bins.merge(counts, on="time_bin_index", how="left")
255 |     summary["event_count"] = summary["event_count"].fillna(0).astype(int)
256 |     return subset, summary, edges
