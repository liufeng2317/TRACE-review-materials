223 |     rel_minutes = (subset["event_time"] - reference_time).dt.total_seconds() / 60.0
224 |     subset["time_since_64_min"] = rel_minutes
225 | 
226 |     duration_minutes = (window.end_time - window.start_time).total_seconds() / 60.0
227 |     if duration_minutes <= 0:
228 |         raise ValueError(f"Window {window.name} has non-positive duration: {duration_minutes} minutes")
229 | 
230 |     edges = np.arange(0.0, duration_minutes + window.bin_minutes, window.bin_minutes, dtype=float)
231 |     if edges[-1] < duration_minutes:
232 |         edges = np.append(edges, duration_minutes)
233 |     elif edges[-1] > duration_minutes:
234 |         if not np.isclose(edges[-1], duration_minutes):
