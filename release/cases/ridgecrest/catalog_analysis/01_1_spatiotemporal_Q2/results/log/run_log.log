216 | def assign_time_bins(
217 |     df: pd.DataFrame,
218 |     window: WindowDefinition,
219 |     reference_time: pd.Timestamp,
220 | ) -> Tuple[pd.DataFrame, pd.DataFrame, np.ndarray]:
221 |     require_columns(df, ["event_time"], f"assign_time_bins input for {window.name}")
