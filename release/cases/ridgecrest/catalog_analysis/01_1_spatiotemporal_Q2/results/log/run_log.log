200 | def subset_window(df: pd.DataFrame, window: WindowDefinition) -> pd.DataFrame:
201 |     mask = (df["event_time"] >= window.start_time) & (df["event_time"] <= window.end_time)
202 |     subset = df.loc[mask].copy().reset_index(drop=True)
203 |     if subset.empty:
