299 | def choose_onset_rule(counts: np.ndarray, time_edges: np.ndarray) -> Tuple[OnsetRule, pd.DataFrame]:
300 |     per_cell_total = counts.sum(axis=1)
301 |     occupied_mask = per_cell_total > 0
302 |     occupied_counts = counts[occupied_mask]
303 |     positive_30min_counts = occupied_counts[occupied_counts > 0]
304 |     if positive_30min_counts.size == 0:
305 |         raise ValueError("No positive 30-minute counts found in occupied cells")
306 | 
307 |     threshold_count = int(max(1, min(2, np.percentile(positive_30min_counts, 75))))
308 |     min_total_events = int(max(3, threshold_count + 2))
309 |     cumulative_window_bins = max(2, int(round(ONSET_WINDOW_HOURS * 60.0 / TIME_BIN_MINUTES)))
310 |     cumulative_sums = []
311 |     for row in occupied_counts:
312 |         if len(row) < cumulative_window_bins:
313 |             cumulative_sums.append(row.sum())
314 |         else:
315 |             conv = np.convolve(row, np.ones(cumulative_window_bins, dtype=int), mode="valid")
316 |             cumulative_sums.extend(conv.tolist())
317 |     cumulative_sums = np.array(cumulative_sums, dtype=float)
318 |     positive_cum = cumulative_sums[cumulative_sums > 0]
319 |     cumulative_min_count = int(max(min_total_events, min(4, np.percentile(positive_cum, 60))))
320 | 
321 |     rule = OnsetRule(
322 |         threshold_count=threshold_count,
323 |         min_total_events=min_total_events,
324 |         persistence_future_bins=ONSET_PERSISTENCE_FUTURE_BINS,
325 |         persistence_min_active_bins=ONSET_PERSISTENCE_MIN_ACTIVE_BINS,
326 |         cumulative_window_bins=cumulative_window_bins,
327 |         cumulative_min_count=cumulative_min_count,
328 |     )
329 | 
330 |     diagnostics = pd.DataFrame(
331 |         [
332 |             {"metric": "positive_30min_count_p50", "value": float(np.percentile(positive_30min_counts, 50))},
333 |             {"metric": "positive_30min_count_p75", "value": float(np.percentile(positive_30min_counts, 75))},
334 |             {"metric": "positive_30min_count_p90", "value": float(np.percentile(positive_30min_counts, 90))},
335 |             {"metric": "occupied_cells", "value": int(occupied_mask.sum())},
336 |             {"metric": "cells_with_total_ge_min_total_events", "value": int((per_cell_total >= min_total_events).sum())},
337 |             {"metric": "cumulative_window_bins", "value": int(cumulative_window_bins)},
338 |             {"metric": "cumulative_positive_p60", "value": float(np.percentile(positive_cum, 60))},
339 |             {"metric": "selected_threshold_count", "value": int(threshold_count)},
340 |             {"metric": "selected_min_total_events", "value": int(min_total_events)},
341 |             {"metric": "selected_cumulative_min_count", "value": int(cumulative_min_count)},
342 |         ]
343 |     )
344 |     return rule, diagnostics
