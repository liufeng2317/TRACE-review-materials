190 | def build_grid(events: pd.DataFrame) -> Tuple[pd.DataFrame, Dict[str, float]]:
191 |     log("Constructing 0.5 km × 0.5 km study grid from [Mw 6.4, Mw 7.1] event extent")
192 |     x_min = math.floor(events["x_km"].min() / GRID_SIZE_KM) * GRID_SIZE_KM
193 |     x_max = math.ceil(events["x_km"].max() / GRID_SIZE_KM) * GRID_SIZE_KM
194 |     y_min = math.floor(events["y_km"].min() / GRID_SIZE_KM) * GRID_SIZE_KM
195 |     y_max = math.ceil(events["y_km"].max() / GRID_SIZE_KM) * GRID_SIZE_KM
196 | 
197 |     x_edges = np.arange(x_min, x_max + GRID_SIZE_KM, GRID_SIZE_KM)
198 |     y_edges = np.arange(y_min, y_max + GRID_SIZE_KM, GRID_SIZE_KM)
199 |     if len(x_edges) < 2 or len(y_edges) < 2:
200 |         raise ValueError("Invalid grid extent: insufficient number of x/y edges")
201 | 
202 |     nx = len(x_edges) - 1
203 |     ny = len(y_edges) - 1
204 |     x_centers = x_edges[:-1] + GRID_SIZE_KM / 2.0
205 |     y_centers = y_edges[:-1] + GRID_SIZE_KM / 2.0
206 |     xx, yy = np.meshgrid(x_centers, y_centers)
207 |     ix, iy = np.meshgrid(np.arange(nx), np.arange(ny))
208 |     cell_id = (iy * nx + ix).astype(np.int64)
209 | 
210 |     grid = pd.DataFrame(
211 |         {
212 |             "cell_id": cell_id.ravel(),
213 |             "ix": ix.ravel().astype(np.int32),
214 |             "iy": iy.ravel().astype(np.int32),
215 |             "x_left_km": np.repeat(x_edges[:-1], ny) if False else np.tile(x_edges[:-1], ny),
216 |             "x_right_km": np.repeat(x_edges[1:], ny) if False else np.tile(x_edges[1:], ny),
217 |             "y_bottom_km": np.repeat(y_edges[:-1], nx),
218 |             "y_top_km": np.repeat(y_edges[1:], nx),
219 |             "x_center_km": xx.ravel(),
220 |             "y_center_km": yy.ravel(),
221 |         }
222 |     )
223 | 
224 |     meta = {
225 |         "x_min_km": x_min,
226 |         "x_max_km": x_max,
227 |         "y_min_km": y_min,
228 |         "y_max_km": y_max,
229 |         "nx": nx,
230 |         "ny": ny,
231 |         "n_cells": len(grid),
232 |     }
233 |     return grid, meta
