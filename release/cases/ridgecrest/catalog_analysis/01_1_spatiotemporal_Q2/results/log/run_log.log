216 | def assign_time_bins(
217 |     df: pd.DataFrame,
218 |     window: WindowDefinition,
219 |     reference_time: pd.Timestamp,
220 | ) -> Tuple[pd.DataFrame, pd.DataFrame, np.ndarray]:
221 |     require_columns(df, ["event_time"], f"assign_time_bins input for {window.name}")
222 |     subset = df.copy()
223 |     rel_minutes = (subset["event_time"] - reference_time).dt.total_seconds() / 60.0
224 |     subset["time_since_64_min"] = rel_minutes
225 | 
226 |     duration_minutes = (window.end_time - window.start_time).total_seconds() / 60.0
227 |     if duration_minutes <= 0:
228 |         raise ValueError(f"Window {window.name} has non-positive duration: {duration_minutes} minutes")
229 | 
230 |     edges = np.arange(0.0, duration_minutes + window.bin_minutes, window.bin_minutes, dtype=float)
231 |     if edges[-1] < duration_minutes:
232 |         edges = np.append(edges, duration_minutes)
233 |     elif edges[-1] > duration_minutes:
234 |         if not np.isclose(edges[-1], duration_minutes):
235 |             edges = np.append(edges, duration_minutes)
236 |         else:
237 |             edges[-1] = duration_minutes
238 |     if len(edges) < 2:
239 |         edges = np.array([0.0, duration_minutes], dtype=float)
240 | 
241 |     rel_array = rel_minutes.to_numpy(dtype=float)
242 |     if np.any(rel_array < -1e-9) or np.any(rel_array > duration_minutes + 1e-9):
243 |         raise ValueError(f"Found event times outside window bounds for {window.name}")
244 | 
245 |     bin_indices = np.searchsorted(edges, rel_array, side="right") - 1
246 |     bin_indices = np.where(np.isclose(rel_array, duration_minutes), len(edges) - 2, bin_indices)
247 |     bin_indices = np.clip(bin_indices, 0, len(edges) - 2)
248 | 
249 |     labels = []
250 |     starts = edges[:-1]
251 |     ends = edges[1:]
252 |     for start_min, end_min in zip(starts, ends):
253 |         if window.bin_minutes < 60:
254 |             label = f"{int(round(start_min))}-{int(round(end_min))} min"
255 |         else:
256 |             label = f"{start_min / 60.0:.1f}-{end_min / 60.0:.1f} h"
257 |         labels.append(label)
258 | 
259 |     subset["time_bin_index"] = bin_indices.astype(int)
260 |     subset["time_bin_label"] = [labels[idx] for idx in subset["time_bin_index"]][0m

