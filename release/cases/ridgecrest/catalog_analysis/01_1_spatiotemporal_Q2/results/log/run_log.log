158 | def build_local_transformer(center_lon: float, center_lat: float) -> Tuple[Transformer, str]:
159 |     zone = int(math.floor((center_lon + 180.0) / 6.0) + 1)
160 |     epsg = 32600 + zone if center_lat >= 0 else 32700 + zone
161 |     crs = CRS.from_epsg(epsg)
162 |     transformer = Transformer.from_crs("EPSG:4326", crs, always_xy=True)
163 |     return transformer, crs.to_string()
