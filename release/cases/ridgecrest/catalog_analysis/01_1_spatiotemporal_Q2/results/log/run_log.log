360 | def compute_pca_spatial_summary(df: pd.DataFrame, bin_summary: pd.DataFrame) -> pd.DataFrame:
361 |     log("Computing per-bin projected spatial summaries")
362 |     rows: List[Dict[str, object]] = []
363 |     prev_centroid = None
364 |     for _, bin_row in bin_summary.iterrows():
365 |         idx = int(bin_row["time_bin_index"])
366 |         part = df[df["time_bin_index"] == idx].copy()
367 |         record: Dict[str, object] = {
368 |             "window_name": bin_row["window_name"],
369 |             "time_bin_index": idx,
370 |             "time_bin_label": bin_row["time_bin_label"],
371 |             "time_bin_start_min": float(bin_row["time_bin_start_min"]),
372 |             "time_bin_end_min": float(bin_row["time_bin_end_min"]),
373 |             "event_count": int(bin_row["event_count"]),
374 |         }
375 |         if part.empty:
376 |             record.update(
377 |                 {
378 |                     "centroid_x_km": np.nan,
379 |                     "centroid_y_km": np.nan,
380 |                     "centroid_lon": np.nan,
381 |                     "centroid_lat": np.nan,
382 |                     "pca_axis1_std_km": np.nan,
383 |                     "pca_axis2_std_km": np.nan,
384 |                     "pca_axis1_azimuth_deg": np.nan,
385 |                     "centroid_step_from_prev_km": np.nan,
386 |                     "summary_quality": "empty_bin",
387 |                 }
388 |             )
389 |         else:
390 |             xy = part[["x_km", "y_km"]].to_numpy()
391 |             centroid = xy.mean(axis=0)
392 |             record["centroid_x_km"] = centroid[0]
393 |             record["centroid_y_km"] = centroid[1]
394 |             record["centroid_lon"] = float(part["longitude"].mean())
395 |             record["centroid_lat"] = float(part["latitude"].mean())
396 |             if len(part) >= 2:
397 |                 pca = PCA(n_components=2)
398 |                 pca.fit(xy)
399 |                 stds = np.sqrt(np.maximum(pca.explained_variance_, 0.0))
400 |                 comp = pca.components_[0]
401 |                 azimuth = (90.0 - math.degrees(math.atan2(comp[1], comp[0]))) % 180.0
402 |                 record["pca_axis1_std_km"] = float(stds[0])
403 |                 record["pca_axis2_std_km"] = float(stds[1])
404 |                 record["pca_axis1_azimuth_deg"] = float(azimuth)
405 |                 record["summary_quality"] = "pca_ok" if len(part) >= 5 else "low_count_pca"
406 |             else:
407 |                 record["pca_axis1_std_km"] = np.nan
408 |                 record["pca_axis2_std_km"] = np.nan
409 |                 record["pca_axis1_azimuth_deg"] = np.nan
410 |                 record["summary_quality"] = "single_event"
411 |             if prev_centroid is None:
412 |                 record["centroid_step_from_prev_km"] = np.nan
413 |             else:
414 |                 record["centroid_step_from_prev_km"] = float(np.linalg.norm(centroid - prev_centroid))
415 |             prev_centroid = centroid
416 |         rows.append(record)
417 |     return pd.DataFrame(rows)
