def attach_lon_lat_to_cells(cell_summary: pd.DataFrame, event_assignments: pd.DataFrame) -> pd.DataFrame:
    occupied_centers = (
        event_assignments.groupby("cell_id")[["longitude", "latitude"]].median().rename(columns={"longitude": "longitude_center", "latitude": "latitude_center"})
    )
    merged = cell_summary.merge(occupied_centers, on="cell_id", how="left")
    if merged["longitude_center"].isna().any() or merged["latitude_center"].isna().any():
        fallback = (
            event_assignments[["cell_id", "grid_ix", "grid_iy", "longitude", "latitude"]]
            .drop_duplicates("cell_id")
            .groupby("cell_id")[["longitude", "latitude"]]
            .first()
            .rename(columns={"longitude": "longitude_center_fallback", "latitude": "latitude_center_fallback"})
        )
        merged = merged.merge(fallback, on="cell_id", how="left")
        merged["longitude_center"] = merged["longitude_center"].fillna(merged["longitude_center_fallback"])
        merged["latitude_center"] = merged["latitude_center"].fillna(merged["latitude_center_fallback"])
        merged = merged.drop(columns=["longitude_center_fallback", "latitude_center_fallback"])
    return merged
