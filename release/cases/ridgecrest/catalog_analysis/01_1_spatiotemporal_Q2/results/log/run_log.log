180 |     edges = np.arange(0.0, duration_minutes + TIME_BIN_MINUTES, TIME_BIN_MINUTES, dtype=float)
181 |     if edges[-1] < duration_minutes:
182 |         edges = np.append(edges, duration_minutes)
183 |     elif edges[-1] > duration_minutes:
184 |         edges[-1] = duration_minutes
185 |     if len(edges) < 2:
186 |         edges = np.array([0.0, duration_minutes], dtype=float)
187 |     return edges
