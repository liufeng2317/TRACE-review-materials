265 | def build_cell_time_matrix(event_assignments: pd.DataFrame, grid: pd.DataFrame, time_edges: np.ndarray) -> Tuple[pd.DataFrame, np.ndarray]:
266 |     n_cells = len(grid)
267 |     n_time = len(time_edges) - 1
268 |     log(f"Building cell-by-time count matrix: {n_cells:,} cells × {n_time:,} time bins")
269 |     counts = np.zeros((n_cells, n_time), dtype=np.int32)
270 | 
271 |     grouped = (
272 |         event_assignments.groupby(["cell_id", "time_bin_index_30min"]).size().reset_index(name="event_count")
273 |     )
274 |     counts[grouped["cell_id"].to_numpy(dtype=int), grouped["time_bin_index_30min"].to_numpy(dtype=int)] = grouped[
275 |         "event_count"
276 |     ].to_numpy(dtype=np.int32)
277 | 
278 |     records: List[pd.DataFrame] = []
279 |     chunk_size = max(1, min(5000, n_cells // 8 if n_cells >= 8 else n_cells))
280 |     for start in range(0, n_cells, chunk_size):
281 |         stop = min(start + chunk_size, n_cells)
282 |         chunk_counts = counts[start:stop, :]
283 |         chunk_cell_ids = grid.iloc[start:stop]["cell_id"].to_numpy()
284 |         chunk_df = pd.DataFrame(
285 |             {
286 |                 "cell_id": np.repeat(chunk_cell_ids, n_time),
287 |                 "time_bin_index_30min": np.tile(np.arange(n_time, dtype=np.int32), len(chunk_cell_ids)),
288 |                 "time_bin_start_min": np.tile(time_edges[:-1], len(chunk_cell_ids)),
289 |                 "time_bin_end_min": np.tile(time_edges[1:], len(chunk_cell_ids)),
290 |                 "event_count": chunk_counts.reshape(-1),
291 |             }
292 |         )
293 |         records.append(chunk_df)
294 |         log(f"  Expanded matrix chunk {start:,}:{stop:,} to long-form rows")
295 |     long_df = pd.concat(records, ignore_index=True)
296 |     return long_df, counts
