103 | def project_points(lons: np.ndarray, lats: np.ndarray, transformer: Transformer) -> Tuple[np.ndarray, np.ndarray]:
104 |     x_m, y_m = transformer.transform(lons, lats)
105 |     return np.asarray(x_m) / 1000.0, np.asarray(y_m) / 1000.0
106 | 
107 | 
108 | def polygon_area_km2(points: np.ndarray) -> float:
109 |     x = points[:, 0]
110 |     y = points[:, 1]
111 |     return 0.5 * abs(np.dot(x, np.roll(y, -1)) - np.dot(y, np.roll(x, -1)))
112 | 
113 | 
114 | def compute_buffered_hull_area(points_xy: np.ndarray, buffer_km: float) -> Tuple[float, np.ndarray]:
115 |     if len(points_xy) < 3:
116 |         x_min, y_min = points_xy.min(axis=0) - buffer_km
117 |         x_max, y_max = points_xy.max(axis=0) + buffer_km
118 |         box = np.array([[x_min, y_min], [x_max, y_min], [x_max, y_max], [x_min, y_max]])
119 |         return polygon_area_km2(box), box
120 |     hull = ConvexHull(points_xy)
121 |     hull_points = points_xy[hull.vertices]
122 |     perimeter = np.sum(np.sqrt(np.sum(np.diff(np.vstack([hull_points, hull_points[0]]), axis=0) ** 2, axis=1)))
123 |     area = polygon_area_km2(hull_points)
124 |     buffered_area = area + perimeter * buffer_km + math.pi * buffer_km * buffer_km
125 |     return buffered_area, hull_points
126 | 
127 | 
128 | def circular_difference_deg(a: float, b: float) -> float:
129 |     d = abs(a - b) % 360.0
130 |     return min(d, 360.0 - d)
131 | 
132 | 
133 | def compute_orientation_family_from_faults(
134 |     faults: List[np.ndarray], transformer: Transformer
135 | ) -> Tuple[pd.DataFrame, List[float]]:
136 |     orientations = []
137 |     lengths = []
138 |     for seg in faults:
139 |         x, y = project_points(seg[:, 0], seg[:, 1], transformer)
140 |         dx = np.diff(x)
141 |         dy = np.diff(y)
142 |         seg_len = np.sqrt(dx ** 2 + dy ** 2)
143 |         good = seg_len > 0
144 |         if np.any(good):
145 |             az = (np.degrees(np.arctan2(dy[good], dx[good])) + 360.0) % 180.0
146 |             orientations.extend(az.tolist())
147 |             lengths.extend(seg_len[good].tolist())
148 |     if not orientations:
149 |         return pd.DataFrame(columns=['orientation_deg', 'weight']), []
150 |     orientations = np.asarray(orientations)
151 |     lengths = np.asarray(lengths)
152 |     bins = np.arange(0.0, 185.0, 5.0)
153 |     bin_idx = np.digitize(orientations, bins) - 1
154 |     rows = []
155 |     for i in range(len(bins) - 1):
156 |         mask = bin_idx == i
157 |         if np.any(mask):
158 |             rows.append({'orientation_deg': (bins[i] + bins[i + 1]) / 2.0, 'weight': float(lengths[mask].sum())})
159 |     df = pd.DataFrame(rows).sort_values('weight', ascending=False)
160 |     top_orients = df.head(4)['orientation_deg'].tolist()
161 |     return df, top_orients
162 | 
