372 | def select_radii_from_catalog(coords_xy: np.ndarray) -> np.ndarray:
373 |     sample_n = min(len(coords_xy), 4000)
374 |     if len(coords_xy) > sample_n:
375 |         rng = np.random.default_rng(42)
376 |         idx = rng.choice(len(coords_xy), size=sample_n, replace=False)
377 |         sample = coords_xy[idx]
378 |     else:
379 |         sample = coords_xy
380 |     if len(sample) < 3:
381 |         return np.array([1.0, 2.0, 3.0, 5.0, 8.0])
382 |     dist_matrix = cdist(sample, sample)
383 |     np.fill_diagonal(dist_matrix, np.inf)
384 |     nn = np.min(dist_matrix, axis=1)
385 |     finite_nn = nn[np.isfinite(nn)]
386 |     q = np.quantile(finite_nn, [0.5, 0.75, 0.9]) if len(finite_nn) else np.array([0.5, 1.0, 2.0])
387 |     base = np.unique(np.clip(np.array([q[0] * 2, q[1] * 3, q[2] * 4, 3.0, 5.0, 8.0, 12.0]), 0.5, 20.0))
388 |     return np.round(np.sort(base), 2)
