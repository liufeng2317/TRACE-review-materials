 86 | def load_faults(path: Path) -> List[np.ndarray]:
 87 |     with path.open('r', encoding='utf-8') as f:
 88 |         data = json.load(f)
 89 |     faults = []
 90 |     for seg in data:
 91 |         arr = np.asarray(seg, dtype=float)
 92 |         if arr.ndim == 2 and arr.shape[1] == 2 and len(arr) >= 2:
 93 |             faults.append(arr)
 94 |     return faults
