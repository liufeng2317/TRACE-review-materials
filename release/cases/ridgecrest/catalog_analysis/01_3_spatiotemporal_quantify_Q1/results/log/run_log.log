            whole_window_duration_hours: 4
            near_mainshock64_count: 8
            near_mainshock64_duration: single_30min_interval
            near_mainshock71_count: 8
            near_mainshock71_duration: single_30min_interval
          empty_window_adjustment: nearest_non_empty_deterministic
          projection_strategy: local_cartesian_centered_on_sequence
      - name: define_study_window_and_scale_selection
        description: Define the fixed study region, normalization protocol, candidate radii, and characteristic radius used across all directional analyses.
        inputs:
          - analysis_catalog
          - projected_fault_polylines
        outputs:
          - study_window_definition
          - radius_diagnostic_table
          - directional_parameter_table
          - scale_selection_summary
        params:
          sector_width_degrees: 5
          azimuth_domain_degrees:
            start: 0
            stop: 360
          study_window_strategy: buffered_sequence_footprint
          normalization_basis: fixed_area_and_interval_density
          candidate_radius_strategy: data_driven_from_neighbor_and_pair_distance_diagnostics
          characteristic_radius_rule: smallest_stable_radius_with_adequate_interval_support
          insufficient_data_thresholds:
            min_events_per_interval: data_driven_documented
            min_pairs_within_characteristic_radius: data_driven_documented
          edge_treatment: fixed_comparative_domain_with_documented_limitation_if_no_formal_correction
      - name: compute_interval_directional_ripley_statistics
        description: Compute interval-wise sector-based directional Ripley K and L statistics in parallel and summarize dominant directional features.
        inputs:
