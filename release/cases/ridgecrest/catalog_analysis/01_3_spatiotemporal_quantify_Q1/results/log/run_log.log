          - study_window_definition
          - directional_parameter_table
        outputs:
          - full_directional_ripley_statistics
          - characteristic_scale_direction_matrix
          - interval_directional_summary
          - interval_runtime_log
        params:
          parallel_workers_max: 64
          parallelization_unit: time_interval
          sector_count: 72
          compute_products:
            - K_by_radius_and_sector
            - L_by_radius_and_sector
            - L_at_characteristic_radius
            - dominant_azimuth
            - secondary_azimuth
            - anisotropy_metric
