164 | def choose_representative_indices(valid_indices: Sequence[int], n_select: int) -> List[int]:
165 |     valid_indices = sorted(set(int(i) for i in valid_indices))
166 |     if not valid_indices:
167 |         return []
168 |     if len(valid_indices) <= n_select:
169 |         return valid_indices
170 |     target = np.linspace(0, len(valid_indices) - 1, n_select)
171 |     chosen = []
172 |     used = set()
173 |     for t in target:
174 |         candidates = np.argsort(np.abs(np.arange(len(valid_indices)) - t))
175 |         for c in candidates:
176 |             idx = valid_indices[int(c)]
177 |             if idx not in used:
178 |                 chosen.append(idx)
179 |                 used.add(idx)
180 |                 break
181 |     return sorted(chosen)
182 | 
183 | 
184 | def pairwise_directional_counts(coords_xy: np.ndarray, r_values_km: np.ndarray) -> Tuple[np.ndarray, np.ndarray, np.ndarray]:
185 |     n = len(coords_xy)
186 |     counts = np.zeros((len(r_values_km), N_SECTORS), dtype=np.float64)
187 |     pair_counts_r = np.zeros(len(r_values_km), dtype=np.int64)
188 |     pair_total = 0
189 |     if n < 2:
190 |         return counts, pair_counts_r, np.array([], dtype=float)
191 |     max_r = float(np.max(r_values_km))
192 |     for start in range(0, n - 1, PAIR_BLOCK_SIZE):
193 |         end = min(n - 1, start + PAIR_BLOCK_SIZE)
194 |         xi = coords_xy[start:end]
195 |         for i_local, i in enumerate(range(start, end)):
196 |             diff = coords_xy[i + 1:] - xi[i_local]
197 |             if diff.size == 0:
198 |                 continue
199 |             dist = np.sqrt(np.sum(diff ** 2, axis=1))
200 |             keep = dist <= max_r
201 |             if not np.any(keep):
202 |                 continue
203 |             diff = diff[keep]
204 |             dist = dist[keep]
205 |             az = (np.degrees(np.arctan2(diff[:, 1], diff[:, 0])) + 360.0) % 360.0
206 |             pair_total += len(dist)
207 |             sector_idx = np.floor(az / SECTOR_WIDTH_DEG).astype(int) % N_SECTORS
208 |             for ir, r in enumerate(r_values_km):
209 |                 m = dist <= r
210 |                 if not np.any(m):
211 |                     continue
212 |                 pair_counts_r[ir] += int(np.count_nonzero(m))
213 |                 binc = np.bincount(sector_idx[m], minlength=N_SECTORS)
214 |                 counts[ir] += binc
215 |     return counts, pair_counts_r, np.array([pair_total], dtype=float)
216 | 
217 | 
218 | def sector_ripley_for_coords(coords_xy: np.ndarray, params: RipleyParams) -> Dict[str, np.ndarray]:
219 |     n = len(coords_xy)
220 |     empty = {
221 |         'K_by_r_theta': np.full((len(params.r_values_km), N_SECTORS), np.nan, dtype=float),
222 |         'L_by_r_theta': np.full((len(params.r_values_km), N_SECTORS), np.nan, dtype=float),
223 |         'pair_counts_r': np.zeros(len(params.r_values_km), dtype=int),
224 |         'event_count': np.array([n], dtype=int),
225 |         'pair_total_within_rmax': np.array([0], dtype=int),
226 |     }
227 |     if n < 2:
228 |         return empty
229 |     counts, pair_counts_r, pair_total = pairwise_directional_counts(coords_xy, params.r_values_km)
230 |     density_factor = params.study_area_km2 / (n * (n - 1))
231 |     sector_fraction = params.sector_width_deg / 360.0
232 |     K = density_factor * counts / sector_fraction
233 |     L = np.sqrt(np.maximum(K, 0.0) / math.pi)
234 |     return {
235 |         'K_by_r_theta': K,
236 |         'L_by_r_theta': L,
237 |         'pair_counts_r': pair_counts_r,
238 |         'event_count': np.array([n], dtype=int),
239 |         'pair_total_within_rmax': pair_total.astype(int),
240 |     }
241 | 
242 | 
243 | def smooth_circular(values: np.ndarray, passes: int = 1) -> np.ndarray:
244 |     out = values.astype(float).copy()
245 |     for _ in range(passes):
246 |         out = 0.25 * np.roll(out, 1) + 0.5 * out + 0.25 * np.roll(out, -1)
247 |     return out
248 | 
249 | 
250 | def extract_direction_metrics(L_theta: np.ndarray, pair_count: int, params: RipleyParams) -> Dict[str, float]:
251 |     result = {
252 |         'dominant_azimuth_deg': np.nan,
253 |         'secondary_azimuth_deg': np.nan,
254 |         'anisotropy_strength': np.nan,
255 |         'circular_resultant': np.nan,
256 |         'valid': False,
257 |     }
258 |     if np.any(~np.isfinite(L_theta)) or pair_count < params.min_pairs:
259 |         return result
260 |     sm = smooth_circular(L_theta, passes=1)
261 |     dominant_idx = int(np.nanargmax(sm))
262 |     dominant = float(AZIMUTH_CENTERS[dominant_idx])
263 |     exclusion = 3
264 |     candidate = sm.copy()
265 |     for k in range(-exclusion, exclusion + 1):
266 |         candidate[(dominant_idx + k) % N_SECTORS] = -np.inf
267 |     secondary_idx = int(np.argmax(candidate)) if np.isfinite(candidate).any() else dominant_idx
268 |     secondary = float(AZIMUTH_CENTERS[secondary_idx])
269 |     mean_val = float(np.nanmean(sm))
270 |     max_val = float(np.nanmax(sm))
271 |     min_val = float(np.nanmin(sm))
272 |     anis = (max_val - mean_val) / (abs(mean_val) + 1e-9)
273 |     weights = np.maximum(sm - min_val, 0.0) + 1e-6
274 |     ang = np.deg2rad(AZIMUTH_CENTERS)
275 |     resultant = np.sqrt((np.sum(weights * np.cos(ang)) / np.sum(weights)) ** 2 + (np.sum(weights * np.sin(ang)) / np.sum(weights)) ** 2)
276 |     result.update(
277 |         {
278 |             'dominant_azimuth_deg': dominant,
279 |             'secondary_azimuth_deg': secondary,
280 |             'anisotropy_strength': anis,
281 |             'circular_resultant': float(resultant),
282 |             'valid': True,
283 |         }
284 |     )
285 |     return result
286 | 
287 | 
288 | def compute_interval_job(args: Tuple[int, np.ndarray, RipleyParams]) -> Dict[str, object]:
289 |     interval_id, coords_xy, params = args
290 |     stats = sector_ripley_for_coords(coords_xy, params)
291 |     r_star_idx = int(np.argmin(np.abs(params.r_values_km - params.r_star_km)))
292 |     L_star = stats['L_by_r_theta'][r_star_idx]
293 |     pair_count_star = int(stats['pair_counts_r'][r_star_idx])
294 |     metrics = extract_direction_metrics(L_star, pair_count_star, params)
295 |     return {
296 |         'interval_id': interval_id,
297 |         'K_by_r_theta': stats['K_by_r_theta'],
298 |         'L_by_r_theta': stats['L_by_r_theta'],
299 |         'pair_counts_r': stats['pair_counts_r'],
300 |         'event_count': int(stats['event_count'][0]),
301 |         'pair_total_within_rmax': int(stats['pair_total_within_rmax'][0]),
302 |         'L_theta_rstar': L_star,
303 |         'pair_count_rstar': pair_count_star,
304 |         **metrics,
305 |     }
