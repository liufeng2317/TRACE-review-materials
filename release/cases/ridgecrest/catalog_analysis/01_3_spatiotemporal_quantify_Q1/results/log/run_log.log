313 | def build_representative_windows(
314 |     interval_df: pd.DataFrame,
315 |     analysis_start: pd.Timestamp,
316 |     analysis_end: pd.Timestamp,
317 |     t64: pd.Timestamp,
318 |     t71: pd.Timestamp,
319 | ) -> pd.DataFrame:
320 |     rows = []
321 | 
322 |     total_duration_h = (analysis_end - analysis_start).total_seconds() / 3600.0
323 |     if total_duration_h <= WHOLE_WINDOW_HOURS:
324 |         start_times = [analysis_start]
325 |     else:
326 |         offsets_h = np.linspace(0.0, total_duration_h - WHOLE_WINDOW_HOURS, N_REP_WINDOWS)
327 |         start_times = [analysis_start + pd.Timedelta(hours=float(h)) for h in offsets_h]
328 |     for i, st in enumerate(start_times):
329 |         et = min(st + pd.Timedelta(hours=WHOLE_WINDOW_HOURS), analysis_end)
330 |         rows.append({'figure_group': 'whole_window_4h', 'window_rank': i + 1, 'window_start': st, 'window_end': et})
331 | 
332 |     after64 = interval_df[(interval_df['start_time'] >= t64) & (interval_df['start_time'] < t71)]
333 |     before71 = interval_df[(interval_df['start_time'] < t71) & (interval_df['end_time'] > t64)]
334 | 
335 |     idx_after64 = choose_representative_indices(after64['interval_id'].tolist(), N_REP_WINDOWS)
336 |     idx_before71 = choose_representative_indices(before71['interval_id'].tolist(), N_REP_WINDOWS)
337 | 
338 |     for i, iid in enumerate(idx_after64):
339 |         row = interval_df.loc[interval_df['interval_id'] == iid].iloc[0]
340 |         rows.append({'figure_group': 'near_mainshock64_30m', 'window_rank': i + 1, 'window_start': row['start_time'], 'window_end': row['end_time'], 'interval_id': iid})
341 |     for i, iid in enumerate(idx_before71):
342 |         row = interval_df.loc[interval_df['interval_id'] == iid].iloc[0]
343 |         rows.append({'figure_group': 'near_mainshock71_30m', 'window_rank': i + 1, 'window_start': row['start_time'], 'window_end': row['end_time'], 'interval_id': iid})
344 | 
345 |     rep_df = pd.DataFrame(rows)
346 |     rep_df['window_label'] = rep_df['figure_group'] + '_w' + rep_df['window_rank'].astype(str)
347 |     return rep_df
