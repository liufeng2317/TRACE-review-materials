350 | def compute_fault_and_connection_metrics(
351 |     interval_summary: pd.DataFrame,
352 |     mainshock_df: pd.DataFrame,
353 |     top_fault_orients: List[float],
354 | ) -> pd.DataFrame:
355 |     ms64 = mainshock_df.loc[mainshock_df['label'] == 'Mainshock64'].iloc[0]
356 |     ms71 = mainshock_df.loc[mainshock_df['label'] == 'Mainshock71'].iloc[0]
357 |     connection_az = (math.degrees(math.atan2(ms71['y_km'] - ms64['y_km'], ms71['x_km'] - ms64['x_km'])) + 360.0) % 360.0
358 |     interval_summary = interval_summary.copy()
359 |     interval_summary['dominant_to_ms64_ms71_deg'] = interval_summary['dominant_azimuth_deg'].apply(
360 |         lambda x: circular_difference_deg(x, connection_az) if pd.notnull(x) else np.nan
361 |     )
362 |     if top_fault_orients:
363 |         doubled = top_fault_orients + [o + 180.0 for o in top_fault_orients]
364 |         interval_summary['dominant_to_fault_family_deg'] = interval_summary['dominant_azimuth_deg'].apply(
365 |             lambda x: min(circular_difference_deg(x, o) for o in doubled) if pd.notnull(x) else np.nan
366 |         )
367 |     else:
368 |         interval_summary['dominant_to_fault_family_deg'] = np.nan
369 |     return interval_summary
