517 | def compute_window_stats(window_events: pd.DataFrame, params: RipleyParams) -> Dict[str, object]:
518 |     coords = window_events[['x_km', 'y_km']].to_numpy(dtype=float)
519 |     stats = sector_ripley_for_coords(coords, params)
520 |     r_idx = int(np.argmin(np.abs(params.r_values_km - params.r_star_km)))
521 |     L_theta = stats['L_by_r_theta'][r_idx]
522 |     pair_count = int(stats['pair_counts_r'][r_idx])
523 |     metrics = extract_direction_metrics(L_theta, pair_count, params)
524 |     return {
525 |         'event_count': len(window_events),
526 |         'pair_count_rstar': pair_count,
527 |         'L_theta_rstar': L_theta,
528 |         **metrics,
529 |     }
