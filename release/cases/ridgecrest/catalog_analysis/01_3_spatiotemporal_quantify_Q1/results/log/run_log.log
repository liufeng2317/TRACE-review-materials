 97 | def infer_local_crs(lon0: float, lat0: float) -> CRS:
 98 |     zone = int(math.floor((lon0 + 180.0) / 6.0) + 1)
 99 |     epsg = 32600 + zone if lat0 >= 0 else 32700 + zone
100 |     return CRS.from_epsg(epsg)
