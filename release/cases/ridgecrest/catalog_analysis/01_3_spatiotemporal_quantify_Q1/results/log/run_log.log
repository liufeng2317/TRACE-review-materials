504 | def add_rose_inset(ax, theta_values: np.ndarray, title: str = '') -> None:
505 |     inset = inset_axes(ax, width='33%', height='33%', loc='upper right', axes_class=plt.PolarAxes)
506 |     angles = np.deg2rad(np.r_[AZIMUTH_CENTERS, AZIMUTH_CENTERS[0]])
507 |     vals = np.r_[theta_values, theta_values[0]]
508 |     base = np.nanmin(vals[np.isfinite(vals)]) if np.isfinite(vals).any() else 0.0
509 |     vals = vals - base + 1e-6
510 |     inset.fill(angles, vals, color='tab:orange', alpha=0.6)
511 |     inset.plot(angles, vals, color='tab:red', lw=1.0)
512 |     inset.set_xticks(np.deg2rad([0, 90, 180, 270]))
513 |     inset.set_yticks([])
514 |     inset.set_title(title, fontsize=7, pad=2)
