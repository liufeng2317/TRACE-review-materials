148 |     if t_min <= 0 or t_max <= t_min:
149 |         return np.nan
150 |     if abs(p - 1.0) < 1e-8:
151 |         return math.log(t_max / t_min)
152 |     exponent = 1.0 - p
153 |     return (t_max ** exponent - t_min ** exponent) / exponent
