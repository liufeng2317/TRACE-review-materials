 93 | def project_points(df: pd.DataFrame, transformer: Transformer) -> pd.DataFrame:
 94 |     x_m, y_m = transformer.transform(df['longitude'].to_numpy(), df['latitude'].to_numpy())
 95 |     out = df.copy()
 96 |     out['x_m'] = x_m
 97 |     out['y_m'] = y_m
 98 |     out['x_km'] = out['x_m'] / 1000.0
 99 |     out['y_km'] = out['y_m'] / 1000.0
100 |     return out
