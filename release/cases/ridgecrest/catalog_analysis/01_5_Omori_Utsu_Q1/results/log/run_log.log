340 | def bootstrap_worker(times: np.ndarray, n_boot: int, seed: int) -> dict[str, Any]:
341 |     rng = np.random.default_rng(seed)
342 |     times = np.asarray(times, dtype=float)
343 |     n = len(times)
344 |     p_values = []
345 |     failures = 0
346 |     for _ in range(n_boot):
347 |         sample = rng.choice(times, size=n, replace=True)
348 |         ok, payload = mle_pure_power_from_times(np.sort(sample))
349 |         if ok:
350 |             p_values.append(float(payload['p_fit']))
351 |         else:
352 |             failures += 1
353 |     return {'p_values': p_values, 'failures': failures}
