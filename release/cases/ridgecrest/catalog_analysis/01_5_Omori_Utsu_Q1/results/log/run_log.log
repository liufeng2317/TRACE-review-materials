178 |             a = t_max ** exponent
179 |             b = t_min ** exponent
180 |             j = (a - b) / exponent
181 |             da = -math.log(t_max) * a
182 |             db = -math.log(t_min) * b
183 |             dj = ((da - db) * exponent + (a - b)) / (exponent ** 2)
184 |         return -sum_log_t - n * dj / j
