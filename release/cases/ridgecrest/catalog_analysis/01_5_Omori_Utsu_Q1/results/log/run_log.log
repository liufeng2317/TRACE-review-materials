356 | def summarize_bootstrap(result_row: pd.Series, times: np.ndarray, max_workers: int) -> dict[str, Any]:
357 |     if not bool(result_row['success_flag']):
358 |         return {
359 |             'domain_label': result_row['domain_label'],
360 |             'period_days': float(result_row['period_days']),
361 |             'bootstrap_replicates_requested': BOOTSTRAP_REPLICATES,
362 |             'bootstrap_success_count': 0,
363 |             'bootstrap_failure_count': 0,
364 |             'bootstrap_success_fraction': np.nan,
365 |             'bootstrap_p_median': np.nan,
366 |             'bootstrap_p_q025': np.nan,
367 |             'bootstrap_p_q975': np.nan,
368 |             'bootstrap_warning': 'primary_fit_failed',
369 |         }
370 |     n_workers = max(1, min(max_workers, 8, BOOTSTRAP_REPLICATES))
371 |     replicate_splits = [BOOTSTRAP_REPLICATES // n_workers] * n_workers
372 |     for i in range(BOOTSTRAP_REPLICATES % n_workers):
373 |         replicate_splits[i] += 1
374 |     seeds = np.random.SeedSequence(20250707 + int(round(1000 * float(result_row['period_days'])))).spawn(n_workers)
375 |     futures = []
376 |     all_ps: list[float] = []
377 |     fail_count = 0
378 |     with ProcessPoolExecutor(max_workers=n_workers) as ex:
379 |         for child_seed, n_boot in zip(seeds, replicate_splits):
380 |             if n_boot <= 0:
381 |                 continue
382 |             futures.append(ex.submit(bootstrap_worker, times, int(n_boot), int(child_seed.generate_state(1)[0])))
383 |         for future in as_completed(futures):
384 |             out = future.result()
385 |             all_ps.extend(out['p_values'])
386 |             fail_count += int(out['failures'])
387 |     success_count = len(all_ps)
388 |     success_fraction = success_count / BOOTSTRAP_REPLICATES if BOOTSTRAP_REPLICATES > 0 else np.nan
389 |     warning = ''
390 |     if success_count == 0:
391 |         warning = 'all_bootstrap_replicates_failed'
392 |         return {
393 |             'domain_label': result_row['domain_label'],
394 |             'period_days': float(result_row['period_days']),
395 |             'bootstrap_replicates_requested': BOOTSTRAP_REPLICATES,
396 |             'bootstrap_success_count': 0,
397 |             'bootstrap_failure_count': int(fail_count),
398 |             'bootstrap_success_fraction': success_fraction,
399 |             'bootstrap_p_median': np.nan,
400 |             'bootstrap_p_q025': np.nan,
401 |             'bootstrap_p_q975': np.nan,
402 |             'bootstrap_warning': warning,
403 |         }
404 |     arr = np.asarray(all_ps, dtype=float)
405 |     if success_fraction < 0.8:
406 |         warning = 'bootstrap_success_fraction_below_0p8'
407 |     return {
408 |         'domain_label': result_row['domain_label'],
409 |         'period_days': float(result_row['period_days']),
410 |         'bootstrap_replicates_requested': BOOTSTRAP_REPLICATES,
411 |         'bootstrap_success_count': int(success_count),
412 |         'bootstrap_failure_count': int(fail_count),
413 |         'bootstrap_success_fraction': float(success_fraction),
414 |         'bootstrap_p_median': float(np.nanmedian(arr)),
415 |         'bootstrap_p_q025': float(np.nanpercentile(arr, 2.5)),
416 |         'bootstrap_p_q975': float(np.nanpercentile(arr, 97.5)),
417 |         'bootstrap_warning': warning,
418 |     }
