 61 | def build_local_transformer() -> tuple[Transformer, Transformer, CRS]:
 62 |     lon0 = (CENTERLINE_START_LON + CENTERLINE_END_LON) / 2.0
 63 |     lat0 = (CENTERLINE_START_LAT + CENTERLINE_END_LAT) / 2.0
 64 |     crs_local = CRS.from_proj4(
 65 |         f'+proj=aeqd +lat_0={lat0} +lon_0={lon0} +datum=WGS84 +units=m +no_defs'
 66 |     )
 67 |     forward = Transformer.from_crs('EPSG:4326', crs_local, always_xy=True)
 68 |     inverse = Transformer.from_crs(crs_local, 'EPSG:4326', always_xy=True)
 69 |     return forward, inverse, crs_local
