 85 | def identify_mainshocks(mainshocks: pd.DataFrame) -> tuple[pd.Series, pd.Series]:
 86 |     ms64 = mainshocks.loc[np.isclose(mainshocks['magnitude'], 6.4)]
 87 |     ms71 = mainshocks.loc[np.isclose(mainshocks['magnitude'], 7.1)]
 88 |     if len(ms64) != 1 or len(ms71) != 1:
