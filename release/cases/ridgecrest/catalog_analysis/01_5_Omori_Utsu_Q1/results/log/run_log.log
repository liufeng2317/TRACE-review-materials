103 | def assign_corridor_domains(interevent: pd.DataFrame, transformer: Transformer) -> tuple[pd.DataFrame, CorridorGeometry, dict[str, np.ndarray]]:
104 |     sx, sy = transformer.transform(CENTERLINE_START_LON, CENTERLINE_START_LAT)
105 |     ex, ey = transformer.transform(CENTERLINE_END_LON, CENTERLINE_END_LAT)
106 |     start = np.array([sx, sy], dtype=float)
107 |     end = np.array([ex, ey], dtype=float)
108 |     vec = end - start
109 |     length_m = float(np.hypot(vec[0], vec[1]))
110 |     if not np.isfinite(length_m) or length_m <= 0:
111 |         raise ValueError('Invalid centerline length.')
112 |     u = vec / length_m
113 |     left_normal = np.array([-u[1], u[0]], dtype=float)
114 | 
115 |     pts = interevent[['x_m', 'y_m']].to_numpy(dtype=float)
116 |     rel = pts - start[None, :]
117 |     along_m = rel @ u
118 |     cross_m = rel @ left_normal
119 | 
120 |     in_segment = (along_m >= 0.0) & (along_m <= length_m)
121 |     in_width = np.abs(cross_m) <= HALF_WIDTH_KM * 1000.0
122 |     in_entire = in_segment & in_width
123 | 
124 |     out = interevent.copy()
125 |     out['along_strike_km'] = along_m / 1000.0
126 |     out['cross_strike_km'] = cross_m / 1000.0
127 |     out['in_entire_corridor'] = in_entire
128 | 
129 |     lat = out['latitude'].to_numpy()
130 |     for split in SPLIT_LATS:
131 |         token = f'{split:.2f}'.replace('.', 'p')
132 |         out[f'on_split_{token}'] = np.zeros(len(out), dtype=bool)
133 |         out[f'north_{token}'] = in_entire & (lat > split)
134 |         out[f'south_{token}'] = in_entire & (lat < split)
135 | 
136 |     corners = np.array([
137 |         start + left_normal * HALF_WIDTH_KM * 1000.0,
138 |         end + left_normal * HALF_WIDTH_KM * 1000.0,
139 |         end - left_normal * HALF_WIDTH_KM * 1000.0,
140 |         start - left_normal * HALF_WIDTH_KM * 1000.0,
141 |         start + left_normal * HALF_WIDTH_KM * 1000.0,
142 |     ])
143 | 
144 |     geometry = CorridorGeometry(
145 |         strike_deg=STRIKE_DEG,
146 |         centerline_start_lon=CENTERLINE_START_LON,
147 |         centerline_start_lat=CENTERLINE_START_LAT,
148 |         centerline_end_lon=CENTERLINE_END_LON,
149 |         centerline_end_lat=CENTERLINE_END_LAT,
150 |         total_width_km=CORRIDOR_WIDTH_KM,
151 |         half_width_km=HALF_WIDTH_KM,
152 |         centerline_length_km=length_m / 1000.0,
153 |     )
154 |     plot_arrays = {
155 |         'centerline_xy_m': np.vstack([start, end]),
156 |         'corridor_polygon_xy_m': corners,
157 |     }
158 |     return out, geometry, plot_arrays
