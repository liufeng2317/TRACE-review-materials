129 | def parse_time_columns(df: pd.DataFrame, columns: list[str]) -> pd.DataFrame:
130 |     out = df.copy()
131 |     for col in columns:
132 |         out[col] = pd.to_datetime(out[col], utc=True, errors="raise")
133 |     return out
