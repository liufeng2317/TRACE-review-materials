320 |         stage = str(df["stage_label"].iloc[0])
321 |         summary[f"{family}__{stage}"] = {
322 |             "n_windows": int(len(df)),
323 |             "start_time": df["start_time"].min().isoformat(),
324 |             "end_time": df["end_time"].max().isoformat(),
