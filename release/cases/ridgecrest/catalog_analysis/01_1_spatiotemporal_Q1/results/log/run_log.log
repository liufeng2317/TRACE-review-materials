198 | 
199 | def project_to_local_xy(longitude: np.ndarray, latitude: np.ndarray, origin_lon: float, origin_lat: float) -> tuple[np.ndarray, np.ndarray]:
200 |     earth_radius_km = 6371.0
201 |     lon_rad = np.deg2rad(longitude)
202 |     lat_rad = np.deg2rad(latitude)
203 |     origin_lon_rad = math.radians(origin_lon)
204 |     origin_lat_rad = math.radians(origin_lat)
205 |     x = earth_radius_km * (lon_rad - origin_lon_rad) * math.cos(origin_lat_rad)
206 |     y = earth_radius_km * (lat_rad - origin_lat_rad)
207 |     return x, y
208 | 
209 | 
210 | def attach_projection_origin(catalog: pd.DataFrame, extent: dict[str, Any]) -> pd.DataFrame:
211 |     out = catalog.copy()
212 |     out.attrs["projection_origin_longitude"] = float(extent["projection_origin_longitude"])
213 |     out.attrs["projection_origin_latitude"] = float(extent["projection_origin_latitude"])
214 |     return out
