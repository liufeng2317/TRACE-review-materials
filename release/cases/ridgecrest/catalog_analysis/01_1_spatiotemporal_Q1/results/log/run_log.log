301 | def write_csv(df: pd.DataFrame, path: Path) -> None:
302 |     out = df.copy()
303 |     for col in out.columns:
304 |         if pd.api.types.is_datetime64_any_dtype(out[col]):
305 |             out[col] = out[col].dt.strftime("%Y-%m-%dT%H:%M:%S.%fZ")
306 |     out.to_csv(path, index=False)
307 |     log(f"[INFO] Wrote CSV: {path}")
