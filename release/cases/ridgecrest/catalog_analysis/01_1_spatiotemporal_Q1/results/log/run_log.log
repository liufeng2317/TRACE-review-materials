729 |         **proj_metrics,
730 |         "centroid_distance_to_mainshock64_km": d64,
731 |         "centroid_azimuth_from_mainshock64_deg": a64,
732 |         "centroid_distance_to_mainshock71_km": d71,
733 |         "centroid_azimuth_from_mainshock71_deg": a71,
734 |         "hotspot_x_km_local": hx,
735 |         "hotspot_y_km_local": hy,
736 |         "hotspot_density_value": hd,
737 |     }
