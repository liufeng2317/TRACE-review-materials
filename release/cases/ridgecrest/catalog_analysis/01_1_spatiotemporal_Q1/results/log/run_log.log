 92 | def clean_catalog(df: pd.DataFrame, label: str) -> tuple[pd.DataFrame, dict]:
 93 |     original_count = len(df)
 94 |     qc = {
 95 |         "dataset_label": label,
 96 |         "rows_original": int(original_count),
 97 |         "rows_dropped_missing_required": 0,
 98 |         "rows_dropped_invalid_time": 0,
 99 |         "rows_dropped_invalid_numeric": 0,
100 |         "rows_dropped_nonfinite_coordinates": 0,
101 |         "rows_final": None,
102 |         "time_min": None,
103 |         "time_max": None,
104 |     }
105 | 
106 |     working = df.copy()
107 |     working = working[EXPECTED_COLUMNS].copy()
108 | 
109 |     missing_mask = working[["event_time", "latitude", "longitude"]].isna().any(axis=1)
110 |     qc["rows_dropped_missing_required"] = int(missing_mask.sum())
111 |     working = working.loc[~missing_mask].copy()
112 | 
113 |     working["event_time"] = pd.to_datetime(working["event_time"], utc=True, errors="coerce")
114 |     invalid_time_mask = working["event_time"].isna()
115 |     qc["rows_dropped_invalid_time"] = int(invalid_time_mask.sum())
116 |     working = working.loc[~invalid_time_mask].copy()
117 | 
118 |     for col in ["latitude", "longitude", "depth_km", "magnitude"]:
119 |         working[col] = pd.to_numeric(working[col], errors="coerce")
120 | 
121 |     invalid_numeric_mask = working[["latitude", "longitude", "depth_km", "magnitude"]].isna().any(axis=1)
122 |     qc["rows_dropped_invalid_numeric"] = int(invalid_numeric_mask.sum())
123 |     working = working.loc[~invalid_numeric_mask].copy()
124 | 
125 |     finite_mask = np.isfinite(working["latitude"]) & np.isfinite(working["longitude"])
126 |     qc["rows_dropped_nonfinite_coordinates"] = int((~finite_mask).sum())
127 |     working = working.loc[finite_mask].copy()
128 | 
129 |     working = working.sort_values("event_time", kind="mergesort").reset_index(drop=True)
130 | 
131 |     qc["rows_final"] = int(len(working))
132 |     if len(working) > 0:
133 |         qc["time_min"] = working["event_time"].min().isoformat()
134 |         qc["time_max"] = working["event_time"].max().isoformat()
135 | 
136 |     log(
137 |         f"[INFO] Cleaned {label}: original={original_count}, final={len(working)}, "
138 |         f"dropped_missing={qc['rows_dropped_missing_required']}, "
139 |         f"dropped_invalid_time={qc['rows_dropped_invalid_time']}, "
140 |         f"dropped_invalid_numeric={qc['rows_dropped_invalid_numeric']}, "
141 |         f"dropped_nonfinite_coords={qc['rows_dropped_nonfinite_coordinates']}"
142 |     )
143 | 
144 |     return working, qc
