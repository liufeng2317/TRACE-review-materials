575 | def compute_window_family_metrics(
576 |     windows_df: pd.DataFrame,
577 |     catalog: pd.DataFrame,
578 |     ms64: MainshockRef,
579 |     ms71: MainshockRef,
580 |     axis_ref: AxisReference,
581 |     family_label: str,
582 | ) -> tuple[pd.DataFrame, pd.DataFrame]:
583 |     log(f"[INFO] Computing window metrics for {family_label}: n_windows={len(windows_df)}, n_jobs={N_JOBS}")
584 |     rows = windows_df.to_dict(orient="records")
585 |     metric_records = Parallel(n_jobs=N_JOBS, backend="loky", verbose=0)(
586 |         delayed(compute_window_metrics_record)(row, catalog, ms64, ms71, axis_ref) for row in rows
587 |     )
588 |     cluster_records = Parallel(n_jobs=N_JOBS, backend="loky", verbose=0)(
589 |         delayed(compute_cluster_metrics_record)(row, catalog, ms64, axis_ref) for row in rows
590 |     )
591 |     metrics_df = pd.DataFrame(metric_records)
592 |     cluster_df = pd.DataFrame(cluster_records)
593 |     metrics_df = add_consecutive_migration_metrics(metrics_df, ["window_family", "stage_label"])
594 |     log(f"[INFO] Completed {family_label}: metrics_rows={len(metrics_df)}, cluster_rows={len(cluster_df)}")
595 |     return metrics_df, cluster_df
