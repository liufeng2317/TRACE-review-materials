    comparison_71 = read_metrics(COMPARISON_71_PATH, "comparison_71")
    migration_64_to_71 = read_json(MIGRATION_64_TO_71_PATH)
    migration_post71 = read_json(MIGRATION_POST71_PATH)

    whole_2h_table = prepare_page_table(
