186 | def build_common_extent(df: pd.DataFrame) -> dict:
187 |     lon_min = float(df["longitude"].min())
188 |     lon_max = float(df["longitude"].max())
189 |     lat_min = float(df["latitude"].min())
190 |     lat_max = float(df["latitude"].max())
191 | 
192 |     extent = {
193 |         "longitude_min": lon_min - PAD_DEGREES,
194 |         "longitude_max": lon_max + PAD_DEGREES,
195 |         "latitude_min": lat_min - PAD_DEGREES,
196 |         "latitude_max": lat_max + PAD_DEGREES,
197 |         "padding_degrees": PAD_DEGREES,
198 |         "derived_from": "full_clean_catalog",
199 |     }
200 |     return extent
