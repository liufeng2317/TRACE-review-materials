834 | def classify_orientation_change(series: pd.Series) -> str:
835 |     vals = series.dropna().to_numpy(dtype=float)
836 |     if len(vals) < 2:
837 |         return "insufficient"
838 |     spread = float(np.nanmax(vals) - np.nanmin(vals))
839 |     if spread < 20.0:
840 |         return "stable"
841 |     if spread < 45.0:
842 |         return "moderate_change"
843 |     return "strong_change"
