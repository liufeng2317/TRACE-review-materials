748 | def summarize_migration(metrics_df: pd.DataFrame, cluster_df: pd.DataFrame, label: str) -> dict[str, Any]:
749 |     merged = metrics_df.merge(
750 |         cluster_df[["window_label", "n_clusters", "dominant_cluster_fraction", "clustered_event_fraction"]],
751 |         on="window_label",
752 |         how="left",
753 |         validate="one_to_one",
754 |     )
755 |     valid = merged.loc[merged["n_events"] > 0].copy()
756 |     if valid.empty:
757 |         return {
758 |             "summary_label": label,
759 |             "n_windows_total": int(len(metrics_df)),
760 |             "n_windows_with_events": 0,
761 |             "dominant_orientation_deg": None,
762 |             "orientation_change_class": "insufficient",
763 |             "net_centroid_shift_distance_km": None,
764 |             "net_centroid_shift_azimuth_deg": None,
765 |             "cumulative_centroid_distance_km": 0.0,
766 |             "mean_centroid_step_distance_km": None,
767 |             "distance_to_target_trend_slope_km_per_hour": None,
768 |             "median_cluster_count": None,
769 |             "multi_cluster_window_fraction": None,
770 |             "dominant_cluster_fraction_median": None,
771 |         }
772 | 
773 |     first = valid.iloc[0]
774 |     last = valid.iloc[-1]
775 |     dx = float(last["centroid_x_km_local"] - first["centroid_x_km_local"])
776 |     dy = float(last["centroid_y_km_local"] - first["centroid_y_km_local"])
777 |     times = valid["window_mid_time"].astype("int64") / 1e9 / 3600.0
778 | 
779 |     target_col = "centroid_distance_to_mainshock71_km" if label == "64_to_71" else "centroid_distance_to_mainshock64_km"
780 |     slope = None
781 |     target_valid = valid.loc[valid[target_col].notna()].copy()
782 |     if len(target_valid) >= 2:
783 |         x = target_valid["window_mid_time"].astype("int64") / 1e9 / 3600.0
784 |         y = target_valid[target_col].to_numpy(dtype=float)
785 |         coeffs = np.polyfit(x, y, 1)
786 |         slope = float(coeffs[0])
787 | 
788 |     orientation_vals = valid["principal_axis_azimuth_deg"]
789 |     dominant_orientation = float(np.nanmedian(orientation_vals.to_numpy(dtype=float))) if orientation_vals.notna().any() else None
790 |     summary = {
791 |         "summary_label": label,
792 |         "n_windows_total": int(len(metrics_df)),
793 |         "n_windows_with_events": int(len(valid)),
794 |         "dominant_orientation_deg": dominant_orientation,
795 |         "orientation_change_class": classify_orientation_change(orientation_vals),
796 |         "net_centroid_shift_distance_km": float(math.hypot(dx, dy)),
797 |         "net_centroid_shift_azimuth_deg": azimuth_from_components(dx, dy),
798 |         "cumulative_centroid_distance_km": float(valid["cumulative_centroid_distance_km"].fillna(0.0).max()),
799 |         "mean_centroid_step_distance_km": (
800 |             float(valid["centroid_step_distance_km"].dropna().mean()) if valid["centroid_step_distance_km"].notna().any() else None
801 |         ),
802 |         "distance_to_target_trend_slope_km_per_hour": slope,
803 |         "median_cluster_count": float(valid["n_clusters"].median()) if valid["n_clusters"].notna().any() else None,
804 |         "multi_cluster_window_fraction": (
805 |             float((valid["n_clusters"].fillna(0) >= 2).mean()) if len(valid) > 0 else None
806 |         ),
807 |         "dominant_cluster_fraction_median": (
808 |             float(valid["dominant_cluster_fraction"].dropna().median())
809 |             if valid["dominant_cluster_fraction"].notna().any()
810 |             else None
811 |         ),
812 |     }
813 |     return summary
