552 | def add_consecutive_migration_metrics(metrics_df: pd.DataFrame, stage_group_columns: list[str]) -> pd.DataFrame:
553 |     out = metrics_df.sort_values(stage_group_columns + ["window_index"], kind="mergesort").copy()
554 |     out["prev_centroid_x_km_local"] = out.groupby(stage_group_columns)["centroid_x_km_local"].shift(1)
555 |     out["prev_centroid_y_km_local"] = out.groupby(stage_group_columns)["centroid_y_km_local"].shift(1)
556 |     out["prev_principal_axis_azimuth_deg"] = out.groupby(stage_group_columns)["principal_axis_azimuth_deg"].shift(1)
557 |     dx = out["centroid_x_km_local"] - out["prev_centroid_x_km_local"]
558 |     dy = out["centroid_y_km_local"] - out["prev_centroid_y_km_local"]
559 |     valid = dx.notna() & dy.notna()
560 |     out["centroid_step_dx_km"] = np.where(valid, dx, np.nan)
561 |     out["centroid_step_dy_km"] = np.where(valid, dy, np.nan)
562 |     out["centroid_step_distance_km"] = np.where(valid, np.hypot(dx, dy), np.nan)
563 |     out["centroid_step_azimuth_deg"] = np.where(valid, np.degrees(np.arctan2(dx, dy)), np.nan)
564 |     out["centroid_step_azimuth_deg"] = (out["centroid_step_azimuth_deg"] + 360.0) % 360.0
565 |     out["principal_axis_azimuth_change_deg"] = [
566 |         circular_difference_deg(a, b)
567 |         for a, b in zip(out["principal_axis_azimuth_deg"], out["prev_principal_axis_azimuth_deg"], strict=False)
568 |     ]
569 |     out["cumulative_centroid_distance_km"] = out.groupby(stage_group_columns)["centroid_step_distance_km"].transform(
570 |         lambda s: s.fillna(0.0).cumsum()
571 |     )
572 |     return out
573 | 
