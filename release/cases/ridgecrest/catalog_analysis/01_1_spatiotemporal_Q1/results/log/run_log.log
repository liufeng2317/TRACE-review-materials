216 | 
217 | def compute_axis_reference(ms64: MainshockRef, ms71: MainshockRef) -> AxisReference:
218 |     dx = ms71.x_km_local - ms64.x_km_local
219 |     dy = ms71.y_km_local - ms64.y_km_local
220 |     length = float(math.hypot(dx, dy))
221 |     if length <= 0.0:
222 |         raise ValueError("Mainshock64 and Mainshock71 epicenters are colocated in projected coordinates")
223 |     ux = dx / length
224 |     uy = dy / length
225 |     vx = -uy
226 |     vy = ux
227 |     azimuth = azimuth_from_components(dx, dy)
228 |     return AxisReference(ux=ux, uy=uy, vx=vx, vy=vy, azimuth_deg=azimuth, length_km=length)
229 | 
230 | 
231 | def azimuth_from_components(dx: float, dy: float) -> float:
232 |     return float((math.degrees(math.atan2(dx, dy)) + 360.0) % 360.0)
233 | 
234 | 
235 | def circular_difference_deg(a: float | None, b: float | None) -> float | None:
236 |     if a is None or b is None or pd.isna(a) or pd.isna(b):
237 |         return None
238 |     diff = (float(a) - float(b) + 180.0) % 360.0 - 180.0
239 |     return float(abs(diff))
240 | 
241 | 
242 | def robust_area_km2(x: np.ndarray, y: np.ndarray) -> float | None:
243 |     if len(x) < AREA_MIN_EVENTS:
244 |         return None
245 |     points = np.column_stack([x, y])
246 |     if np.allclose(points[:, 0], points[0, 0]) and np.allclose(points[:, 1], points[0, 1]):
247 |         return 0.0
248 |     try:
249 |         hull = ConvexHull(points)
250 |         return float(hull.volume)
251 |     except QhullError:
252 |         return None
253 | 
254 | 
255 | def principal_axis_metrics(x: np.ndarray, y: np.ndarray) -> dict[str, float | None]:
256 |     if len(x) < ORIENTATION_MIN_EVENTS:
257 |         return {
258 |             "principal_axis_azimuth_deg": None,
259 |             "major_spread_km": None,
260 |             "minor_spread_km": None,
261 |             "anisotropy_ratio": None,
262 |         }
263 |     coords = np.column_stack([x, y])
264 |     centered = coords - coords.mean(axis=0, keepdims=True)
265 |     cov = np.cov(centered, rowvar=False)
266 |     if cov.shape != (2, 2) or not np.all(np.isfinite(cov)):
267 |         return {
268 |             "principal_axis_azimuth_deg": None,
269 |             "major_spread_km": None,
270 |             "minor_spread_km": None,
271 |             "anisotropy_ratio": None,
272 |         }
273 |     eigvals, eigvecs = np.linalg.eigh(cov)
274 |     order = np.argsort(eigvals)[::-1]
275 |     eigvals = eigvals[order]
276 |     eigvecs = eigvecs[:, order]
277 |     major = max(float(eigvals[0]), 0.0)
278 |     minor = max(float(eigvals[1]), 0.0)
279 |     major_vec = eigvecs[:, 0]
280 |     azimuth = azimuth_from_components(float(major_vec[0]), float(major_vec[1]))
281 |     major_spread = math.sqrt(major)
282 |     minor_spread = math.sqrt(minor)
283 |     ratio = None if minor_spread == 0.0 else float(major_spread / minor_spread)
284 |     return {
285 |         "principal_axis_azimuth_deg": float(azimuth),
286 |         "major_spread_km": float(major_spread),
287 |         "minor_spread_km": float(minor_spread),
288 |         "anisotropy_ratio": ratio,
289 |     }
290 | 
291 | 
292 | def centroid_metrics(x: np.ndarray, y: np.ndarray, lon: np.ndarray, lat: np.ndarray) -> dict[str, float | None]:
293 |     if len(x) == 0:
294 |         return {
295 |             "centroid_x_km_local": None,
296 |             "centroid_y_km_local": None,
297 |             "centroid_longitude": None,
298 |             "centroid_latitude": None,
299 |         }
300 |     return {
301 |         "centroid_x_km_local": float(np.mean(x)),
302 |         "centroid_y_km_local": float(np.mean(y)),
303 |         "centroid_longitude": float(np.mean(lon)),
304 |         "centroid_latitude": float(np.mean(lat)),
305 |     }
306 | 
307 | 
308 | def distance_and_azimuth_from_point(cx: float | None, cy: float | None, px: float, py: float) -> tuple[float | None, float | None]:
309 |     if cx is None or cy is None:
310 |         return None, None
311 |     dx = float(cx - px)
312 |     dy = float(cy - py)
313 |     return float(math.hypot(dx, dy)), azimuth_from_components(dx, dy)
314 | 
315 | 
316 | def axis_projection_metrics(x: np.ndarray, y: np.ndarray, origin_x: float, origin_y: float, axis_ref: AxisReference) -> dict[str, float | None]:
317 |     if len(x) == 0:
318 |         return {
319 |             "along_strike_centroid_km": None,
320 |             "cross_strike_centroid_km": None,
321 |             "along_strike_spread_km": None,
322 |             "cross_strike_spread_km": None,
323 |         }
324 |     dx = x - origin_x
325 |     dy = y - origin_y
326 |     along = dx * axis_ref.ux + dy * axis_ref.uy
327 |     cross = dx * axis_ref.vx + dy * axis_ref.vy
328 |     return {
329 |         "along_strike_centroid_km": float(np.mean(along)),
330 |         "cross_strike_centroid_km": float(np.mean(cross)),
331 |         "along_strike_spread_km": float(np.std(along, ddof=1)) if len(along) >= 2 else 0.0,
332 |         "cross_strike_spread_km": float(np.std(cross, ddof=1)) if len(cross) >= 2 else 0.0,
333 |     }
334 | 
335 | 
336 | def summarize_magnitudes(mag: np.ndarray, depth: np.ndarray) -> dict[str, float | None]:
337 |     if len(mag) == 0:
338 |         return {
339 |             "magnitude_min": None,
340 |             "magnitude_max": None,
341 |             "magnitude_mean": None,
342 |             "magnitude_median": None,
343 |             "depth_mean_km": None,
344 |             "depth_median_km": None,
345 |         }
346 |     return {
347 |         "magnitude_min": float(np.min(mag)),
348 |         "magnitude_max": float(np.max(mag)),
349 |         "magnitude_mean": float(np.mean(mag)),
350 |         "magnitude_median": float(np.median(mag)),
351 |         "depth_mean_km": float(np.mean(depth)),
352 |         "depth_median_km": float(np.median(depth)),
353 |     }
354 | 
355 | 
356 | def density_center(x: np.ndarray, y: np.ndarray, step_km: float, bandwidth_km: float) -> tuple[float | None, float | None, float | None]:
357 |     if len(x) == 0:
358 |         return None, None, None
359 |     if len(x) == 1:
360 |         return float(x[0]), float(y[0]), 1.0
361 |     xmin, xmax = float(np.min(x)), float(np.max(x))
362 |     ymin, ymax = float(np.min(y)), float(np.max(y))
363 |     x_grid = np.arange(xmin - step_km, xmax + step_km + step_km, step_km)
364 |     y_grid = np.arange(ymin - step_km, ymax + step_km + step_km, step_km)
365 |     xx, yy = np.meshgrid(x_grid, y_grid)
366 |     dens = np.zeros_like(xx, dtype=float)
367 |     inv_two_sigma2 = 1.0 / (2.0 * bandwidth_km * bandwidth_km)
368 |     for xi, yi in zip(x, y, strict=False):
369 |         dens += np.exp(-(((xx - xi) ** 2 + (yy - yi) ** 2) * inv_two_sigma2))
370 |     idx = np.unravel_index(np.argmax(dens), dens.shape)
371 |     return float(xx[idx]), float(yy[idx]), float(dens[idx])
372 | 
373 | 
374 | def format_timestamp(ts: pd.Timestamp) -> str:
375 |     return ts.strftime("%Y-%m-%dT%H:%M:%S.%fZ")
376 | 
377 | 
378 | def compute_window_metrics_record(
379 |     window_row: dict[str, Any],
380 |     catalog: pd.DataFrame,
381 |     ms64: MainshockRef,
382 |     ms71: MainshockRef,
383 |     axis_ref: AxisReference,
384 | ) -> dict[str, Any]:
385 |     start = pd.Timestamp(window_row["start_time"])
386 |     end = pd.Timestamp(window_row["end_time"])
387 |     subset = catalog.loc[(catalog["event_time"] >= start) & (catalog["event_time"] < end)].copy()
388 |     n_events = int(len(subset))
389 | 
390 |     x = subset["x_km_local"].to_numpy(dtype=float)
391 |     y = subset["y_km_local"].to_numpy(dtype=float)
392 |     lon = subset["longitude"].to_numpy(dtype=float)
393 |     lat = subset["latitude"].to_numpy(dtype=float)
394 |     mag = subset["magnitude"].to_numpy(dtype=float)
395 |     depth = subset["depth_km"].to_numpy(dtype=float)
396 | 
397 |     centroid = centroid_metrics(x, y, lon, lat)
398 |     axis_metrics = principal_axis_metrics(x, y)
399 |     area = robust_area_km2(x, y)
400 |     mag_metrics = summarize_magnitudes(mag, depth)
401 |     proj_metrics = axis_projection_metrics(x, y, ms64.x_km_local, ms64.y_km_local, axis_ref)
402 | 
403 |     dist64, az64 = distance_and_azimuth_from_point(
404 |         centroid["centroid_x_km_local"], centroid["centroid_y_km_local"], ms64.x_km_local, ms64.y_km_local
405 |     )
406 |     dist71, az71 = distance_and_azimuth_from_point(
407 |         centroid["centroid_x_km_local"], centroid["centroid_y_km_local"], ms71.x_km_local, ms71.y_km_local
408 |     )
409 | 
410 |     record = {
411 |         **window_row,
412 |         "n_events": n_events,
413 |         **mag_metrics,
414 |         **centroid,
415 |         **axis_metrics,
416 |         "spatial_footprint_area_km2": area,
417 |         **proj_metrics,
418 |         "centroid_distance_to_mainshock64_km": dist64,
419 |         "centroid_azimuth_from_mainshock64_deg": az64,
420 |         "centroid_distance_to_mainshock71_km": dist71,
421 |         "centroid_azimuth_from_mainshock71_deg": az71,
422 |         "window_mid_time": start + (end - start) / 2,
423 |         "window_start_hours_since_mainshock64": (start - ms64.time).total_seconds() / 3600.0,
424 |         "window_end_hours_since_mainshock64": (end - ms64.time).total_seconds() / 3600.0,
425 |         "window_start_hours_since_mainshock71": (start - ms71.time).total_seconds() / 3600.0,
426 |         "window_end_hours_since_mainshock71": (end - ms71.time).total_seconds() / 3600.0,
427 |         "orientation_event_count_sufficient": bool(n_events >= ORIENTATION_MIN_EVENTS),
428 |         "cluster_event_count_sufficient": bool(n_events >= CLUSTER_MIN_EVENTS),
429 |     }
430 |     return record
431 | 
432 | 
433 | def compute_cluster_metrics_record(
434 |     window_row: dict[str, Any],
435 |     catalog: pd.DataFrame,
436 |     ms64: MainshockRef,
437 |     axis_ref: AxisReference,
438 | ) -> dict[str, Any]:
439 |     start = pd.Timestamp(window_row["start_time"])
440 |     end = pd.Timestamp(window_row["end_time"])
441 |     subset = catalog.loc[(catalog["event_time"] >= start) & (catalog["event_time"] < end)].copy()
442 |     n_events = int(len(subset))
443 | 
444 |     base_record = {
445 |         "global_window_id": int(window_row["global_window_id"]),
446 |         "window_family": window_row["window_family"],
447 |         "stage_label": window_row["stage_label"],
448 |         "window_index": int(window_row["window_index"]),
449 |         "window_label": window_row["window_label"],
450 |         "start_time": start,
451 |         "end_time": end,
452 |         "n_events": n_events,
453 |         "dbscan_eps_km": DBSCAN_EPS_KM,
454 |         "dbscan_min_samples": DBSCAN_MIN_SAMPLES,
455 |         "n_clusters": 0,
456 |         "n_noise_events": n_events,
457 |         "clustered_event_fraction": 0.0 if n_events > 0 else None,
458 |         "dominant_cluster_fraction": None,
459 |         "dominant_cluster_event_count": None,
460 |         "dominant_cluster_centroid_longitude": None,
461 |         "dominant_cluster_centroid_latitude": None,
462 |         "dominant_cluster_centroid_x_km_local": None,
463 |         "dominant_cluster_centroid_y_km_local": None,
464 |         "dominant_cluster_azimuth_from_mainshock64_deg": None,
465 |         "dominant_cluster_distance_from_mainshock64_km": None,
466 |         "dominant_cluster_along_strike_km": None,
467 |         "dominant_cluster_cross_strike_km": None,
468 |         "cluster_size_json": json.dumps([], sort_keys=True),
469 |         "cluster_centroids_json": json.dumps([], sort_keys=True),
470 |         "cluster_azimuths_from_mainshock64_json": json.dumps([], sort_keys=True),
471 |     }
472 |     if n_events < CLUSTER_MIN_EVENTS:
473 |         return base_record
474 | 
475 |     coords = subset[["x_km_local", "y_km_local"]].to_numpy(dtype=float)
476 |     labels = DBSCAN(eps=DBSCAN_EPS_KM, min_samples=DBSCAN_MIN_SAMPLES, n_jobs=1).fit_predict(coords)
477 |     unique_clusters = sorted([int(v) for v in np.unique(labels) if v >= 0])
478 |     n_noise = int(np.sum(labels < 0))
479 |     cluster_sizes: list[dict[str, Any]] = []
480 |     centroid_payload: list[dict[str, Any]] = []
481 |     az_payload: list[dict[str, Any]] = []
482 |     dominant_label = None
483 |     dominant_size = -1
484 |     dominant_info: dict[str, Any] | None = None
485 | 
486 |     for cluster_id in unique_clusters:
487 |         mask = labels == cluster_id
488 |         cluster = subset.loc[mask].copy()
489 |         size = int(len(cluster))
490 |         cx = float(cluster["x_km_local"].mean())
491 |         cy = float(cluster["y_km_local"].mean())
492 |         clon = float(cluster["longitude"].mean())
493 |         clat = float(cluster["latitude"].mean())
494 |         dist, az = distance_and_azimuth_from_point(cx, cy, ms64.x_km_local, ms64.y_km_local)
495 |         along = (cx - ms64.x_km_local) * axis_ref.ux + (cy - ms64.y_km_local) * axis_ref.uy
496 |         cross = (cx - ms64.x_km_local) * axis_ref.vx + (cy - ms64.y_km_local) * axis_ref.vy
497 |         cluster_sizes.append({"cluster_id": cluster_id, "n_events": size})
498 |         centroid_payload.append(
499 |             {
500 |                 "cluster_id": cluster_id,
501 |                 "x_km_local": cx,
502 |                 "y_km_local": cy,
503 |                 "longitude": clon,
504 |                 "latitude": clat,
505 |                 "n_events": size,
506 |                 "along_strike_km": float(along),
507 |                 "cross_strike_km": float(cross),
508 |             }
509 |         )
510 |         az_payload.append(
511 |             {
512 |                 "cluster_id": cluster_id,
513 |                 "azimuth_from_mainshock64_deg": az,
514 |                 "distance_from_mainshock64_km": dist,
515 |             }
516 |         )
517 |         if size > dominant_size:
518 |             dominant_label = cluster_id
519 |             dominant_size = size
520 |             dominant_info = {
521 |                 "centroid_longitude": clon,
522 |                 "centroid_latitude": clat,
523 |                 "centroid_x_km_local": cx,
524 |                 "centroid_y_km_local": cy,
525 |                 "azimuth": az,
526 |                 "distance": dist,
527 |                 "along": float(along),
528 |                 "cross": float(cross),
529 |             }
530 | 
531 |     clustered_events = int(np.sum(labels >= 0))
532 |     base_record["n_clusters"] = int(len(unique_clusters))
533 |     base_record["n_noise_events"] = n_noise
534 |     base_record["clustered_event_fraction"] = float(clustered_events / n_events) if n_events > 0 else None
535 |     if dominant_label is not None and dominant_info is not None:
536 |         base_record["dominant_cluster_fraction"] = float(dominant_size / n_events)
537 |         base_record["dominant_cluster_event_count"] = int(dominant_size)
538 |         base_record["dominant_cluster_centroid_longitude"] = float(dominant_info["centroid_longitude"])
539 |         base_record["dominant_cluster_centroid_latitude"] = float(dominant_info["centroid_latitude"])
540 |         base_record["dominant_cluster_centroid_x_km_local"] = float(dominant_info["centroid_x_km_local"])
541 |         base_record["dominant_cluster_centroid_y_km_local"] = float(dominant_info["centroid_y_km_local"])
542 |         base_record["dominant_cluster_azimuth_from_mainshock64_deg"] = dominant_info["azimuth"]
543 |         base_record["dominant_cluster_distance_from_mainshock64_km"] = dominant_info["distance"]
544 |         base_record["dominant_cluster_along_strike_km"] = float(dominant_info["along"])
545 |         base_record["dominant_cluster_cross_strike_km"] = float(dominant_info["cross"])
546 |     base_record["cluster_size_json"] = json.dumps(cluster_sizes, sort_keys=True)
547 |     base_record["cluster_centroids_json"] = json.dumps(centroid_payload, sort_keys=True)
548 |     base_record["cluster_azimuths_from_mainshock64_json"] = json.dumps(az_payload, sort_keys=True)
549 |     return base_record
