598 | def compute_interval_summary(
599 |     subset: pd.DataFrame,
600 |     label: str,
601 |     role: str,
602 |     ms64: MainshockRef,
603 |     ms71: MainshockRef,
604 |     axis_ref: AxisReference,
605 | ) -> dict[str, Any]:
606 |     n_events = int(len(subset))
607 |     x = subset["x_km_local"].to_numpy(dtype=float)
608 |     y = subset["y_km_local"].to_numpy(dtype=float)
609 |     lon = subset["longitude"].to_numpy(dtype=float)
610 |     lat = subset["latitude"].to_numpy(dtype=float)
611 |     mag = subset["magnitude"].to_numpy(dtype=float)
612 |     depth = subset["depth_km"].to_numpy(dtype=float)
613 | 
614 |     centroid = centroid_metrics(x, y, lon, lat)
615 |     axis_metrics = principal_axis_metrics(x, y)
616 |     proj_metrics = axis_projection_metrics(x, y, ms64.x_km_local, ms64.y_km_local, axis_ref)
617 |     mag_metrics = summarize_magnitudes(mag, depth)
618 |     area = robust_area_km2(x, y)
619 |     d64, a64 = distance_and_azimuth_from_point(
620 |         centroid["centroid_x_km_local"], centroid["centroid_y_km_local"], ms64.x_km_local, ms64.y_km_local
621 |     )
622 |     d71, a71 = distance_and_azimuth_from_point(
623 |         centroid["centroid_x_km_local"], centroid["centroid_y_km_local"], ms71.x_km_local, ms71.y_km_local
624 |     )
625 |     hx, hy, hd = density_center(x, y, step_km=GRID_STEP_KM, bandwidth_km=HOTSPOT_BANDWIDTH_KM)
626 |     return {
627 |         "comparison_label": label,
628 |         "interval_role": role,
629 |         "n_events": n_events,
630 |         **mag_metrics,
631 |         **centroid,
632 |         **axis_metrics,
633 |         "spatial_footprint_area_km2": area,
634 |         **proj_metrics,
635 |         "centroid_distance_to_mainshock64_km": d64,
636 |         "centroid_azimuth_from_mainshock64_deg": a64,
637 |         "centroid_distance_to_mainshock71_km": d71,
638 |         "centroid_azimuth_from_mainshock71_deg": a71,
639 |         "hotspot_x_km_local": hx,
640 |         "hotspot_y_km_local": hy,
641 |         "hotspot_density_value": hd,
642 |     }
643 | 
644 | 
645 | def finalize_comparison_metrics(
646 |     intervals_df: pd.DataFrame,
647 |     catalog: pd.DataFrame,
648 |     ms64: MainshockRef,
649 |     ms71: MainshockRef,
650 |     axis_ref: AxisReference,
651 | ) -> tuple[pd.DataFrame, pd.DataFrame]:
652 |     records = []
653 |     for _, row in intervals_df.iterrows():
654 |         start = pd.Timestamp(row["start_time"])
655 |         end = pd.Timestamp(row["end_time"])
656 |         subset = catalog.loc[(catalog["event_time"] >= start) & (catalog["event_time"] < end)].copy()
657 |         rec = compute_interval_summary(
658 |             subset=subset,
659 |             label=str(row["comparison_label"]),
660 |             role=str(row["interval_role"]),
661 |             ms64=ms64,
662 |             ms71=ms71,
663 |             axis_ref=axis_ref,
664 |         )
665 |         rec["start_time"] = start
666 |         rec["end_time"] = end
667 |         rec["duration_hours"] = float(row["duration_hours"])
668 |         records.append(rec)
669 |     df = pd.DataFrame(records).sort_values(["comparison_label", "interval_role"], kind="mergesort").reset_index(drop=True)
670 | 
671 |     change_rows = []
672 |     for label, group in df.groupby("comparison_label", sort=False):
673 |         before = group.loc[group["interval_role"] == "before"]
674 |         after = group.loc[group["interval_role"] == "after"]
675 |         if len(before) != 1 or len(after) != 1:
676 |             raise ValueError(f"Expected one before and one after interval for comparison {label}")
677 |         b = before.iloc[0]
678 |         a = after.iloc[0]
679 |         dx = None
680 |         dy = None
681 |         dist = None
682 |         az = None
683 |         if pd.notna(b["centroid_x_km_local"]) and pd.notna(a["centroid_x_km_local"]):
684 |             dx = float(a["centroid_x_km_local"] - b["centroid_x_km_local"])
685 |             dy = float(a["centroid_y_km_local"] - b["centroid_y_km_local"])
686 |             dist = float(math.hypot(dx, dy))
687 |             az = azimuth_from_components(dx, dy)
688 |         hdx = None
689 |         hdy = None
690 |         hdist = None
691 |         haz = None
692 |         if pd.notna(b["hotspot_x_km_local"]) and pd.notna(a["hotspot_x_km_local"]):
693 |             hdx = float(a["hotspot_x_km_local"] - b["hotspot_x_km_local"])
694 |             hdy = float(a["hotspot_y_km_local"] - b["hotspot_y_km_local"])
695 |             hdist = float(math.hypot(hdx, hdy))
696 |             haz = azimuth_from_components(hdx, hdy)
697 |         change_rows.append(
698 |             {
699 |                 "comparison_label": label,
700 |                 "before_interval_role": "before",
701 |                 "after_interval_role": "after",
702 |                 "before_event_count": int(b["n_events"]),
703 |                 "after_event_count": int(a["n_events"]),
704 |                 "event_count_change": int(a["n_events"] - b["n_events"]),
705 |                 "centroid_shift_dx_km": dx,
706 |                 "centroid_shift_dy_km": dy,
707 |                 "centroid_shift_distance_km": dist,
708 |                 "centroid_shift_azimuth_deg": az,
709 |                 "principal_axis_orientation_change_deg": circular_difference_deg(
710 |                     a["principal_axis_azimuth_deg"], b["principal_axis_azimuth_deg"]
711 |                 ),
712 |                 "occupied_area_change_km2": (
713 |                     float(a["spatial_footprint_area_km2"] - b["spatial_footprint_area_km2"])
714 |                     if pd.notna(a["spatial_footprint_area_km2"]) and pd.notna(b["spatial_footprint_area_km2"])
715 |                     else None
716 |                 ),
717 |                 "along_strike_centroid_change_km": (
718 |                     float(a["along_strike_centroid_km"] - b["along_strike_centroid_km"])
719 |                     if pd.notna(a["along_strike_centroid_km"]) and pd.notna(b["along_strike_centroid_km"])
720 |                     else None
721 |                 ),
722 |                 "cross_strike_centroid_change_km": (
723 |                     float(a["cross_strike_centroid_km"] - b["cross_strike_centroid_km"])
724 |                     if pd.notna(a["cross_strike_centroid_km"]) and pd.notna(b["cross_strike_centroid_km"])
725 |                     else None
726 |                 ),
727 |                 "hotspot_shift_dx_km": hdx,
728 |                 "hotspot_shift_dy_km": hdy,
729 |                 "hotspot_shift_distance_km": hdist,
730 |                 "hotspot_shift_azimuth_deg": haz,
731 |             }
732 |         )
733 |     return df, pd.DataFrame(change_rows)
