162 | def read_mainshocks(catalog: pd.DataFrame) -> dict[str, MainshockRef]:
163 |     log(f"[INFO] Reading mainshock reference: {MAINSHOCK_PATH}")
164 |     df = pd.read_csv(MAINSHOCK_PATH)
165 |     assert_columns(df, ["mainshock_label", "event_time", "latitude", "longitude", "depth_km", "magnitude"], "mainshocks")
166 |     df = parse_time_columns(df, ["event_time"])
167 |     refs: dict[str, MainshockRef] = {}
168 |     for _, row in df.iterrows():
169 |         lon = float(row["longitude"])
170 |         lat = float(row["latitude"])
171 |         x, y = project_to_local_xy(
172 |             longitude=np.array([lon]),
173 |             latitude=np.array([lat]),
174 |             origin_lon=float(catalog.attrs["projection_origin_longitude"]),
175 |             origin_lat=float(catalog.attrs["projection_origin_latitude"]),
176 |         )
177 |         refs[str(row["mainshock_label"])] = MainshockRef(
178 |             label=str(row["mainshock_label"]),
179 |             time=pd.Timestamp(row["event_time"]),
180 |             longitude=lon,
181 |             latitude=lat,
182 |             x_km_local=float(x[0]),
183 |             y_km_local=float(y[0]),
184 |         )
185 |     if set(refs) != {"mainshock64", "mainshock71"}:
186 |         raise ValueError(f"Unexpected mainshock labels: {sorted(refs)}")
187 |     return refs
