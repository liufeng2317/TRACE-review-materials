190 | def read_windows(path: Path, expected: list[str], label: str) -> pd.DataFrame:
191 |     log(f"[INFO] Reading {label}: {path}")
192 |     df = pd.read_csv(path)
193 |     assert_columns(df, expected, label)
194 |     time_cols = [col for col in ["start_time", "end_time"] if col in df.columns]
195 |     df = parse_time_columns(df, time_cols)
196 |     return df
