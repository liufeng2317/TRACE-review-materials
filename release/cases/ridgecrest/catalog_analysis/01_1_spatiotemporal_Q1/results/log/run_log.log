241 | def build_regular_windows(
242 |     family_name: str,
243 |     stage_label: str,
244 |     start_time: pd.Timestamp,
245 |     end_time: pd.Timestamp,
246 |     step: pd.Timedelta,
247 | ) -> pd.DataFrame:
248 |     if not start_time < end_time:
249 |         raise ValueError(f"Invalid window bounds for {family_name}/{stage_label}: start >= end")
250 |     starts = list(pd.date_range(start=start_time, end=end_time, freq=step, inclusive="left"))
251 |     records: List[dict] = []
252 |     total_hours = step.total_seconds() / 3600.0
253 |     for idx, win_start in enumerate(starts):
254 |         win_end = min(win_start + step, end_time)
255 |         records.append(
256 |             {
257 |                 "window_family": family_name,
258 |                 "stage_label": stage_label,
259 |                 "window_index": idx,
260 |                 "window_label": f"{family_name}_{stage_label}_{idx:04d}",
261 |                 "start_time": win_start,
262 |                 "end_time": win_end,
263 |                 "duration_hours": total_hours,
264 |                 "is_terminal_partial_window": bool((win_end - win_start) < step),
265 |             }
266 |         )
267 |     if not records:
268 |         raise ValueError(f"No windows generated for {family_name}/{stage_label}")
269 |     return pd.DataFrame.from_records(records)
270 | 
271 | 
272 | def build_comparison_intervals(
273 |     catalog_start: pd.Timestamp,
274 |     ms64_time: pd.Timestamp,
275 |     ms71_time: pd.Timestamp,
276 | ) -> pd.DataFrame:
277 |     defs = [
278 |         TimeIntervalDef("mw64", "before", catalog_start, ms64_time),
279 |         TimeIntervalDef("mw64", "after", ms64_time, ms71_time),
280 |         TimeIntervalDef("mw71", "before", ms64_time, ms71_time),
281 |         TimeIntervalDef("mw71", "after", ms71_time, ms71_time + pd.Timedelta(days=2)),
282 |     ]
283 |     records = []
284 |     for item in defs:
285 |         if not item.start_time < item.end_time:
286 |             raise ValueError(
287 |                 f"Invalid comparison interval for {item.comparison_label}/{item.interval_role}: start >= end"
288 |             )
289 |         records.append(
290 |             {
291 |                 "comparison_label": item.comparison_label,
292 |                 "interval_role": item.interval_role,
293 |                 "start_time": item.start_time,
294 |                 "end_time": item.end_time,
295 |                 "duration_hours": (item.end_time - item.start_time).total_seconds() / 3600.0,
296 |             }
297 |         )
298 |     return pd.DataFrame.from_records(records)
299 | 
