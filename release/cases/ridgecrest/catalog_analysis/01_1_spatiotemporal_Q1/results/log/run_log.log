736 | def classify_orientation_change(series: pd.Series) -> str:
737 |     vals = series.dropna().to_numpy(dtype=float)
738 |     if len(vals) < 2:
739 |         return "insufficient"
740 |     spread = float(np.nanmax(vals) - np.nanmin(vals))
741 |     if spread < 20.0:
742 |         return "stable"
743 |     if spread < 45.0:
744 |         return "moderate_change"
745 |     return "strong_change"
