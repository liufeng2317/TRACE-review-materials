606 | def add_consecutive_migration_metrics(metrics_df: pd.DataFrame, stage_group_columns: list[str]) -> pd.DataFrame:
607 |     assert_columns(
608 |         metrics_df,
609 |         [
610 |             *stage_group_columns,
611 |             "window_index",
612 |             "centroid_x_km_local",
613 |             "centroid_y_km_local",
614 |             "principal_axis_azimuth_deg",
615 |         ],
616 |         "metrics_df_before_migration",
617 |     )
618 |     out = metrics_df.sort_values(stage_group_columns + ["window_index"], kind="mergesort").copy()
619 |     out["prev_centroid_x_km_local"] = out.groupby(stage_group_columns)["centroid_x_km_local"].shift(1)
620 |     out["prev_centroid_y_km_local"] = out.groupby(stage_group_columns)["centroid_y_km_local"].shift(1)
621 |     out["prev_principal_axis_azimuth_deg"] = out.groupby(stage_group_columns)["principal_axis_azimuth_deg"].shift(1)
622 |     dx = out["centroid_x_km_local"] - out["prev_centroid_x_km_local"]
623 |     dy = out["centroid_y_km_local"] - out["prev_centroid_y_km_local"]
624 |     valid = dx.notna() & dy.notna()
625 |     out["centroid_step_dx_km"] = np.where(valid, dx, np.nan)
626 |     out["centroid_step_dy_km"] = np.where(valid, dy, np.nan)
627 |     out["centroid_step_distance_km"] = np.where(valid, np.hypot(dx, dy), np.nan)
628 |     out["centroid_step_azimuth_deg"] = np.where(valid, np.degrees(np.arctan2(dx, dy)), np.nan)
629 |     out["centroid_step_azimuth_deg"] = (out["centroid_step_azimuth_deg"] + 360.0) % 360.0
630 |     out["principal_axis_azimuth_change_deg"] = [
631 |         circular_difference_deg(a, b)
632 |         for a, b in zip(out["principal_axis_azimuth_deg"], out["prev_principal_axis_azimuth_deg"])
633 |     ]
634 |     out["cumulative_centroid_distance_km"] = out.groupby(stage_group_columns)["centroid_step_distance_km"].transform(
635 |         lambda s: s.fillna(0.0).cumsum()
636 |     )
637 |     return out
