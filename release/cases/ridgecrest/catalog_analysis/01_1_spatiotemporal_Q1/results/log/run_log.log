142 | def read_catalog() -> pd.DataFrame:
143 |     log(f"[INFO] Reading catalog: {CATALOG_CLEAN_PATH}")
144 |     df = pd.read_csv(CATALOG_CLEAN_PATH)
145 |     assert_columns(df, REQUIRED_CATALOG_COLUMNS, "catalog")
146 |     df = parse_time_columns(df, ["event_time"])
147 |     for col in [
148 |         "latitude",
149 |         "longitude",
150 |         "depth_km",
151 |         "magnitude",
152 |         "x_km_local",
153 |         "y_km_local",
154 |         "elapsed_hours_since_mainshock64",
155 |         "elapsed_hours_since_mainshock71",
156 |     ]:
157 |         df[col] = pd.to_numeric(df[col], errors="raise")
158 |     df = df.sort_values("event_time", kind="mergesort").reset_index(drop=True)
159 |     return df
