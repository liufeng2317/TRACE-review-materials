693 | def compute_interval_summary(
694 |     subset: pd.DataFrame,
695 |     label: str,
696 |     role: str,
697 |     ms64: MainshockRef,
698 |     ms71: MainshockRef,
699 |     axis_ref: AxisReference,
700 | ) -> dict[str, Any]:
701 |     n_events = int(len(subset))
702 |     x = subset["x_km_local"].to_numpy(dtype=float)
703 |     y = subset["y_km_local"].to_numpy(dtype=float)
704 |     lon = subset["longitude"].to_numpy(dtype=float)
705 |     lat = subset["latitude"].to_numpy(dtype=float)
706 |     mag = subset["magnitude"].to_numpy(dtype=float)
707 |     depth = subset["depth_km"].to_numpy(dtype=float)
708 | 
709 |     centroid = centroid_metrics(x, y, lon, lat)
710 |     axis_metrics = principal_axis_metrics(x, y)
711 |     proj_metrics = axis_projection_metrics(x, y, ms64.x_km_local, ms64.y_km_local, axis_ref)
712 |     mag_metrics = summarize_magnitudes(mag, depth)
713 |     area = robust_area_km2(x, y)
714 |     d64, a64 = distance_and_azimuth_from_point(
715 |         centroid["centroid_x_km_local"], centroid["centroid_y_km_local"], ms64.x_km_local, ms64.y_km_local
716 |     )
717 |     d71, a71 = distance_and_azimuth_from_point(
718 |         centroid["centroid_x_km_local"], centroid["centroid_y_km_local"], ms71.x_km_local, ms71.y_km_local
719 |     )
720 |     hx, hy, hd = density_center(x, y, step_km=GRID_STEP_KM, bandwidth_km=HOTSPOT_BANDWIDTH_KM)
721 |     return {
722 |         "comparison_label": label,
723 |         "interval_role": role,
724 |         "n_events": n_events,
