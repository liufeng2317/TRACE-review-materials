148 |     log("[INFO] Verifying mainshock reference rows")
149 |     mags = sorted(main_df["magnitude"].round(1).tolist())
150 |     if mags != [6.4, 7.1]:
151 |         raise ValueError(f"Expected mainshock magnitudes [6.4, 7.1], found {mags}")
152 | 
153 |     ms64 = main_df.loc[np.isclose(main_df["magnitude"], 6.4)].copy()
154 |     ms71 = main_df.loc[np.isclose(main_df["magnitude"], 7.1)].copy()
155 |     if len(ms64) != 1 or len(ms71) != 1:
156 |         raise ValueError("Mainshock reference file must contain exactly one Mw 6.4 row and one Mw 7.1 row")
157 | 
158 |     ms64 = ms64.iloc[0]
159 |     ms71 = ms71.iloc[0]
160 |     if not ms64["event_time"] < ms71["event_time"]:
161 |         raise ValueError("Mainshock64 time must be earlier than Mainshock71 time")
162 | 
163 |     verified = pd.DataFrame(
164 |         [
165 |             {
166 |                 "mainshock_label": "mainshock64",
167 |                 "event_time": ms64["event_time"],
