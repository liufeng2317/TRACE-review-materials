        description: Compute one padded map extent and reusable projected and elapsed-time attributes for all events.
        inputs:
          - ridgecrest_catalog_clean
          - mainshock_reference_verified
        outputs:
          - analysis_extent
          - catalog_with_projected_attributes
        params:
          extent_padding_strategy: fixed_small_margin
          coordinate_strategy: local_planar_projection
          derived_attributes:
            - elapsed_hours_since_mw64
            - elapsed_hours_since_mw71
            - sequence_segment_label
            - projected_x
            - projected_y
      - name: build_window_definitions
        description: Construct complete time-window tables for whole-sequence, comparison, and post-Mw 6.4 analyses.
        inputs:
          - ridgecrest_catalog_clean
          - mainshock_reference_verified
          - analysis_extent
        outputs:
          - time_windows_whole_sequence
          - time_windows_post64_hourly
          - time_windows_comparison_intervals
        params:
          interval_convention: half_open
          whole_sequence_stage_a:
            start: mainshock64
            end: mainshock71_plus_1_day
            step_hours: 2
          whole_sequence_stage_b:
            start: mainshock71_plus_1_day
            end: mainshock71_plus_5_days
            step_hours: 6
          post64_hourly:
            start: mainshock64
            end: mainshock71
            step_hours: 1
          comparison_intervals:
            - pre64
            - post64_pre71
            - pre71
            - post71_2day
          preserve_empty_windows: true

  - name: 02_spatiotemporal_metrics
    description: Compute window-based migration, orientation, spread, and clustering diagnostics for the Ridgecrest sequence.
    script: 02_spatiotemporal_metrics.py
    ancestors:
      - 01_catalog_windows_qc
    subtasks:
      - name: compute_window_metrics_whole_sequence
        description: Calculate per-window counts, centroid, spread, orientation, and distance metrics for whole-sequence windows.
        inputs:
          - catalog_with_projected_attributes
          - mainshock_reference_verified
          - time_windows_whole_sequence
        outputs:
          - window_metrics_whole_sequence
        params:
          minimum_events_for_orientation: data_driven_threshold
          minimum_events_for_area: data_driven_threshold
          reference_vector: mw64_to_mw71
          metric_groups:
            - event_count
            - magnitude_summary
            - centroid
            - principal_axis_azimuth
            - major_minor_spread
            - footprint_area
            - centroid_distance_to_mainshocks
            - centroid_azimuth_from_mainshocks
            - along_cross_strike_projections
      - name: compute_window_metrics_post64_hourly
        description: Calculate hourly centroid, spread, orientation, and migration metrics for the post-Mw 6.4 sequence.
        inputs:
          - catalog_with_projected_attributes
          - mainshock_reference_verified
          - time_windows_post64_hourly
        outputs:
          - window_metrics_post64_hourly
          - migration_summary_64_to_71
        params:
          minimum_events_for_orientation: data_driven_threshold
          migration_outputs:
            - consecutive_centroid_displacement
            - cumulative_centroid_migration
            - principal_axis_change_through_time
            - distance_to_mw71_vs_time
          reference_vector: mw64_to_mw71
      - name: compute_cluster_diagnostics
        description: Estimate per-window cluster structure and simultaneous activation diagnostics using fixed projected-space settings.
        inputs:
          - catalog_with_projected_attributes
          - time_windows_whole_sequence
          - time_windows_post64_hourly
          - mainshock_reference_verified
        outputs:
          - window_cluster_metrics_whole_sequence
          - window_cluster_metrics_post64_hourly
          - post64_branching_flags
        params:
          clustering_method: density_based_projected_coordinates
          parameter_selection: fixed_from_catalog_spatial_scale
          cluster_outputs:
            - cluster_count
            - dominant_cluster_fraction
            - cluster_centroids
            - cluster_azimuths_relative_to_mw64
            - simultaneous_multi_cluster_flag
          insufficient_data_policy: mark_insufficient
      - name: compute_before_after_change_metrics
        description: Quantify centroid shifts, orientation changes, area changes, and density-center shifts around the two mainshocks.
        inputs:
          - catalog_with_projected_attributes
          - time_windows_comparison_intervals
          - mainshock_reference_verified
          - analysis_extent
        outputs:
          - comparison_metrics_64
          - comparison_metrics_71
          - migration_summary_post71
        params:
          comparison_pairs:
            - mw64_before_after
            - mw71_before_after
          shared_spatial_grid: true
          metric_groups:
            - event_counts
            - centroid_shift_vector
            - principal_axis_orientation_change
            - occupied_area_change
            - density_center_shift
      - name: validate_metric_completeness
        description: Check that all expected windows and comparison intervals have metrics or explicit insufficient-data flags.
        inputs:
          - time_windows_whole_sequence
          - time_windows_post64_hourly
          - time_windows_comparison_intervals
          - window_metrics_whole_sequence
          - window_metrics_post64_hourly
          - window_cluster_metrics_whole_sequence
          - window_cluster_metrics_post64_hourly
          - comparison_metrics_64
          - comparison_metrics_71
        outputs:
