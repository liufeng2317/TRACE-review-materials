203 | def add_projected_coordinates(df: pd.DataFrame, origin_lon: float, origin_lat: float) -> pd.DataFrame:
204 |     out = df.copy()
205 |     lat_rad = np.deg2rad(out["latitude"].to_numpy())
206 |     lon_rad = np.deg2rad(out["longitude"].to_numpy())
207 |     origin_lat_rad = math.radians(origin_lat)
208 |     origin_lon_rad = math.radians(origin_lon)
209 |     earth_radius_km = 6371.0
210 |     out["x_km_local"] = earth_radius_km * (lon_rad - origin_lon_rad) * math.cos(origin_lat_rad)
211 |     out["y_km_local"] = earth_radius_km * (lat_rad - origin_lat_rad)
212 |     return out
213 | 
214 | 
215 | def add_elapsed_times(df: pd.DataFrame, ms64_time: pd.Timestamp, ms71_time: pd.Timestamp) -> pd.DataFrame:
216 |     out = df.copy()
217 |     out["elapsed_hours_since_mainshock64"] = (
218 |         (out["event_time"] - ms64_time).dt.total_seconds() / 3600.0
219 |     )
220 |     out["elapsed_hours_since_mainshock71"] = (
221 |         (out["event_time"] - ms71_time).dt.total_seconds() / 3600.0
222 |     )
223 |     conditions = [
224 |         out["event_time"] < ms64_time,
225 |         (out["event_time"] >= ms64_time) & (out["event_time"] < ms71_time),
226 |         out["event_time"] >= ms71_time,
227 |     ]
228 |     labels = ["pre_mainshock64", "between_mainshock64_mainshock71", "post_mainshock71"]
229 |     out["sequence_segment_label"] = np.select(conditions, labels, default="unclassified")
230 |     return out
