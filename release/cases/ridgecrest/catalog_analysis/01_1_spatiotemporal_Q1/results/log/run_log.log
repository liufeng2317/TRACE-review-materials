313 | def principal_axis_metrics(x: np.ndarray, y: np.ndarray) -> dict[str, float | None]:
314 |     if len(x) < ORIENTATION_MIN_EVENTS:
315 |         return {
316 |             "principal_axis_azimuth_deg": None,
317 |             "major_spread_km": None,
318 |             "minor_spread_km": None,
319 |             "anisotropy_ratio": None,
320 |         }
321 |     coords = np.column_stack([x, y])
322 |     centered = coords - coords.mean(axis=0, keepdims=True)
323 |     cov = np.cov(centered, rowvar=False)
324 |     if cov.shape != (2, 2) or not np.all(np.isfinite(cov)):
325 |         return {
326 |             "principal_axis_azimuth_deg": None,
327 |             "major_spread_km": None,
328 |             "minor_spread_km": None,
329 |             "anisotropy_ratio": None,
330 |         }
331 |     eigvals, eigvecs = np.linalg.eigh(cov)
332 |     order = np.argsort(eigvals)[::-1]
333 |     eigvals = eigvals[order]
334 |     eigvecs = eigvecs[:, order]
335 |     major = max(float(eigvals[0]), 0.0)
336 |     minor = max(float(eigvals[1]), 0.0)
337 |     major_vec = eigvecs[:, 0]
338 |     azimuth = azimuth_from_components(float(major_vec[0]), float(major_vec[1]))
339 |     major_spread = math.sqrt(major)
340 |     minor_spread = math.sqrt(minor)
341 |     ratio = None if minor_spread == 0.0 else float(major_spread / minor_spread)
342 |     return {
343 |         "principal_axis_azimuth_deg": float(azimuth),
344 |         "major_spread_km": float(major_spread),
345 |         "minor_spread_km": float(minor_spread),
