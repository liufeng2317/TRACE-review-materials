136 | def assert_columns(df: pd.DataFrame, expected: list[str], df_name: str) -> None:
137 |     missing = [col for col in expected if col not in df.columns]
138 |     if missing:
139 |         raise ValueError(f"{df_name} missing required columns: {missing}")
