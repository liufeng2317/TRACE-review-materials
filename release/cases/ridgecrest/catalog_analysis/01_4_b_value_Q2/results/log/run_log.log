234 | def node_batch_worker(node_ids, node_xy, event_xy, event_mag, radius_km, mc, delta_m, n_boot, seed_base):
235 |     tree = cKDTree(event_xy)
236 |     rows = []
237 |     for local_idx, node_id in enumerate(node_ids):
238 |         x, y = node_xy[local_idx]
239 |         idx = tree.query_ball_point([x, y], r=radius_km)
240 |         if len(idx) == 0:
241 |             rows.append((int(node_id), 0, 0, np.nan, np.nan, np.nan, np.nan, np.nan, 'insufficient', 0))
242 |             continue
243 |         mags_all = event_mag[idx]
244 |         mags = mags_all[np.isfinite(mags_all) & (mags_all >= mc)]
245 |         n_total = len(idx)
246 |         n_ge = mags.size
247 |         if n_ge < MIN_EVENTS_GE_MC:
248 |             rows.append((int(node_id), n_total, n_ge, float(np.nanmean(mags)) if n_ge > 0 else np.nan, np.nan, np.nan, np.nan, np.nan, reliability_class(n_ge), 0))
249 |             continue
250 |         b = aki_utsu_b(mags, mc, delta_m)
251 |         boot_mean, boot_std, ci_low, ci_high = bootstrap_b(mags, mc, delta_m, n_boot=n_boot, seed=seed_base + int(node_id))
252 |         rows.append((int(node_id), n_total, n_ge, float(np.mean(mags)), b, boot_mean, boot_std, ci_low, ci_high, reliability_class(n_ge), 1))
253 |     return rows
254 | 
255 | 
