239 | def compute_spatial_b(grid: pd.DataFrame, events: pd.DataFrame, window_name: str, radius_km: float, mc: float, delta_m: float, n_boot: int, max_workers: int, progress_path: Path) -> pd.DataFrame:
240 |     log(f'[spatial] window={window_name} radius_km={radius_km} nodes={len(grid)} events={len(events)}')
241 |     event_xy = events[['x_km', 'y_km']].to_numpy(dtype=float)
242 |     event_mag = events['magnitude'].to_numpy(dtype=float)
243 |     chunks = np.array_split(grid.index.to_numpy(), min(max_workers, max(1, len(grid) // 200 + 1)))
244 |     results = []
245 |     with ProcessPoolExecutor(max_workers=max_workers) as ex:
246 |         futures = []
247 |         for batch_idx, idxs in enumerate(chunks):
248 |             if len(idxs) == 0:
249 |                 continue
250 |             sub = grid.loc[idxs, ['node_id', 'x_km', 'y_km']]
251 |             fut = ex.submit(
252 |                 node_batch_worker,
253 |                 sub['node_id'].to_numpy(dtype=int),
254 |                 sub[['x_km', 'y_km']].to_numpy(dtype=float),
255 |                 event_xy,
256 |                 event_mag,
257 |                 radius_km,
258 |                 mc,
259 |                 delta_m,
260 |                 n_boot,
261 |                 BOOTSTRAP_SEED + int(radius_km * 1000) + batch_idx * 10000,
262 |             )
263 |             futures.append((batch_idx, fut, len(sub)))
264 |         done = 0
265 |         with progress_path.open('a', encoding='utf-8') as fp:
266 |             for batch_idx, fut, batch_size in as_completed([f[1] for f in futures]):
267 |                 pass
268 |         for batch_idx, fut, batch_size in futures:
269 |             rows = fut.result()
270 |             done += batch_size
271 |             with progress_path.open('a', encoding='utf-8') as fp:
272 |                 fp.write(f'{window_name},{radius_km},{batch_idx},{batch_size},{done}\n')
273 |             log(f'[spatial-progress] window={window_name} radius={radius_km} done_nodes={done}/{len(grid)}')
274 |             results.extend(rows)
275 |     cols = ['node_id', 'n_total', 'n_ge_mc', 'mean_mag_ge_mc', 'b_value', 'b_boot_mean', 'b_boot_std', 'b_ci_low', 'b_ci_high', 'reliability_class', 'valid_flag']
276 |     out = pd.DataFrame(results, columns=cols)
277 |     out = grid.merge(out, on='node_id', how='left')
278 |     out['window_name'] = window_name
279 |     out['radius_km'] = radius_km
280 |     return out
