423 | def project_to_profile(x, y, origin_x, origin_y, strike_deg):
424 |     theta = np.deg2rad(strike_deg)
425 |     dx = x - origin_x
426 |     dy = y - origin_y
427 |     along = dx * np.sin(theta) + dy * np.cos(theta)
428 |     across = dx * np.cos(theta) - dy * np.sin(theta)
429 |     return along, across
