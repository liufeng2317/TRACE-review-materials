153 | def seismostats_mc(mags: np.ndarray, delta_m: float) -> dict:
154 |     out = {'mc_maxc': np.nan, 'mc_ks': np.nan, 'mc_mbs': np.nan, 'status': 'ok'}
155 |     mags = np.asarray(mags, dtype=float)
156 |     mags = mags[np.isfinite(mags)]
157 |     if mags.size < 30:
158 |         out['status'] = 'insufficient_sample'
159 |         return out
160 |     cat = Catalog({'magnitude': mags})
161 |     try:
162 |         cat.bin_magnitudes(delta_m=delta_m, inplace=True)
163 |     except Exception:
164 |         pass
165 |     try:
166 |         cat.estimate_mc_maxc(fmd_bin=delta_m)
167 |         out['mc_maxc'] = float(cat.mc)
168 |     except Exception:
169 |         pass
170 |     try:
171 |         cat.estimate_mc_ks(delta_m=delta_m, p_value_pass=0.1)
172 |         out['mc_ks'] = float(cat.mc)
173 |     except Exception:
174 |         pass
175 |     try:
176 |         cat.estimate_mc_b_stability()
177 |         out['mc_mbs'] = float(cat.mc)
178 |     except Exception:
179 |         pass
180 |     return out
