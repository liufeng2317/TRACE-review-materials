 73 | def infer_delta_m(magnitudes: np.ndarray) -> tuple[float, pd.DataFrame]:
 74 |     mags = np.asarray(magnitudes, dtype=float)
 75 |     mags = mags[np.isfinite(mags)]
 76 |     unique = np.unique(np.round(mags, 4))
 77 |     diffs = np.diff(np.sort(unique))
 78 |     diffs = diffs[diffs > 1e-6]
 79 |     if diffs.size == 0:
 80 |         return 0.1, pd.DataFrame({'diff': [], 'count': []})
 81 |     rounded = np.round(diffs, 3)
 82 |     counts = pd.Series(rounded).value_counts().sort_index()
 83 |     freq = counts.reset_index()
 84 |     freq.columns = ['diff', 'count']
 85 |     dominant = float(counts.sort_values(ascending=False).index[0])
 86 |     allowed = [0.01, 0.02, 0.05, 0.1]
 87 |     chosen = min(allowed, key=lambda x: abs(x - dominant))
 88 |     return chosen, freq
