202 |     }
203 |     try:
204 |         out['b_fixed_mc'] = float(estimate_b(mags, mc=fixed_mc, delta_m=delta_m))
205 |     except Exception as exc:
206 |         out['b_fixed_mc'] = aki_utsu_b(mags, fixed_mc, delta_m)
207 |         out['b_fixed_method'] = 'aki_utsu_fallback'
208 |         out['b_fixed_error'] = str(exc)
209 |     if np.isfinite(dynamic_mc):
210 |         out['n_dynamic_mc'] = int(np.sum(np.asarray(mags) >= dynamic_mc))
211 |         if out['n_dynamic_mc'] > 0:
212 |             try:
213 |                 out['b_dynamic_mc'] = float(estimate_b(mags, mc=dynamic_mc, delta_m=delta_m))
214 |             except Exception as exc:
215 |                 out['b_dynamic_mc'] = aki_utsu_b(mags, dynamic_mc, delta_m)
216 |                 out['b_dynamic_method'] = 'aki_utsu_fallback'
217 |                 out['b_dynamic_error'] = str(exc)
218 |     return out
