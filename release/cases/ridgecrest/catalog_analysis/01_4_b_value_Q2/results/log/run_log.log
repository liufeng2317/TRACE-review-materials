217 | def node_batch_worker(node_ids, node_xy, event_xy, event_mag, radius_km, mc, delta_m, n_boot, seed_base):
218 |     tree = cKDTree(event_xy)
219 |     rows = []
220 |     for local_idx, node_id in enumerate(node_ids):
221 |         x, y = node_xy[local_idx]
222 |         idx = tree.query_ball_point([x, y], r=radius_km)
223 |         if len(idx) == 0:
224 |             rows.append((int(node_id), 0, 0, np.nan, np.nan, np.nan, np.nan, np.nan, 'insufficient', 0))
225 |             continue
226 |         mags_all = event_mag[idx]
227 |         mags = mags_all[np.isfinite(mags_all) & (mags_all >= mc)]
228 |         n_total = len(idx)
229 |         n_ge = mags.size
230 |         if n_ge < MIN_EVENTS_GE_MC:
231 |             rows.append((int(node_id), n_total, n_ge, float(np.nanmean(mags)) if n_ge > 0 else np.nan, np.nan, np.nan, np.nan, np.nan, reliability_class(n_ge), 0))
232 |             continue
233 |         b = aki_utsu_b(mags, mc, delta_m)
234 |         boot_mean, boot_std, ci_low, ci_high = bootstrap_b(mags, mc, delta_m, n_boot=n_boot, seed=seed_base + int(node_id))
235 |         rows.append((int(node_id), n_total, n_ge, float(np.mean(mags)), b, boot_mean, boot_std, ci_low, ci_high, reliability_class(n_ge), 1))
236 |     return rows
237 | 
