119 | def reliability_class(n_ge_mc: float) -> str:
120 |     if not np.isfinite(n_ge_mc) or n_ge_mc < MIN_EVENTS_GE_MC:
121 |         return 'insufficient'
122 |     if n_ge_mc < 50:
123 |         return 'exploratory'
