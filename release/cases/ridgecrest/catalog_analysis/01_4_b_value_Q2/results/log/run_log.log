292 |     dist = np.sqrt((events['x_km'] - center_x) ** 2 + (events['y_km'] - center_y) ** 2)
293 |     subset = events.loc[dist <= PRIMARY_RADIUS_KM].copy()
294 |     mags_all = subset['magnitude'].to_numpy(dtype=float)
295 |     mags = mags_all[np.isfinite(mags_all) & (mags_all >= FIXED_MC)]
296 |     row = {
297 |         'window_name': window_name,
298 |         'core_name': core_name,
299 |         'radius_km': PRIMARY_RADIUS_KM,
300 |         'n_total': int(len(subset)),
301 |         'n_ge_mc': int(mags.size),
302 |         'b_value': np.nan,
303 |         'b_boot_mean': np.nan,
304 |         'b_boot_std': np.nan,
305 |         'b_ci_low': np.nan,
306 |         'b_ci_high': np.nan,
307 |         'reliability_class': reliability_class(mags.size),
308 |     }
309 |     if mags.size >= MIN_EVENTS_GE_MC:
310 |         row['b_value'] = aki_utsu_b(mags, FIXED_MC, delta_m)
311 |         bm, bs, bl, bh = bootstrap_b(mags, FIXED_MC, delta_m, n_boot=n_boot, seed=BOOTSTRAP_SEED + int(center_x * 1000) + int(center_y * 100))
312 |         row['b_boot_mean'] = bm
313 |         row['b_boot_std'] = bs
314 |         row['b_ci_low'] = bl
315 |         row['b_ci_high'] = bh
316 |     fmd = build_fmd(subset['magnitude'].to_numpy(dtype=float), delta_m, FIXED_MC)
317 |     fmd['window_name'] = window_name
318 |     fmd['core_name'] = core_name
319 |     return row, fmd, subset
