192 | def window_b_qc(mags: np.ndarray, fixed_mc: float, dynamic_mc: float, delta_m: float) -> dict:
193 |     out = {
194 |         'b_fixed_mc': np.nan,
195 |         'n_fixed_mc': int(np.sum(np.asarray(mags) >= fixed_mc)),
