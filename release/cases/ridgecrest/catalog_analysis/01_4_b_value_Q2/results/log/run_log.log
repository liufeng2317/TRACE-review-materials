322 | def build_fmd(mags: np.ndarray, delta_m: float, mc: float) -> pd.DataFrame:
323 |     mags = np.asarray(mags, dtype=float)
324 |     mags = mags[np.isfinite(mags)]
325 |     if mags.size == 0:
326 |         return pd.DataFrame(columns=['mag_bin', 'count_incremental', 'count_cumulative', 'count_incremental_ge_mc', 'count_cumulative_ge_mc'])
327 |     mmin = math.floor(mags.min() / delta_m) * delta_m
328 |     mmax = math.ceil(mags.max() / delta_m) * delta_m
329 |     bins = np.arange(mmin, mmax + delta_m, delta_m)
330 |     counts, edges = np.histogram(mags, bins=np.append(bins, bins[-1] + delta_m))
331 |     cum = counts[::-1].cumsum()[::-1]
332 |     ge_mask = bins >= mc
333 |     counts_ge = counts.copy()
334 |     counts_ge[~ge_mask] = 0
335 |     cum_ge = counts_ge[::-1].cumsum()[::-1]
336 |     return pd.DataFrame({'mag_bin': bins, 'count_incremental': counts, 'count_cumulative': cum, 'count_incremental_ge_mc': counts_ge, 'count_cumulative_ge_mc': cum_ge})
