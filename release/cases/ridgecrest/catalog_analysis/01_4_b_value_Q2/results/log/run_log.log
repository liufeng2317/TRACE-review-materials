140 | def bootstrap_b(mags: np.ndarray, mc: float, delta_m: float, n_boot: int, seed: int):
141 |     rng = np.random.default_rng(seed)
142 |     mags = np.asarray(mags, dtype=float)
143 |     boots = np.empty(n_boot, dtype=float)
144 |     for i in range(n_boot):
145 |         sample = rng.choice(mags, size=mags.size, replace=True)
146 |         boots[i] = aki_utsu_b(sample, mc, delta_m)
147 |     boots = boots[np.isfinite(boots)]
148 |     if boots.size == 0:
149 |         return np.nan, np.nan, np.nan, np.nan
150 |     return float(np.mean(boots)), float(np.std(boots, ddof=1)), float(np.quantile(boots, 0.025)), float(np.quantile(boots, 0.975))
