476 |     valid['is_low_q20'] = valid['b_value'] <= q20
477 |     valid['dist_to_mw71_km'] = np.sqrt((valid['x_km'] - marker71.x_km) ** 2 + (valid['y_km'] - marker71.y_km) ** 2)
478 |     valid['dist_to_mw64_km'] = np.sqrt((valid['x_km'] - marker64.x_km) ** 2 + (valid['y_km'] - marker64.y_km) ** 2)
479 |     low = valid[valid['is_low_abs'] | valid['is_low_q20']].copy()
480 |     summary = {
481 |         'window_name': window_name,
482 |         'valid_nodes': int(len(valid)),
483 |         'low_nodes': int(len(low)),
484 |         'low_fraction': float(len(low) / len(valid)),
485 |         'threshold_q20': q20,
486 |         'median_low_b': float(low['b_value'].median()) if not low.empty else np.nan,
487 |         'median_low_uncertainty': float(low['b_boot_std'].median()) if not low.empty else np.nan,
488 |         'median_low_n_ge_mc': float(low['n_ge_mc'].median()) if not low.empty else np.nan,
489 |         'low_near_mw71_5km': int((low['dist_to_mw71_km'] <= PRIMARY_RADIUS_KM).sum()) if not low.empty else 0,
490 |         'low_near_mw64_5km': int((low['dist_to_mw64_km'] <= PRIMARY_RADIUS_KM).sum()) if not low.empty else 0,
491 |     }
492 |     low['window_name'] = window_name
493 |     return low, summary
