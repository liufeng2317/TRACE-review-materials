204 | def build_grid(df: pd.DataFrame, spacing_km: float, margin_km: float = 7.0) -> pd.DataFrame:
205 |     xmin = math.floor((df['x_km'].min() - margin_km) / spacing_km) * spacing_km
206 |     xmax = math.ceil((df['x_km'].max() + margin_km) / spacing_km) * spacing_km
207 |     ymin = math.floor((df['y_km'].min() - margin_km) / spacing_km) * spacing_km
208 |     ymax = math.ceil((df['y_km'].max() + margin_km) / spacing_km) * spacing_km
209 |     xs = np.arange(xmin, xmax + spacing_km / 2.0, spacing_km)
210 |     ys = np.arange(ymin, ymax + spacing_km / 2.0, spacing_km)
211 |     xx, yy = np.meshgrid(xs, ys)
212 |     grid = pd.DataFrame({'x_km': xx.ravel(), 'y_km': yy.ravel()})
213 |     grid['node_id'] = np.arange(len(grid), dtype=int)
214 |     return grid[['node_id', 'x_km', 'y_km']]
