221 | def build_grid(df: pd.DataFrame, spacing_km: float, margin_km: float = 7.0) -> pd.DataFrame:
222 |     xmin = math.floor((df['x_km'].min() - margin_km) / spacing_km) * spacing_km
223 |     xmax = math.ceil((df['x_km'].max() + margin_km) / spacing_km) * spacing_km
224 |     ymin = math.floor((df['y_km'].min() - margin_km) / spacing_km) * spacing_km
225 |     ymax = math.ceil((df['y_km'].max() + margin_km) / spacing_km) * spacing_km
226 |     xs = np.arange(xmin, xmax + spacing_km / 2.0, spacing_km)
227 |     ys = np.arange(ymin, ymax + spacing_km / 2.0, spacing_km)
228 |     xx, yy = np.meshgrid(xs, ys)
229 |     grid = pd.DataFrame({'x_km': xx.ravel(), 'y_km': yy.ravel()})
230 |     grid['node_id'] = np.arange(len(grid), dtype=int)
231 |     return grid[['node_id', 'x_km', 'y_km']]
