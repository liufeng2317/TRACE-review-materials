183 | def window_b_qc(mags: np.ndarray, fixed_mc: float, dynamic_mc: float, delta_m: float) -> dict:
184 |     out = {
185 |         'b_fixed_mc': np.nan,
186 |         'n_fixed_mc': int(np.sum(np.asarray(mags) >= fixed_mc)),
187 |         'b_dynamic_mc': np.nan,
188 |         'n_dynamic_mc': np.nan,
189 |     }
190 |     try:
191 |         out['b_fixed_mc'] = float(estimate_b(mags, mc=fixed_mc, delta_m=delta_m))
192 |     except Exception:
193 |         out['b_fixed_mc'] = aki_utsu_b(mags, fixed_mc, delta_m)
194 |     if np.isfinite(dynamic_mc):
195 |         out['n_dynamic_mc'] = int(np.sum(np.asarray(mags) >= dynamic_mc))
196 |         if out['n_dynamic_mc'] > 0:
197 |             try:
198 |                 out['b_dynamic_mc'] = float(estimate_b(mags, mc=dynamic_mc, delta_m=delta_m))
199 |             except Exception:
200 |                 out['b_dynamic_mc'] = aki_utsu_b(mags, dynamic_mc, delta_m)
