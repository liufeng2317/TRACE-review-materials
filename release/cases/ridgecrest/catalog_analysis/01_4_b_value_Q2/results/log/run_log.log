103 | def build_transformer(center_lon: float, center_lat: float):
104 |     proj4 = f'+proj=aeqd +lat_0={center_lat} +lon_0={center_lon} +datum=WGS84 +units=m +no_defs'
105 |     crs = CRS.from_proj4(proj4)
106 |     transformer = Transformer.from_crs('EPSG:4326', crs, always_xy=True)
107 |     inverse = Transformer.from_crs(crs, 'EPSG:4326', always_xy=True)
108 |     return crs, transformer, inverse
