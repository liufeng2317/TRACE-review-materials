409 | def compute_profile_orientation(events: pd.DataFrame, center_x: float, center_y: float, neighborhood_km: float = 10.0):
410 |     dist = np.sqrt((events['x_km'] - center_x) ** 2 + (events['y_km'] - center_y) ** 2)
411 |     subset = events.loc[dist <= neighborhood_km, ['x_km', 'y_km']].copy()
412 |     if len(subset) < 5:
413 |         return 0.0, 'fallback_east_west'
414 |     arr = subset[['x_km', 'y_km']].to_numpy()
415 |     arr = arr - arr.mean(axis=0)
416 |     cov = np.cov(arr.T)
417 |     vals, vecs = np.linalg.eigh(cov)
418 |     vec = vecs[:, np.argmax(vals)]
419 |     strike_deg = (np.degrees(np.arctan2(vec[0], vec[1])) + 360.0) % 180.0
420 |     return float(strike_deg), 'principal_axis_post_separator_near_Mw7.1'
421 | 
