126 |     validate_columns(faults, REQUIRED_FAULT_COLUMNS, "fault segment table")
127 | 
128 |     log(f"Loading stage 1 intervals: {STAGE1_FILE}")
129 |     stage1 = pd.read_csv(STAGE1_FILE)
130 |     validate_columns(stage1, REQUIRED_INTERVAL_COLUMNS, "stage1 interval table")
131 |     stage1["start_time"] = pd.to_datetime(stage1["start_time"], utc=True)
132 |     stage1["end_time"] = pd.to_datetime(stage1["end_time"], utc=True)
133 | 
134 |     log(f"Loading stage 2 intervals: {STAGE2_FILE}")
135 |     stage2 = pd.read_csv(STAGE2_FILE)
136 |     validate_columns(stage2, REQUIRED_INTERVAL_COLUMNS, "stage2 interval table")
137 |     stage2["start_time"] = pd.to_datetime(stage2["start_time"], utc=True)
138 |     stage2["end_time"] = pd.to_datetime(stage2["end_time"], utc=True)
139 | 
140 |     with METADATA_FILE.open("r", encoding="utf-8") as f:
141 |         metadata = json.load(f)
142 | 
143 |     return catalog, mainshocks, faults, stage1, stage2, metadata
144 | 
145 | 
146 | def get_extent(metadata: dict[str, Any]) -> tuple[float, float, float, float]:
147 |     extent = metadata.get("plot_extent_degrees")
148 |     if not isinstance(extent, dict):
149 |         raise ValueError("analysis_metadata.json missing plot_extent_degrees")
150 | 
151 |     padded_keys = [
152 |         "longitude_min_padded",
153 |         "longitude_max_padded",
154 |         "latitude_min_padded",
155 |         "latitude_max_padded",
156 |     ]
157 |     legacy_keys = ["min_longitude", "max_longitude", "min_latitude", "max_latitude"]
158 | 
159 |     if all(key in extent for key in padded_keys):
160 |         return (
161 |             float(extent["longitude_min_padded"]),
162 |             float(extent["longitude_max_padded"]),
163 |             float(extent["latitude_min_padded"]),
164 |             float(extent["latitude_max_padded"]),
165 |         )
166 |     if all(key in extent for key in legacy_keys):
167 |         return (
168 |             float(extent["min_longitude"]),
169 |             float(extent["max_longitude"]),
170 |             float(extent["min_latitude"]),
171 |             float(extent["max_latitude"]),
172 |         )
173 | 
174 |     raise KeyError(
175 |         "plot_extent_degrees must contain either padded keys "
176 |         "(longitude_min_padded, longitude_max_padded, latitude_min_padded, latitude_max_padded) "
177 |         "or legacy keys (min_longitude, max_longitude, min_latitude, max_latitude)."
178 |     )
179 | 
180 | 
181 | def get_projected_extent(catalog: pd.DataFrame, mainshocks: pd.DataFrame, faults: pd.DataFrame) -> tuple[float, float, float, float]:
182 |     xs = np.concatenate([catalog["x_m"].to_numpy(), mainshocks["x_m"].to_numpy(), faults["x_m"].to_numpy()])
183 |     ys = np.concatenate([catalog["y_m"].to_numpy(), mainshocks["y_m"].to_numpy(), faults["y_m"].to_numpy()])
184 |     return float(xs.min()), float(xs.max()), float(ys.min()), float(ys.max())
185 | 
186 | 
187 | def make_grid(projected_extent: tuple[float, float, float, float]) -> tuple[np.ndarray, np.ndarray, np.ndarray, np.ndarray]:
188 |     min_x, max_x, min_y, max_y = projected_extent
189 |     x_grid = np.linspace(min_x, max_x, GRID_SIZE_X)
190 |     y_grid = np.linspace(min_y, max_y, GRID_SIZE_Y)
191 |     xx, yy = np.meshgrid(x_grid, y_grid)
192 |     return x_grid, y_grid, xx, yy
193 | 
194 | 
195 | def select_interval_events(catalog: pd.DataFrame, start_time: pd.Timestamp, end_time: pd.Timestamp, is_final: bool) -> pd.DataFrame:
196 |     if is_final:
197 |         mask = (catalog["event_time"] >= start_time) & (catalog["event_time"] <= end_time)
198 |     else:
199 |         mask = (catalog["event_time"] >= start_time) & (catalog["event_time"] < end_time)
200 |     subset = catalog.loc[mask].copy()
201 |     return subset.sort_values("event_time").reset_index(drop=True)
202 | 
203 | 
204 | def estimate_fixed_bandwidth_m(catalog: pd.DataFrame) -> float:
205 |     coords = np.vstack([catalog["x_m"].to_numpy(), catalog["y_m"].to_numpy()])
206 |     kde = gaussian_kde(coords, bw_method=BANDWIDTH_RULE)
207 |     factor = float(kde.factor)
208 |     covariance = np.cov(coords)
209 |     pooled_sigma = math.sqrt(float(np.trace(covariance) / 2.0))
210 |     bandwidth_m = factor * pooled_sigma
211 |     return bandwidth_m
212 | 
213 | 
214 | def highest_density_centroid(density: np.ndarray, peak_value: float, x_grid: np.ndarray, y_grid: np.ndarray) -> tuple[float, float]:
215 |     peak_mask = np.isclose(density, peak_value, rtol=1e-10, atol=max(1e-14, peak_value * 1e-12))
216 |     structure = np.ones((3, 3), dtype=int)
217 |     labels, count = nd_label(peak_mask.astype(int), structure=structure)
218 |     if count <= 1:
219 |         iy, ix = np.argwhere(peak_mask)[0]
220 |         return float(x_grid[ix]), float(y_grid[iy])
221 | 
222 |     best_label = None
223 |     best_size = -1
224 |     for label_id in range(1, count + 1):
225 |         current_size = int((labels == label_id).sum())
226 |         if current_size > best_size:
227 |             best_label = label_id
228 |             best_size = current_size
229 |     rows, cols = np.where(labels == best_label)
230 |     return float(x_grid[cols].mean()), float(y_grid[rows].mean())
231 | 
232 | 
233 | def compute_interval_kde(
234 |     interval_row: dict[str, Any],
235 |     catalog: pd.DataFrame,
236 |     xx: np.ndarray,
237 |     yy: np.ndarray,
238 |     x_grid: np.ndarray,
239 |     y_grid: np.ndarray,
240 |     lonlat_transformer: Transformer,
241 |     arrays_dir: str,
242 | ) -> dict[str, Any]:
243 |     label = interval_row["interval_label"]
244 |     start_time = pd.Timestamp(interval_row["start_time"])
245 |     end_time = pd.Timestamp(interval_row["end_time"])
246 |     is_final = bool(interval_row["is_final_interval"])
247 |     stage = str(interval_row["stage"])
248 |     expected_count = int(interval_row.get("event_count", -1))
249 | 
250 |     subset = select_interval_events(catalog, start_time, end_time, is_final)
251 |     event_count = int(len(subset))
252 |     status = "ok"
253 |     hotspot_x = np.nan
254 |     hotspot_y = np.nan
255 |     hotspot_lon = np.nan
256 |     hotspot_lat = np.nan
257 |     peak_density = np.nan
258 |     array_relpath = None
259 | 
260 |     log(f"Computing KDE for {label}: stage={stage}, events={event_count}, start={start_time.isoformat()}, end={end_time.isoformat()}")
261 | 
262 |     if event_count == 0:
263 |         status = "no_data"
264 |     elif event_count < LOW_SAMPLE_THRESHOLD:
265 |         status = "too_few_events"
266 |     else:
267 |         coords = np.vstack([subset["x_m"].to_numpy(), subset["y_m"].to_numpy()])
268 |         kde = gaussian_kde(coords, bw_method=BANDWIDTH_RULE)
269 |         positions = np.vstack([xx.ravel(), yy.ravel()])
270 |         density = kde(positions).reshape(xx.shape)
271 |         peak_density = float(np.nanmax(density))
272 |         hotspot_x, hotspot_y = highest_density_centroid(density, peak_density, x_grid, y_grid)
273 |         hotspot_lon, hotspot_lat = lonlat_transformer.transform(hotspot_x, hotspot_y)
274 |         array_path = Path(arrays_dir) / f"{label}_density.npy"
275 |         np.save(array_path, density.astype(np.float32))
276 |         array_relpath = f"kde_arrays/{array_path.name}"
277 | 
278 |     return {
279 |         "stage": stage,
280 |         "interval_index": int(interval_row["interval_index"]),
281 |         "interval_label": label,
282 |         "start_time": start_time.isoformat(),
283 |         "end_time": end_time.isoformat(),
284 |         "duration_hours": float(interval_row["duration_hours"]),
285 |         "is_final_interval": is_final,
286 |         "event_count_expected": expected_count,
287 |         "event_count_actual": event_count,
288 |         "event_count_match_reference": bool(expected_count == event_count) if expected_count >= 0 else False,
289 |         "status": status,
290 |         "peak_density": peak_density,
291 |         "hotspot_x_m": hotspot_x,
292 |         "hotspot_y_m": hotspot_y,
293 |         "hotspot_longitude": hotspot_lon,
294 |         "hotspot_latitude": hotspot_lat,
295 |         "kde_array_relpath": array_relpath,
296 |     }
297 | 
298 | 
299 | def build_fault_lines(faults: pd.DataFrame) -> list[np.ndarray]:
300 |     lines = []
301 |     grouped = faults.groupby("segment_id", sort=False)
302 |     for _, seg in grouped:
303 |         arr = seg.sort_values("point_order")[["longitude", "latitude"]].to_numpy()
304 |         if len(arr) >= 2:
305 |             lines.append(arr[::FAULT_SIMPLIFY_STEP] if len(arr) > FAULT_SIMPLIFY_STEP else arr)
306 |     return lines
307 | 
308 | 
309 | def build_fault_tree(faults: pd.DataFrame) -> tuple[cKDTree, np.ndarray]:
310 |     sampled = faults.iloc[::FAULT_SIMPLIFY_STEP].copy().reset_index(drop=True)
311 |     coords = sampled[["x_m", "y_m"]].to_numpy()
312 |     tree = cKDTree(coords)
313 |     return tree, coords
314 | 
