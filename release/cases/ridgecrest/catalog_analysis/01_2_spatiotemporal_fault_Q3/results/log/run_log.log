175 | def load_fault_segments(path: Path) -> tuple[pd.DataFrame, dict]:
176 |     log(f"Loading faults: {path}")
177 |     with path.open("r", encoding="utf-8") as f:
178 |         segments = json.load(f)
179 | 
180 |     if not isinstance(segments, list):
181 |         raise ValueError("Fault JSON must be a list of segments.")
182 | 
183 |     rows = []
184 |     kept_segments = 0
185 |     kept_points = 0
186 |     skipped_segments = 0
187 | 
188 |     for seg_id, segment in enumerate(segments):
189 |         if not isinstance(segment, list) or len(segment) < 2:
190 |             skipped_segments += 1
191 |             continue
192 | 
193 |         local_points = []
194 |         for pt in segment:
195 |             if not isinstance(pt, (list, tuple)) or len(pt) != 2:
196 |                 continue
197 |             lon, lat = pt
198 |             try:
199 |                 lon = float(lon)
200 |                 lat = float(lat)
201 |             except Exception:
202 |                 continue
203 |             if not (math.isfinite(lon) and math.isfinite(lat)):
204 |                 continue
205 |             local_points.append((lon, lat))
206 | 
207 |         if len(local_points) < 2:
208 |             skipped_segments += 1
209 |             continue
210 | 
211 |         kept_segments += 1
212 |         kept_points += len(local_points)
213 |         for point_order, (lon, lat) in enumerate(local_points):
214 |             rows.append(
215 |                 {
216 |                     "segment_id": kept_segments - 1,
217 |                     "source_segment_index": seg_id,
218 |                     "point_order": point_order,
219 |                     "longitude": lon,
220 |                     "latitude": lat,
221 |                 }
222 |             )
223 | 
224 |     fault_df = pd.DataFrame(rows)
225 |     metadata = {
226 |         "raw_segment_count": int(len(segments)),
227 |         "kept_segment_count": int(kept_segments),
228 |         "skipped_segment_count": int(skipped_segments),
229 |         "kept_point_count": int(kept_points),
230 |     }
231 |     return fault_df, metadata
