 78 | def load_csv_with_time(path: Path, name: str) -> pd.DataFrame:
 79 |     log(f"Loading {name}: {path}")
 80 |     df = pd.read_csv(path)
 81 |     validate_columns(df, name)
 82 | 
 83 |     out = df.copy()
 84 |     out["event_time_raw"] = out["event_time"].astype(str)
 85 |     out["event_time"] = pd.to_datetime(out["event_time"], utc=True, errors="coerce")
 86 | 
 87 |     numeric_cols = ["latitude", "longitude", "depth_km", "magnitude"]
 88 |     for col in numeric_cols:
 89 |         out[col] = pd.to_numeric(out[col], errors="coerce")
 90 |     return out
