 92 | 
 93 | def clean_event_table(df: pd.DataFrame, name: str) -> tuple[pd.DataFrame, dict]:
 94 |     before = len(df)
 95 |     valid_mask = (
 96 |         df["event_time"].notna()
 97 |         & df["latitude"].notna()
 98 |         & df["longitude"].notna()
 99 |         & np.isfinite(df["latitude"])
100 |         & np.isfinite(df["longitude"])
101 |     )
102 |     cleaned = df.loc[valid_mask, EXPECTED_COLUMNS + ["event_time_raw"]].copy()
103 |     cleaned = cleaned.sort_values("event_time").reset_index(drop=True)
104 | 
105 |     metadata = {
106 |         "table_name": name,
107 |         "rows_before_cleaning": int(before),
108 |         "rows_after_cleaning": int(len(cleaned)),
109 |         "rows_removed": int(before - len(cleaned)),
110 |     }
111 |     return cleaned, metadata
112 | 
113 | 
114 | def identify_mainshocks(df: pd.DataFrame) -> tuple[pd.Series, pd.Series]:
115 |     if len(df) < 2:
116 |         raise ValueError("Mainshock table must contain at least two rows.")
117 | 
118 |     rounded = df["magnitude"].round(1)
119 |     idx64 = rounded.sub(6.4).abs().idxmin()
120 |     idx71 = rounded.sub(7.1).abs().idxmin()
121 | 
122 |     ms64 = df.loc[idx64].copy()
123 |     ms71 = df.loc[idx71].copy()
124 | 
125 |     if pd.isna(ms64["event_time"]) or pd.isna(ms71["event_time"]):
126 |         raise ValueError("Failed to identify valid event times for mainshocks.")
127 |     if ms64["event_time"] >= ms71["event_time"]:
128 |         raise ValueError("Mainshock64 must occur before Mainshock71.")
129 |     return ms64, ms71
130 | 
131 | 
132 | def build_interval_table(start: pd.Timestamp, end: pd.Timestamp, freq: str, stage_name: str) -> pd.DataFrame:
133 |     if start >= end:
134 |         raise ValueError(f"Invalid interval range for {stage_name}: start >= end")
135 | 
136 |     edges = list(pd.date_range(start=start, end=end, freq=freq, tz="UTC"))
137 |     if not edges or edges[0] != start:
138 |         edges = [start] + edges
139 |     if edges[-1] != end:
140 |         edges.append(end)
141 | 
142 |     intervals: List[IntervalSpec] = []
143 |     for i in range(len(edges) - 1):
144 |         left = edges[i]
145 |         right = edges[i + 1]
146 |         intervals.append(
147 |             IntervalSpec(
148 |                 label=f"{stage_name}_{i + 1:02d}",
149 |                 start=left,
150 |                 end=right,
151 |                 is_final=(i == len(edges) - 2),
152 |             )
153 |         )
154 | 
155 |     rows = []
156 |     for idx, interval in enumerate(intervals, start=1):
157 |         duration_hours = (interval.end - interval.start).total_seconds() / 3600.0
158 |         rows.append(
159 |             {
160 |                 "stage": stage_name,
161 |                 "interval_index": idx,
162 |                 "interval_label": interval.label,
163 |                 "start_time": interval.start,
164 |                 "end_time": interval.end,
165 |                 "start_time_iso": interval.start.isoformat(),
166 |                 "end_time_iso": interval.end.isoformat(),
167 |                 "duration_hours": duration_hours,
168 |                 "is_final_interval": interval.is_final,
169 |                 "bin_inclusion_rule": FINAL_BIN_POLICY,
170 |             }
171 |         )
172 |     return pd.DataFrame(rows)
173 | 
