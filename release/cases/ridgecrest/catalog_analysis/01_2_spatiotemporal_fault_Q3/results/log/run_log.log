231 | def compute_oriented_box_metrics(geom: Polygon) -> tuple[float, float, float]:
232 |     if geom is None or geom.is_empty:
233 |         return np.nan, np.nan, np.nan
234 |     mrr = geom.minimum_rotated_rectangle
235 |     coords = np.asarray(mrr.exterior.coords)
236 |     if coords.shape[0] < 4:
237 |         return np.nan, np.nan, np.nan
238 |     edges = []
239 |     for i in range(4):
240 |         p0 = coords[i]
241 |         p1 = coords[i + 1]
242 |         edges.append(float(np.linalg.norm(p1 - p0)))
243 |     unique_edges = sorted(edges[:2], reverse=True)
244 |     major = unique_edges[0]
245 |     minor = unique_edges[1]
246 |     dx = coords[1, 0] - coords[0, 0]
247 |     dy = coords[1, 1] - coords[0, 1]
248 |     azimuth_deg = (math.degrees(math.atan2(dy, dx)) + 360.0) % 180.0
249 |     return major, minor, azimuth_deg
